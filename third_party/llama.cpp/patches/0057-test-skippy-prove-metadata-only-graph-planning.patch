From: scama
 <a1860575018c4680d5669dd7bc3bd356b478bccb8d42e194df46304a5e25f49a@meshllm.communities.buzz.xyz>
Date: Sat, 5 Sep 2026 17:32:28 +1000
Subject: [PATCH] test(skippy): prove metadata-only graph planning

---
 src/CMakeLists.txt                          |  31 +++
 src/llama-memory-recurrent.cpp              |  22 +-
 src/skippy/tests/noalloc_graph_planning.cpp | 221 ++++++++++++++++++++
 3 files changed, 271 insertions(+), 3 deletions(-)
 create mode 100644 src/skippy/tests/noalloc_graph_planning.cpp

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 9db23247e..25dc927f0 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -105,6 +105,12 @@ if (LLAMA_STAGE_BUILD_TESTS)
     target_compile_features(skippy-model-loader-accounting PRIVATE cxx_std_17)
     target_link_libraries(skippy-model-loader-accounting PRIVATE llama-common)
 
+    add_executable(skippy-noalloc-graph-planning
+        skippy/tests/noalloc_graph_planning.cpp)
+    target_include_directories(skippy-noalloc-graph-planning PRIVATE .)
+    target_compile_features(skippy-noalloc-graph-planning PRIVATE cxx_std_17)
+    target_link_libraries(skippy-noalloc-graph-planning PRIVATE llama)
+
     add_test(
         NAME skippy_generate_gemma_fixture
         COMMAND skippy-model-fixture-generator
@@ -123,6 +129,15 @@ if (LLAMA_STAGE_BUILD_TESTS)
     set_tests_properties(skippy_generate_qwen2moe_fixture PROPERTIES
         FIXTURES_SETUP skippy-model-loader-fixtures)
 
+    add_test(
+        NAME skippy_generate_granite_hybrid_fixture
+        COMMAND skippy-model-fixture-generator
+            --arch granitehybrid
+            --seed 1
+            --out "${SKIPPY_MODEL_FIXTURE_DIR}")
+    set_tests_properties(skippy_generate_granite_hybrid_fixture PROPERTIES
+        FIXTURES_SETUP skippy-noalloc-granite-hybrid-fixture)
+
     add_test(
         NAME skippy_model_loader_accounting_dense
         COMMAND skippy-model-loader-accounting
@@ -136,6 +151,22 @@ if (LLAMA_STAGE_BUILD_TESTS)
             "${SKIPPY_MODEL_FIXTURE_DIR}/qwen2moe-moe.gguf")
     set_tests_properties(skippy_model_loader_accounting_moe PROPERTIES
         FIXTURES_REQUIRED skippy-model-loader-fixtures)
+
+    add_test(
+        NAME skippy_noalloc_graph_planning_dense
+        COMMAND skippy-noalloc-graph-planning
+            "${SKIPPY_MODEL_FIXTURE_DIR}/gemma-dense.gguf"
+            0)
+    set_tests_properties(skippy_noalloc_graph_planning_dense PROPERTIES
+        FIXTURES_REQUIRED skippy-model-loader-fixtures)
+
+    add_test(
+        NAME skippy_noalloc_graph_planning_granite_hybrid
+        COMMAND skippy-noalloc-graph-planning
+            "${SKIPPY_MODEL_FIXTURE_DIR}/granitehybrid-dense.gguf"
+            1)
+    set_tests_properties(skippy_noalloc_graph_planning_granite_hybrid PROPERTIES
+        FIXTURES_REQUIRED skippy-noalloc-granite-hybrid-fixture)
 endif()
 
 if (BUILD_SHARED_LIBS)
diff --git a/src/llama-memory-recurrent.cpp b/src/llama-memory-recurrent.cpp
index ff489d954..73225ac98 100644
--- a/src/llama-memory-recurrent.cpp
+++ b/src/llama-memory-recurrent.cpp
@@ -117,7 +117,17 @@ llama_memory_recurrent::llama_memory_recurrent(
 
     // allocate tensors and initialize the buffers to avoid NaNs in the padding
     for (auto & [buft, ctx] : ctx_map) {
-        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft);
+        ggml_backend_buffer_t buf;
+        if (hparams.no_alloc) {
+            buf = ggml_backend_buft_alloc_buffer(buft, /*size =*/ 0);
+            for (ggml_tensor * tensor = ggml_get_first_tensor(ctx.get());
+                    tensor != nullptr;
+                    tensor = ggml_get_next_tensor(ctx.get(), tensor)) {
+                tensor->buffer = buf;
+            }
+        } else {
+            buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft);
+        }
         if (!buf) {
             throw std::runtime_error("failed to allocate buffer for rs cache");
         }
@@ -420,8 +430,14 @@ void llama_memory_recurrent::set_rs_idx(llama_seq_id seq_id, uint32_t idx) {
 
 std::map<ggml_backend_buffer_type_t, size_t> llama_memory_recurrent::memory_breakdown() const {
     std::map<ggml_backend_buffer_type_t, size_t> ret;
-    for (const auto & [_, buf] : ctxs_bufs) {
-        ret[ggml_backend_buffer_get_type(buf.get())] += ggml_backend_buffer_get_size(buf.get());
+    for (const auto & [ctx, buf] : ctxs_bufs) {
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(buf.get());
+        if (hparams.no_alloc) {
+            GGML_ASSERT(ggml_backend_buffer_get_base(buf.get()) == nullptr);
+            ret[buft] += ggml_backend_alloc_ctx_tensors_from_buft_size(ctx.get(), buft);
+        } else {
+            ret[buft] += ggml_backend_buffer_get_size(buf.get());
+        }
     }
     return ret;
 }
diff --git a/src/skippy/tests/noalloc_graph_planning.cpp b/src/skippy/tests/noalloc_graph_planning.cpp
new file mode 100644
index 000000000..caeda5dbd
--- /dev/null
+++ b/src/skippy/tests/noalloc_graph_planning.cpp
@@ -0,0 +1,221 @@
+#include "ggml-backend.h"
+#include "ggml.h"
+#include "gguf.h"
+#include "llama-context.h"
+#include "llama-ext.h"
+#include "llama-kv-cache.h"
+#include "llama-memory-hybrid.h"
+#include "llama-memory-recurrent.h"
+#include "llama-model.h"
+#include "llama.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+static bool is_dummy_buffer(const ggml_tensor * tensor) {
+    return tensor != nullptr &&
+           tensor->buffer != nullptr &&
+           ggml_backend_buffer_get_size(tensor->buffer) == 0 &&
+           ggml_backend_buffer_get_base(tensor->buffer) == nullptr;
+}
+
+static bool check_model_buffers(const llama_model * model) {
+    const auto & tensors = llama_internal_get_tensor_map(model);
+    if (tensors.empty()) {
+        std::fprintf(stderr, "metadata-only model has no tensors\n");
+        return false;
+    }
+    for (const auto & [name, tensor] : tensors) {
+        if (!is_dummy_buffer(tensor)) {
+            std::fprintf(stderr, "model tensor %s has a payload allocation\n", name.c_str());
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool check_kv_buffers(const llama_kv_cache * memory) {
+    const auto layer_ids = memory->get_layer_ids();
+    if (layer_ids.empty()) {
+        std::fprintf(stderr, "metadata-only attention memory has no layers\n");
+        return false;
+    }
+    for (uint32_t layer_id : layer_ids) {
+        if (!is_dummy_buffer(memory->get_k_storage(static_cast<int32_t>(layer_id)))) {
+            std::fprintf(stderr, "attention memory layer %u has a payload allocation\n", layer_id);
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool check_recurrent_buffers(const llama_memory_recurrent * memory) {
+    size_t tensor_count = 0;
+    for (const auto * tensor : memory->r_l) {
+        if (tensor != nullptr) {
+            ++tensor_count;
+            if (!is_dummy_buffer(tensor)) {
+                std::fprintf(stderr, "recurrent R state has a payload allocation\n");
+                return false;
+            }
+        }
+    }
+    for (const auto * tensor : memory->s_l) {
+        if (tensor != nullptr) {
+            ++tensor_count;
+            if (!is_dummy_buffer(tensor)) {
+                std::fprintf(stderr, "recurrent S state has a payload allocation\n");
+                return false;
+            }
+        }
+    }
+    for (const auto * tensor : memory->p_l) {
+        if (tensor != nullptr) {
+            ++tensor_count;
+            if (!is_dummy_buffer(tensor)) {
+                std::fprintf(stderr, "recurrent P state has a payload allocation\n");
+                return false;
+            }
+        }
+    }
+    if (tensor_count == 0) {
+        std::fprintf(stderr, "metadata-only recurrent memory has no state tensors\n");
+        return false;
+    }
+    return true;
+}
+
+static bool check_memory_buffers(llama_context * context, bool expect_recurrent) {
+    llama_memory_t memory = llama_get_memory(context);
+    if (memory == nullptr) {
+        std::fprintf(stderr, "metadata-only context has no memory module\n");
+        return false;
+    }
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory)) {
+        return check_kv_buffers(hybrid->get_mem_attn()) &&
+               check_recurrent_buffers(hybrid->get_mem_recr());
+    }
+    if (auto * recurrent = dynamic_cast<llama_memory_recurrent *>(memory)) {
+        return check_recurrent_buffers(recurrent);
+    }
+    if (expect_recurrent) {
+        std::fprintf(stderr, "fixture did not construct recurrent memory\n");
+        return false;
+    }
+    auto * kv = dynamic_cast<llama_kv_cache *>(memory);
+    if (kv == nullptr) {
+        std::fprintf(stderr, "fixture did not construct attention memory\n");
+        return false;
+    }
+    return check_kv_buffers(kv);
+}
+
+static void count_payload_read(ggml_tensor * tensor, void * user_data) {
+    GGML_UNUSED(tensor);
+    auto * payload_read_count = static_cast<size_t *>(user_data);
+    ++*payload_read_count;
+}
+
+static llama_model * load_metadata_only_model(const char * model_path) {
+    ggml_context * tensor_context = nullptr;
+    gguf_init_params params = {
+        /*.no_alloc =*/ true,
+        /*.ctx      =*/ &tensor_context,
+    };
+    gguf_context * metadata = gguf_init_from_file(model_path, params);
+    if (metadata == nullptr || tensor_context == nullptr) {
+        std::fprintf(stderr, "failed to inspect fixture GGUF\n");
+        if (tensor_context != nullptr) {
+            ggml_free(tensor_context);
+        }
+        if (metadata != nullptr) {
+            gguf_free(metadata);
+        }
+        return nullptr;
+    }
+
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 0;
+    model_params.no_alloc = true;
+    size_t payload_read_count = 0;
+    llama_model * model = llama_model_init_from_user(
+            metadata,
+            count_payload_read,
+            &payload_read_count,
+            model_params);
+    ggml_free(tensor_context);
+    gguf_free(metadata);
+    if (payload_read_count != 0) {
+        std::fprintf(stderr, "metadata-only load requested %zu weight payloads\n", payload_read_count);
+        llama_model_free(model);
+        return nullptr;
+    }
+    return model;
+}
+
+static int check_noalloc_graphs(const char * model_path, bool expect_recurrent) {
+    llama_model * model = load_metadata_only_model(model_path);
+    if (model == nullptr) {
+        std::fprintf(stderr, "failed to load metadata-only model\n");
+        return 1;
+    }
+    if (!check_model_buffers(model)) {
+        llama_model_free(model);
+        return 2;
+    }
+
+    llama_context_params context_params = llama_context_default_params();
+    context_params.n_ctx = 32;
+    context_params.n_batch = 8;
+    context_params.n_ubatch = 8;
+    context_params.n_seq_max = 1;
+    context_params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    llama_context * context = llama_init_from_model(model, context_params);
+    if (context == nullptr) {
+        std::fprintf(stderr, "failed to create metadata-only context\n");
+        llama_model_free(model);
+        return 3;
+    }
+    if (!check_memory_buffers(context, expect_recurrent)) {
+        llama_free(context);
+        llama_model_free(model);
+        return 4;
+    }
+
+    ggml_cgraph * prefill = llama_graph_reserve(context, 8, 1, 8);
+    if (prefill == nullptr || ggml_graph_n_nodes(prefill) == 0) {
+        std::fprintf(stderr, "metadata-only prefill graph is empty\n");
+        llama_free(context);
+        llama_model_free(model);
+        return 5;
+    }
+    const int prefill_node_count = ggml_graph_n_nodes(prefill);
+    ggml_cgraph * decode = llama_graph_reserve(context, 1, 1, 1);
+    if (decode == nullptr || ggml_graph_n_nodes(decode) == 0) {
+        std::fprintf(stderr, "metadata-only decode graph is empty\n");
+        llama_free(context);
+        llama_model_free(model);
+        return 6;
+    }
+    const int decode_node_count = ggml_graph_n_nodes(decode);
+
+    std::printf("metadata-only planning: prefill_nodes=%d decode_nodes=%d recurrent=%d\n",
+            prefill_node_count,
+            decode_node_count,
+            expect_recurrent ? 1 : 0);
+    llama_free(context);
+    llama_model_free(model);
+    return 0;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        std::fprintf(stderr, "usage: %s MODEL_PATH EXPECT_RECURRENT\n", argv[0]);
+        return 64;
+    }
+    llama_backend_init();
+    const int result = check_noalloc_graphs(argv[1], std::string(argv[2]) == "1");
+    llama_backend_free();
+    return result;
+}
-- 

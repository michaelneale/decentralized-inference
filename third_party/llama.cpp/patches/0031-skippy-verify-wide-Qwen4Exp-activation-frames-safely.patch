From e6427a2bdd6c05aae1a2bdcd4d28d4134add0ad2 Mon Sep 17 00:00:00 2001
From: Jimmy
 <1fe240cd1a8cf775f6f3060f115e5a303181f3abf28ad4cb0c2515f4a02b36a8@meshllm.communities.buzz.xyz>
Date: Sat, 29 Aug 2026 02:05:03 +1000
Subject: [PATCH 30/32] skippy: verify wide Qwen4Exp activation frames safely

Co-authored-by: michaelneale <14976+michaelneale@users.noreply.github.com>

Signed-off-by: michaelneale <14976+michaelneale@users.noreply.github.com>
---
 src/skippy/activation.cpp | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/skippy/activation.cpp b/src/skippy/activation.cpp
index 50327dd53..43cba21f3 100644
--- a/src/skippy/activation.cpp
+++ b/src/skippy/activation.cpp
@@ -740,6 +740,11 @@ enum skippy_status skippy_verify_activation_frame(
 
     const int32_t n_tokens = static_cast<int32_t>(token_count);
     const int32_t n_embd = llama_model_n_embd(session->stage_model->model);
+    const bool qwen4exp_activation_input = session->stage_model->model->arch == LLM_ARCH_QWEN4EXP;
+    if (qwen4exp_activation_input && token_ids == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "Qwen4Exp verification requires token-id sideband");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
     const int32_t n_altup = static_cast<int32_t>(session->stage_model->model->hparams.n_altup);
     const size_t hidden_bytes = skippy_activation_hidden_bytes(session, token_count);
     const bool alias_input_payload = input_desc->flags == 0;
@@ -758,7 +763,7 @@ enum skippy_status skippy_verify_activation_frame(
         logits_storage.resize(n_tokens, 1);
         batch = {
             /*n_tokens =*/ n_tokens,
-            /*token    =*/ nullptr,
+            /*token    =*/ qwen4exp_activation_input ? const_cast<llama_token *>(token_ids) : nullptr,
             /*embd     =*/ const_cast<float *>(static_cast<const float *>(input_payload)),
             /*pos      =*/ pos_storage.data(),
             /*n_seq_id =*/ n_seq_id_storage.data(),
@@ -767,7 +772,11 @@ enum skippy_status skippy_verify_activation_frame(
         };
     } else {
         batch = llama_batch_init(n_tokens, n_embd, 1);
-        std::memcpy(batch.embd, input_payload, hidden_bytes);
+        const size_t batch_embd_bytes = static_cast<size_t>(n_tokens)*n_embd*sizeof(float);
+        std::memcpy(batch.embd, input_payload, std::min(hidden_bytes, batch_embd_bytes));
+        if (qwen4exp_activation_input) {
+            batch.token = const_cast<llama_token *>(token_ids);
+        }
     }
     batch.n_tokens = n_tokens;
 
@@ -778,6 +787,15 @@ enum skippy_status skippy_verify_activation_frame(
         batch.logits[i] = 1;
     }
 
+    skippy_activation_tokens_scope activation_tokens_scope(token_ids, token_count);
+    const int32_t qwen4exp_hc = qwen4exp_activation_input
+        ? static_cast<int32_t>(session->stage_model->model->hparams.dsv4_hc_mult)
+        : 0;
+    skippy_qwen4exp_hc_scope qwen4exp_hc_scope(
+            qwen4exp_activation_input ? input_payload : nullptr,
+            static_cast<uint32_t>(token_count),
+            n_embd,
+            qwen4exp_hc);
     skippy_rwkv7_v_first_scope rwkv7_v_first_scope(input_desc, input_payload, hidden_bytes, n_embd);
     skippy_gemma3n_altup_scope gemma3n_altup_scope(input_desc, input_payload, n_embd, n_altup);
     const llama_pos token_start = session->n_past;
-- 

From 1239dfe3ff25c1e936039235aad0b6e40109812d Mon Sep 17 00:00:00 2001
From: scama
 <a1860575018c4680d5669dd7bc3bd356b478bccb8d42e194df46304a5e25f49a@meshllm.communities.buzz.xyz>
Date: Sun, 6 Sep 2026 12:02:03 +1000
Subject: [PATCH] skippy: bind Mamba recurrent state ownership

---
 src/CMakeLists.txt        | 18 ++++++++++++++++++
 src/models/mamba-base.cpp | 26 ++++++++++++++++----------
 2 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 312d1248b..a46f32c13 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -310,6 +310,24 @@ if (LLAMA_STAGE_BUILD_TESTS)
             "recurrent,recurrent")
     set_tests_properties(skippy_noalloc_graph_planning_recurrent_source PROPERTIES
         FIXTURES_REQUIRED skippy-noalloc-mamba2-fixture)
+
+    add_test(
+        NAME skippy_generate_mamba_fixture
+        COMMAND skippy-model-fixture-generator
+            --arch mamba
+            --seed 1
+            --out "${SKIPPY_MODEL_FIXTURE_DIR}")
+    set_tests_properties(skippy_generate_mamba_fixture PROPERTIES
+        FIXTURES_SETUP skippy-noalloc-mamba-fixture)
+
+    add_test(
+        NAME skippy_noalloc_graph_planning_mamba_state_ownership
+        COMMAND skippy-noalloc-graph-planning
+            "${SKIPPY_MODEL_FIXTURE_DIR}/mamba-dense.gguf"
+            1
+            "recurrent,recurrent")
+    set_tests_properties(skippy_noalloc_graph_planning_mamba_state_ownership PROPERTIES
+        FIXTURES_REQUIRED skippy-noalloc-mamba-fixture)
 endif()
 
 if (BUILD_SHARED_LIBS)
diff --git a/src/models/mamba-base.cpp b/src/models/mamba-base.cpp
index e70b31c14..44dfda9d1 100644
--- a/src/models/mamba-base.cpp
+++ b/src/models/mamba-base.cpp
@@ -37,7 +37,8 @@ ggml_tensor * llm_build_mamba_base::build_mamba_layer(llm_graph_input_rs * inp,
     ggml_tensor * conv_states_all = mctx_cur->get_r_l(il);
     ggml_tensor * ssm_states_all  = mctx_cur->get_s_l(il);
 
-    ggml_tensor * conv = build_rs(inp, conv_states_all, hparams.n_embd_r(), n_seqs);
+    ggml_tensor * conv = build_rs(
+        inp, conv_states_all, hparams.n_embd_r(), n_seqs, skippy_state_kind::recurrent_conv, il);
     conv               = ggml_reshape_3d(ctx0, conv, d_conv - 1, d_inner, n_seqs);
 
     // {n_embd, n_tokens} => {n_embd, n_seq_tokens, n_seqs}
@@ -60,10 +61,12 @@ ggml_tensor * llm_build_mamba_base::build_mamba_layer(llm_graph_input_rs * inp,
         ggml_tensor * last_conv = ggml_view_3d(ctx0, conv_x, d_conv - 1, d_inner, n_seqs, conv_x->nb[1], conv_x->nb[2],
                                                n_seq_tokens * (conv_x->nb[0]));
 
-        ggml_build_forward_expand(
-            gf, ggml_cpy(ctx0, last_conv,
-                         ggml_view_1d(ctx0, conv_states_all, (d_conv - 1) * (d_inner) * (n_seqs),
-                                      kv_head * (d_conv - 1) * (d_inner) *ggml_element_size(conv_states_all))));
+        ggml_tensor * conv_write = ggml_cpy(
+            ctx0, last_conv,
+            ggml_view_1d(ctx0, conv_states_all, (d_conv - 1) * (d_inner) * (n_seqs),
+                         kv_head * (d_conv - 1) * (d_inner) * ggml_element_size(conv_states_all)));
+        ggml_build_forward_expand(gf, conv_write);
+        state_write(skippy_state_kind::recurrent_conv, conv_states_all, conv_write, il);
 
         // 1D convolution
         // The equivalent is to make a self-overlapping view of conv_x
@@ -123,13 +126,16 @@ ggml_tensor * llm_build_mamba_base::build_mamba_layer(llm_graph_input_rs * inp,
             return ggml_ssm_scan(ctx, ssm, x, dt, A, B, C, ids, /*K=*/1);
         };
 
-        ggml_tensor * y_ssm = build_rs(inp, ssm_states_all, hparams.n_embd_s(), ubatch.n_seqs, get_ssm_rows);
+        ggml_tensor * y_ssm = build_rs(
+            inp, ssm_states_all, hparams.n_embd_s(), ubatch.n_seqs, skippy_state_kind::recurrent_ssm, il, get_ssm_rows);
 
         // store last states
-        ggml_build_forward_expand(
-            gf, ggml_cpy(ctx0, ggml_view_1d(ctx0, y_ssm, d_state * d_inner * n_seqs, x->nb[3] * x->ne[3]),
-                         ggml_view_1d(ctx0, ssm_states_all, d_state * d_inner * n_seqs,
-                                      kv_head * d_state * d_inner * ggml_element_size(ssm_states_all))));
+        ggml_tensor * ssm_write = ggml_cpy(
+            ctx0, ggml_view_1d(ctx0, y_ssm, d_state * d_inner * n_seqs, x->nb[3] * x->ne[3]),
+            ggml_view_1d(ctx0, ssm_states_all, d_state * d_inner * n_seqs,
+                         kv_head * d_state * d_inner * ggml_element_size(ssm_states_all)));
+        ggml_build_forward_expand(gf, ssm_write);
+        state_write(skippy_state_kind::recurrent_ssm, ssm_states_all, ssm_write, il);
 
         ggml_tensor * y = ggml_view_3d(ctx0, y_ssm, d_inner, n_seq_tokens, n_seqs, x->nb[2], x->nb[3], 0);
 
-- 
2.54.0 (Apple Git-157)


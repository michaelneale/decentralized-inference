From aebb61726bbd72c3a21add533372281658ec5b19 Mon Sep 17 00:00:00 2001
From: Michael Neale <14976+michaelneale@users.noreply.github.com>
Date: Tue, 18 Aug 2026 20:41:42 +1000
Subject: [PATCH 15/56] skippy: prune unverified MTP proposal rows from the
 sidecar cache

A multi-token proposal against a sidecar KV cache of its own writes one
row per draft depth, but bookkeeping records only the first drafted
token. On accept, mtp_next_pos advances one past that token and nothing
removes the deeper speculative rows. The next sidecar decode then resumes
at a position that is not seq_pos_max + 1, llama_batch_allocr::init
rejects the batch and llama_decode returns -1, surfacing as a failed
sidecar sync or proposal.

Track one past the highest position each proposal writes and, on the
accept path, remove everything past the committed token so the sidecar
holds only verified rows. The chained-heads branch already clears its own
rows before every decode and is unaffected, as is the shared-memory case
where the target owns position bookkeeping.

Observed on CUDA at draft 3 with Qwen3.8-27B: rc=-1, resume position 152,
sidecar seq_pos_max 153.
---
 src/skippy/runtime_types.h          |  5 +++++
 src/skippy/speculative_decoding.cpp | 28 ++++++++++++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/src/skippy/runtime_types.h b/src/skippy/runtime_types.h
index c1ce9298a..ff8024a5f 100644
--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -127,6 +127,11 @@ struct skippy_session {
     bool mtp_has_pending_draft = false;
     llama_pos mtp_pending_draft_pos = 0;
     llama_token mtp_pending_draft_token = -1;
+    // One past the highest position the last proposal wrote into a sidecar
+    // cache of its own. Only the first drafted token is recorded above, so this
+    // is the boundary the next sync prunes back to once the accepted prefix is
+    // known.
+    llama_pos mtp_pending_draft_end = 0;
     bool external_mtp_embeddings_available = false;
     std::vector<float> external_mtp_embeddings;
     bool reset_required = false;
diff --git a/src/skippy/speculative_decoding.cpp b/src/skippy/speculative_decoding.cpp
index bbea68c3d..22bc61858 100644
--- a/src/skippy/speculative_decoding.cpp
+++ b/src/skippy/speculative_decoding.cpp
@@ -88,6 +88,7 @@ void skippy_mtp_clear_session_state(skippy_session * session) {
     session->mtp_has_pending_draft = false;
     session->mtp_pending_draft_pos = 0;
     session->mtp_pending_draft_token = -1;
+    session->mtp_pending_draft_end = 0;
     if (skippy_mtp_available(session)) {
         if (llama_memory_t memory = session->stage_model->mtp_ctx->get_memory()) {
             llama_memory_seq_rm(memory, session->seq_id, -1, -1);
@@ -168,6 +169,7 @@ enum skippy_status skippy_mtp_sync_target_inputs(
         session->mtp_has_pending_draft = false;
         session->mtp_pending_draft_pos = 0;
         session->mtp_pending_draft_token = -1;
+        session->mtp_pending_draft_end = 0;
         return skippy_success(out_error);
     }
 
@@ -181,12 +183,29 @@ enum skippy_status skippy_mtp_sync_target_inputs(
         session->mtp_has_pending_draft = false;
         session->mtp_pending_draft_pos = 0;
         session->mtp_pending_draft_token = -1;
+        session->mtp_pending_draft_end = 0;
     } else if (session->mtp_has_pending_draft) {
         const llama_pos token_end = token_start + static_cast<llama_pos>(token_count);
         if (session->mtp_pending_draft_pos >= token_start &&
                 session->mtp_pending_draft_pos < token_end) {
             const size_t draft_index = static_cast<size_t>(session->mtp_pending_draft_pos - token_start);
             if (token_ids != nullptr && token_ids[draft_index] == session->mtp_pending_draft_token) {
+                // Only the first drafted token is committed. A multi-token
+                // proposal against a sidecar cache of its own also wrote rows
+                // for the deeper drafts; those are not verified and nothing
+                // else removes them. Left resident they make the next sidecar
+                // decode non-consecutive (seq_pos_max is past the position we
+                // resume at) and llama_batch_allocr::init rejects the batch.
+                if (!mtp_shares_target_memory &&
+                        session->mtp_pending_draft_end > session->mtp_pending_draft_pos + 1) {
+                    if (llama_memory_t memory = mtp_ctx->get_memory()) {
+                        llama_memory_seq_rm(
+                                memory,
+                                session->seq_id,
+                                session->mtp_pending_draft_pos + 1,
+                                -1);
+                    }
+                }
                 session->mtp_next_pos = std::max(session->mtp_next_pos, session->mtp_pending_draft_pos + 1);
             } else {
                 if (llama_memory_t memory = mtp_ctx->get_memory()) {
@@ -198,6 +217,7 @@ enum skippy_status skippy_mtp_sync_target_inputs(
         session->mtp_has_pending_draft = false;
         session->mtp_pending_draft_pos = 0;
         session->mtp_pending_draft_token = -1;
+        session->mtp_pending_draft_end = 0;
     }
 
     size_t first_index = 0;
@@ -403,6 +423,10 @@ enum skippy_status skippy_mtp_propose_next(
     llama_token token = predicted_token;
     int64_t elapsed_us = 0;
     int32_t token_count = 0;
+    // One past the highest position this proposal writes. The chained branch
+    // clears its own rows before every decode, so only the single-row loop can
+    // leave an overhang behind the accepted prefix.
+    llama_pos proposal_end_pos = session->n_past + 1;
     if (chain_heads && !chain_at_same_position) {
         std::vector<llama_token> prefix_tokens = { predicted_token };
         prefix_tokens.reserve(draft_limit + 1);
@@ -509,6 +533,9 @@ enum skippy_status skippy_mtp_propose_next(
             }
             std::memcpy(proposal_h.data(), h_next, static_cast<size_t>(n_embd)*sizeof(float));
         }
+        if (!mtp_shares_target_memory && !chain_at_same_position) {
+            proposal_end_pos = pos;
+        }
     }
 
     if (out_mtp_draft != nullptr && token_count > 0) {
@@ -519,6 +546,7 @@ enum skippy_status skippy_mtp_propose_next(
         session->mtp_has_pending_draft = true;
         session->mtp_pending_draft_pos = session->n_past;
         session->mtp_pending_draft_token = out_mtp_draft->token_ids[0];
+        session->mtp_pending_draft_end = proposal_end_pos;
     }
     return skippy_success(out_error);
 }

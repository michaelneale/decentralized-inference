+static llama_context_params make_context_params(uint32_t n_seq_max) {
+    llama_context_params params = llama_context_default_params();
+    params.n_ctx = 32;
+    params.n_batch = 8;
+    params.n_ubatch = 8;
+    params.n_seq_max = n_seq_max;
+    params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    return params;
+}
+
+static llama_model * load_model(const char * path) {
+    llama_model_params params = llama_model_default_params();
+    params.n_gpu_layers = 0;
+    return llama_model_load_from_file(path, params);
+}
+
+static int check_sched_reserve_and_memory_update(const char * model_path) {
+    llama_model * model = load_model(model_path);
+    if (model == nullptr || llama_model_n_layer(model) < 2) {
+        llama_model_free(model);
+        return 10;
+    }
+
+    const auto startup = make_stage_inputs(0, llama_model_n_layer(model), true, true);
+    const auto reserve_inputs = make_stage_inputs(0, 1, true, false);
+    const auto update_inputs = make_stage_inputs(1, 2, false, true);
+    if (startup.topology_equal(reserve_inputs) || startup.topology_equal(update_inputs)) {
+        llama_model_free(model);
+        return 11;
+    }
+
+    llama_context * context = llama_init_from_model_with_graph_inputs(
+            model, make_context_params(2), startup);
+    if (context == nullptr) {
+        llama_model_free(model);
+        return 12;
+    }
+
+    context->set_causal_attn(false);
+    context->sched_reserve(reserve_inputs);
+    const auto * reserve_result = context->get_gf_res_reserve();
+    if (!reserve_result->get_build_inputs().topology_equal(reserve_inputs) ||
+            reserve_result->get_block_boundaries().size() != 2) {
+        llama_free(context);
+        llama_model_free(model);
+        return 13;
+    }
+
+    llama_memory_t memory = llama_get_memory(context);
+    if (memory == nullptr) {
+        llama_free(context);
+        llama_model_free(model);
+        return 14;
+    }
+    memory->seq_cp(0, 1, -1, -1);
+    if (!context->memory_update(false, update_inputs)) {
+        llama_free(context);
+        llama_model_free(model);
+        return 15;
+    }
+    const auto * update_result = context->get_gf_res_reserve();
+    if (!update_result->get_build_inputs().topology_equal(update_inputs) ||
+            update_result->get_block_boundaries().size() != 2) {
+        llama_free(context);
+        llama_model_free(model);
+        return 16;
+    }
+
+    llama_free(context);
+    llama_model_free(model);
+    return 0;
+}
+
+static int check_decode_encode_fallback(const char * model_path) {
+    llama_model * model = load_model(model_path);
+    if (model == nullptr) {
+        return 17;
+    }
+    const skippy_graph_build_inputs startup;
+    const auto per_call = make_stage_inputs(0, llama_model_n_layer(model), true, true);
+    llama_context * context = llama_init_from_model_with_graph_inputs(
+            model, make_context_params(1), startup);
+    if (context == nullptr || llama_get_memory(context) != nullptr) {
+        llama_free(context);
+        llama_model_free(model);
+        return 18;
+    }
+
+    llama_token token = 1;
+    llama_batch batch = llama_batch_get_one(&token, 1);
+    context->set_causal_attn(!context->get_cparams().causal_attn);
+    const int rc = context->decode(batch, per_call);
+    if (rc != 0 ||
+            !context->get_gf_res_reserve()->get_build_inputs().topology_equal(per_call) ||
+            !context->get_gf_res_prev()->get_build_inputs().topology_equal(per_call)) {
+        llama_free(context);
+        llama_model_free(model);
+        return 19;
+    }
+
+    llama_free(context);
+    llama_model_free(model);
+    return 0;
+}

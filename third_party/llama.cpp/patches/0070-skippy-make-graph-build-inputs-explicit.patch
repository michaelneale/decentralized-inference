+class recording_input final : public llm_graph_input_i {
+public:
+    void set_build_inputs(const skippy_graph_build_inputs & inputs) override {
+        observed = inputs;
+        set_count++;
+    }
+
+    void set_input(const llama_ubatch *) override {
+        input_count++;
+    }
+
+    skippy_graph_build_inputs observed;
+    uint32_t set_count = 0;
+    uint32_t input_count = 0;
+};
+
+static skippy_graph_build_inputs make_inputs(uint32_t id) {
+    skippy_graph_build_inputs inputs;
+    inputs.filter.enabled = true;
+    inputs.filter.layer_start = static_cast<int32_t>(id);
+    inputs.filter.layer_end = static_cast<int32_t>(id + 3);
+    inputs.filter.include_embeddings = id % 2 == 0;
+    inputs.filter.include_output = id % 3 == 0;
+    inputs.filter.glm_dsa_policy_profile = static_cast<int32_t>(id + 10);
+    inputs.filter.glm_dsa_policy_flags = id + 20;
+    inputs.filter.glm_dsa_short_prefill_max_tokens = static_cast<int32_t>(id + 30);
+    inputs.filter.glm_dsa_direct_sparse_decode_max_top_k = static_cast<int32_t>(id + 40);
+    inputs.filter.glm_dsa_dense_sparse_mask_max_bytes = id + 50;
+    inputs.filter.glm_dsa_compact_flash_min_kv = static_cast<int32_t>(id + 60);
+    inputs.filter.glm_dsa_phase_hint = static_cast<int32_t>(id % 4);
+    inputs.activation_tokens.tokens = reinterpret_cast<const llama_token *>(static_cast<uintptr_t>(id + 1));
+    inputs.activation_tokens.token_count = id + 2;
+    inputs.rwkv7_v_first.values = reinterpret_cast<const float *>(static_cast<uintptr_t>(id + 3));
+    inputs.rwkv7_v_first.token_count = id + 4;
+    inputs.rwkv7_v_first.n_embd = id + 5;
+    inputs.gemma3n_altup.values = reinterpret_cast<const float *>(static_cast<uintptr_t>(id + 6));
+    inputs.gemma3n_altup.token_count = id + 7;
+    inputs.gemma3n_altup.n_embd = id + 8;
+    inputs.gemma3n_altup.n_altup = id + 9;
+    inputs.qwen4exp_hc.values = reinterpret_cast<const float *>(static_cast<uintptr_t>(id + 10));
+    inputs.qwen4exp_hc.token_count = id + 11;
+    inputs.qwen4exp_hc.n_embd = id + 12;
+    inputs.qwen4exp_hc.n_hc = id + 13;
+    inputs.glm_dsa_top_k.values = reinterpret_cast<const int32_t *>(static_cast<uintptr_t>(id + 14));
+    inputs.glm_dsa_top_k.token_count = id + 15;
+    inputs.glm_dsa_top_k.n_top_k = id + 16;
+    inputs.glm_dsa_top_k.n_stream = id + 17;
+    inputs.glm_dsa_top_k.pos_start = static_cast<llama_pos>(id + 18);
+    inputs.mtp_embeddings.values = reinterpret_cast<const float *>(static_cast<uintptr_t>(id + 19));
+    inputs.mtp_embeddings.token_count = id + 20;
+    inputs.mtp_embeddings.n_embd = id + 21;
+    inputs.mtp_embeddings.pos_start = static_cast<llama_pos>(id + 22);
+    return inputs;
+}
+
+static bool matches(const skippy_graph_build_inputs & inputs, uint32_t id) {
+    const auto expected = make_inputs(id);
+    return inputs.filter.enabled == expected.filter.enabled &&
+           inputs.filter.layer_start == expected.filter.layer_start &&
+           inputs.filter.layer_end == expected.filter.layer_end &&
+           inputs.activation_tokens.tokens == expected.activation_tokens.tokens &&
+           inputs.activation_tokens.token_count == expected.activation_tokens.token_count &&
+           inputs.rwkv7_v_first.values == expected.rwkv7_v_first.values &&
+           inputs.gemma3n_altup.values == expected.gemma3n_altup.values &&
+           inputs.qwen4exp_hc.values == expected.qwen4exp_hc.values &&
+           inputs.glm_dsa_top_k.values == expected.glm_dsa_top_k.values &&
+           inputs.mtp_embeddings.values == expected.mtp_embeddings.values;
+}
+
+static int check_sequential_and_nested_lifetimes() {
+    llm_graph_result outer(64);
+    auto outer_input = std::make_unique<recording_input>();
+    auto * outer_observer = outer_input.get();
+    outer.add_input(std::move(outer_input));
+    outer.set_inputs(nullptr, make_inputs(7));
+    if (!matches(outer.get_build_inputs(), 7) || !matches(outer_observer->observed, 7)) {
+        return 1;
+    }
+
+    {
+        llm_graph_result inner(64);
+        inner.set_inputs(nullptr, make_inputs(23));
+        if (!matches(inner.get_build_inputs(), 23) || !matches(outer.get_build_inputs(), 7)) {
+            return 2;
+        }
+    }
+
+    outer.set_inputs(nullptr, make_inputs(11));
+    if (!matches(outer.get_build_inputs(), 11) || !matches(outer_observer->observed, 11) ||
+            outer_observer->set_count != 2 || outer_observer->input_count != 2) {
+        return 3;
+    }
+
+    outer.reset();
+    if (outer.get_build_inputs().filter.enabled || outer.get_build_inputs().activation_tokens.tokens != nullptr) {
+        return 4;
+    }
+    return 0;
+}
+
+static int check_topology_reuse_guards() {
+    auto base = make_inputs(31);
+    auto changed_pointer = base;
+    changed_pointer.activation_tokens.tokens = reinterpret_cast<const llama_token *>(static_cast<uintptr_t>(999));
+    if (!base.topology_equal(changed_pointer)) {
+        return 5;
+    }
+
+    auto changed_filter = base;
+    changed_filter.filter.layer_end++;
+    if (base.topology_equal(changed_filter)) {
+        return 6;
+    }
+
+    auto removed_sideband = base;
+    removed_sideband.glm_dsa_top_k.values = nullptr;
+    if (base.topology_equal(removed_sideband)) {
+        return 7;
+    }
+
+    auto changed_shape = base;
+    changed_shape.mtp_embeddings.n_embd++;
+    if (base.topology_equal(changed_shape)) {
+        return 8;
+    }
+    return 0;
+}
+
+static int check_concurrent_builds() {
+    constexpr uint32_t thread_count = 12;
+    constexpr uint32_t iterations = 200;
+    std::atomic<uint32_t> ready { 0 };
+    std::atomic<bool> start { false };
+    std::atomic<bool> failed { false };
+    std::vector<std::thread> threads;
+    threads.reserve(thread_count);
+
+    for (uint32_t thread_id = 0; thread_id < thread_count; ++thread_id) {
+        threads.emplace_back([&, thread_id] {
+            llm_graph_result result(64);
+            auto input = std::make_unique<recording_input>();
+            auto * observer = input.get();
+            result.add_input(std::move(input));
+            ready.fetch_add(1, std::memory_order_release);
+            while (!start.load(std::memory_order_acquire)) {
+                std::this_thread::yield();
+            }
+            for (uint32_t iteration = 0; iteration < iterations; ++iteration) {
+                const uint32_t id = thread_id*iterations + iteration + 1;
+                result.set_inputs(nullptr, make_inputs(id));
+                if (!matches(result.get_build_inputs(), id) || !matches(observer->observed, id)) {
+                    failed.store(true, std::memory_order_release);
+                    return;
+                }
+            }
+        });
+    }
+
+    while (ready.load(std::memory_order_acquire) != thread_count) {
+        std::this_thread::yield();
+    }
+    start.store(true, std::memory_order_release);
+    for (auto & thread : threads) {
+        thread.join();
+    }
+    return failed.load(std::memory_order_acquire) ? 9 : 0;
+}
+
+static skippy_graph_build_inputs make_stage_inputs(
+        int32_t layer_start,
+        int32_t layer_end,
+        bool include_embeddings,
+        bool include_output) {
+    skippy_graph_build_inputs inputs;
+    inputs.filter.enabled = true;
+    inputs.filter.layer_start = layer_start;
+    inputs.filter.layer_end = layer_end;
+    inputs.filter.include_embeddings = include_embeddings;
+    inputs.filter.include_output = include_output;
+    return inputs;
+}

+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        return 64;
+    }
+    if (const int rc = check_sequential_and_nested_lifetimes()) {
+        return rc;
+    }
+    if (const int rc = check_topology_reuse_guards()) {
+        return rc;
+    }
+    if (const int rc = check_concurrent_builds()) {

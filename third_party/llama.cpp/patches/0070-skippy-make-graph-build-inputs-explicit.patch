+    }
+    llama_backend_init();
+    int rc = check_sched_reserve_and_memory_update(argv[1]);
+    if (rc == 0) {
+        rc = check_decode_encode_fallback(argv[2]);
+    }
+    llama_backend_free();
+    return rc;
+}

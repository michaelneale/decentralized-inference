new file mode 100644
index 000000000..8d0712c96
--- /dev/null
+++ b/src/skippy/graph_build_inputs.h
@@ -0,0 +1,134 @@
+#pragma once
+
+#include "skippy/activation.h"
+#include "skippy/runtime.h"
+
+#include "llama-graph.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+inline skippy_graph_build_inputs skippy_graph_build_inputs_from_config(
+        const skippy_runtime_config * config,
+        int32_t glm_dsa_phase_hint = SKIPPY_GLM_DSA_PHASE_HINT_AUTO) {
+    skippy_graph_build_inputs inputs;
+    const bool has_phase_hint = glm_dsa_phase_hint != SKIPPY_GLM_DSA_PHASE_HINT_AUTO;
+    if ((config != nullptr && (config->filter_tensors_on_load || config->glm_dsa_policy_profile != 0)) ||
+            has_phase_hint) {
+        inputs.filter.enabled = config != nullptr && config->filter_tensors_on_load;
+        if (config != nullptr) {
+            inputs.filter.layer_start = config->layer_start;
+            inputs.filter.layer_end = config->layer_end;
+            inputs.filter.include_embeddings = config->include_embeddings;
+            inputs.filter.include_output = config->include_output;
+            inputs.filter.glm_dsa_policy_profile = config->glm_dsa_policy_profile;
+            inputs.filter.glm_dsa_policy_flags = config->glm_dsa_policy_flags;
+            inputs.filter.glm_dsa_short_prefill_max_tokens = config->glm_dsa_short_prefill_max_tokens;
+            inputs.filter.glm_dsa_direct_sparse_decode_max_top_k = config->glm_dsa_direct_sparse_decode_max_top_k;
+            inputs.filter.glm_dsa_dense_sparse_mask_max_bytes = config->glm_dsa_dense_sparse_mask_max_bytes;
+            inputs.filter.glm_dsa_compact_flash_min_kv = config->glm_dsa_compact_flash_min_kv;
+        }
+        inputs.filter.glm_dsa_phase_hint = glm_dsa_phase_hint;
+    }
+    return inputs;
+}
+
+inline void skippy_graph_build_inputs_set_activation_tokens(
+        skippy_graph_build_inputs & inputs,
+        const llama_token * tokens,
+        size_t token_count) {
+    if (tokens != nullptr && token_count > 0 && token_count <= static_cast<size_t>(std::numeric_limits<uint32_t>::max())) {
+        inputs.activation_tokens.tokens = tokens;
+        inputs.activation_tokens.token_count = static_cast<uint32_t>(token_count);
+    }
+}
+
+inline void skippy_graph_build_inputs_set_rwkv7_v_first(
+        skippy_graph_build_inputs & inputs,
+        const skippy_activation_desc * desc,
+        const void * payload,
+        size_t hidden_bytes,
+        int32_t n_embd) {
+    if (desc != nullptr && payload != nullptr &&
+            (desc->flags & SKIPPY_ACTIVATION_FLAG_RWKV7_V_FIRST) != 0 &&
+            desc->payload_bytes >= hidden_bytes) {
+        inputs.rwkv7_v_first.values = reinterpret_cast<const float *>(static_cast<const uint8_t *>(payload) + hidden_bytes);
+        inputs.rwkv7_v_first.token_count = desc->token_count;
+        inputs.rwkv7_v_first.n_embd = static_cast<uint32_t>(n_embd);
+    }
+}
+
+inline void skippy_graph_build_inputs_set_gemma3n_altup(
+        skippy_graph_build_inputs & inputs,
+        const skippy_activation_desc * desc,
+        const void * payload,
+        int32_t n_embd,
+        int32_t n_altup) {
+    if (desc != nullptr && payload != nullptr &&
+            (desc->flags & SKIPPY_ACTIVATION_FLAG_GEMMA3N_ALTUP) != 0) {
+        inputs.gemma3n_altup.values = reinterpret_cast<const float *>(payload);
+        inputs.gemma3n_altup.token_count = desc->token_count;
+        inputs.gemma3n_altup.n_embd = static_cast<uint32_t>(n_embd);
+        inputs.gemma3n_altup.n_altup = static_cast<uint32_t>(n_altup);
+    }
+}
+
+inline void skippy_graph_build_inputs_set_qwen4exp_hc(
+        skippy_graph_build_inputs & inputs,
+        const void * payload,
+        uint32_t token_count,
+        int32_t n_embd,
+        int32_t n_hc) {
+    if (payload != nullptr && token_count > 0 && n_embd > 0 && n_hc > 0) {
+        inputs.qwen4exp_hc.values = static_cast<const float *>(payload);
+        inputs.qwen4exp_hc.token_count = token_count;
+        inputs.qwen4exp_hc.n_embd = static_cast<uint32_t>(n_embd);
+        inputs.qwen4exp_hc.n_hc = static_cast<uint32_t>(n_hc);
+    }
+}
+
+inline void skippy_graph_build_inputs_set_glm_dsa_top_k(
+        skippy_graph_build_inputs & inputs,
+        const skippy_activation_desc * desc,
+        const void * payload,
+        size_t hidden_bytes,
+        uint32_t n_top_k,
+        uint32_t n_stream,
+        llama_pos pos_start) {
+    if (desc != nullptr && payload != nullptr &&
+            (desc->flags & SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0) {
+        inputs.glm_dsa_top_k.values = reinterpret_cast<const int32_t *>(static_cast<const uint8_t *>(payload) + hidden_bytes);
+        inputs.glm_dsa_top_k.token_count = desc->token_count;
+        inputs.glm_dsa_top_k.n_top_k = n_top_k;
+        inputs.glm_dsa_top_k.n_stream = n_stream;
+        inputs.glm_dsa_top_k.pos_start = pos_start;
+    }
+}
+
+inline void skippy_graph_build_inputs_set_glm_dsa_top_k(
+        skippy_graph_build_inputs & inputs,
+        const int32_t * values,
+        uint32_t token_count,
+        uint32_t n_top_k,
+        uint32_t n_stream,
+        llama_pos pos_start) {
+    if (values != nullptr && token_count > 0 && n_top_k > 0 && n_stream > 0) {
+        inputs.glm_dsa_top_k.values = values;
+        inputs.glm_dsa_top_k.token_count = token_count;
+        inputs.glm_dsa_top_k.n_top_k = n_top_k;
+        inputs.glm_dsa_top_k.n_stream = n_stream;
+        inputs.glm_dsa_top_k.pos_start = pos_start;
+    }
+}
+
+inline void skippy_graph_build_inputs_set_mtp_embeddings(
+        skippy_graph_build_inputs & inputs,
+        const float * values,
+        uint32_t token_count,
+        uint32_t n_embd,
+        llama_pos pos_start) {
+    if (values != nullptr) {
+        inputs.mtp_embeddings = { values, token_count, n_embd, pos_start };
+    }
+}

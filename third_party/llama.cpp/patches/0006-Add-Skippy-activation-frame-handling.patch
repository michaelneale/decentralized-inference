+    if (value == nullptr || value[0] == '\0') {
+        return SKIPPY_GLM_DSA_DIRECT_SPARSE_DECODE_DEFAULT_MAX_TOP_K;
+    }
+
+    char * end = nullptr;
+    errno = 0;
+    const long long parsed = std::strtoll(value, &end, 10);
+    if (errno != 0 || end == value || *end != '\0') {
+        return SKIPPY_GLM_DSA_DIRECT_SPARSE_DECODE_DEFAULT_MAX_TOP_K;
+    }
+
+    return parsed <= 0 ? INT64_MAX : parsed;
+}

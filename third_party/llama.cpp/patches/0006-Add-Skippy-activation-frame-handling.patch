+static uint64_t skippy_glm_dsa_dense_sparse_mask_max_bytes() {
+    const char * value = std::getenv("SKIPPY_GLM_DSA_DENSE_SPARSE_MASK_MAX_BYTES");
+    if (value == nullptr || value[0] == '\0') {
+        return 512ULL * 1024ULL * 1024ULL;

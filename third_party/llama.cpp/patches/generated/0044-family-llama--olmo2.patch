From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate llama--olmo2 stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/olmo2.cpp b/src/models/olmo2.cpp
index cb52cdef720486f4b99f033acee0b76ba215e628..2f449d31135369370d4e8378f80d10a99bc0e350 100644
--- a/src/models/olmo2.cpp
+++ b/src/models/olmo2.cpp
@@ -71,7 +71,12 @@ llama_model_olmo2::graph<iswa>::graph(const llama_model & model, const llm_graph
     ggml_tensor * cur;
     ggml_tensor * inpL;
 
-    inpL = build_inp_embd(model.tok_embd);
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    inpL = build_inp_embd(stage_filtered && il_start > 0 ? nullptr : model.tok_embd);
 
     // inp_pos - contains the positions
     ggml_tensor * inp_pos = build_inp_pos();
@@ -84,9 +89,11 @@ llama_model_olmo2::graph<iswa>::graph(const llama_model & model, const llm_graph
     } else {
         inp_attn = build_attn_inp_kv();
     }
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
+
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
 
-    for (int il = 0; il < n_layer; ++il) {
         ggml_tensor * inpSA = inpL;
 
         cur = inpL;
@@ -153,7 +160,7 @@ llama_model_olmo2::graph<iswa>::graph(const llama_model & model, const llm_graph
                     model.layers[il].wo, NULL, model.layers[il].wo_s,
                     Qcur, Kcur, Vcur, nullptr, nullptr, nullptr, 1.0f/sqrtf(float(n_embd_head)), il);
         }
-        if (il == n_layer - 1 && inp_out_ids) {
+        if (il == il_end - 1 && inp_out_ids) {
             cur   = ggml_get_rows(ctx0,   cur, inp_out_ids);
             inpSA = ggml_get_rows(ctx0, inpSA, inp_out_ids);
         }
@@ -187,7 +194,15 @@ llama_model_olmo2::graph<iswa>::graph(const llama_model & model, const llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(inpL, "stage_boundary", il_end - 1);
+        res->t_embd = inpL;
+        ggml_build_forward_expand(gf, inpL);
+        return;
+    }
+
     cur = inpL;
 
     cur = build_norm(cur,
-- 
2.54.0


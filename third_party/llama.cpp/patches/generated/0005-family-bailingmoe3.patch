From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate bailingmoe3 stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/bailingmoe3.cpp b/src/models/bailingmoe3.cpp
index 17d0d8b738cf44dd059ec7dc273dcd61de73f00e..fd1fdce87bf3e4ecf5662068f2b8e774ece9cfa6 100644
--- a/src/models/bailingmoe3.cpp
+++ b/src/models/bailingmoe3.cpp
@@ -218,15 +218,28 @@ static ggml_tensor * bailingmoe3_causal_conv1d(
 
 llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph_params & params) :
     llm_build_delta_net_base(params), model(model) {
-    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    ggml_tensor * inpL = build_inp_embd(stage_filtered && il_start > 0 ? nullptr : model.tok_embd);
     cb(inpL, "model.input_embed", -1);
 
     auto * inp = build_inp_mem_hybrid_k();
     auto * inp_rs = inp->get_recr();
     auto * inp_attn = inp->get_attn();
 
-    ggml_tensor * inp_pos = build_inp_pos();
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    bool skippy_has_attention_layer = false;
+    for (int skippy_il = il_start; skippy_il < il_end; ++skippy_il) {
+        if (!hparams.is_recr(skippy_il)) {
+            skippy_has_attention_layer = true;
+            break;
+        }
+    }
+
+    ggml_tensor * inp_pos = skippy_has_attention_layer ? build_inp_pos() : nullptr;
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     const int64_t n_head = hparams.n_head();
     const int64_t head_dim = hparams.n_embd_head_kda;
@@ -245,7 +258,9 @@ llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph
     GGML_ASSERT(ubatch.equal_seqs());
     GGML_ASSERT(ubatch.n_tokens == n_seq_tokens * n_seqs);
 
-    for (int il = 0; il < n_layer; ++il) {
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         const auto & layer = model.layers[il];
@@ -352,7 +367,7 @@ llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph
             cb(cur, "mla_out", il);
         }
 
-        if (il == n_layer - 1 && inp_out_ids && cparams.embeddings_nextn_masked) {
+        if (il == il_end - 1 && inp_out_ids && cparams.embeddings_nextn_masked) {
             cur = ggml_get_rows(ctx0, cur, inp_out_ids);
             inpSA = ggml_get_rows(ctx0, inpSA, inp_out_ids);
         }
@@ -391,7 +406,15 @@ llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
         inpL = cur;
+        end_block(inpL, il);
     }
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(inpL, "stage_boundary", il_end - 1);
+        res->t_embd = inpL;
+        ggml_build_forward_expand(gf, inpL);
+        return;
+    }
+
 
     ggml_tensor * cur = build_norm(inpL, model.output_norm, nullptr, LLM_NORM_RMS, -1);
     cb(cur, "h_nextn", -1);
-- 
2.54.0


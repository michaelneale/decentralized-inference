From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate kimi-k3 stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/kimi-k3.cpp b/src/models/kimi-k3.cpp
index 20c861076c9cd9f24311136b4210b332396c2ee7..9bd3caab5f1e55fcc4b2979facc6f26b8715b302 100644
--- a/src/models/kimi-k3.cpp
+++ b/src/models/kimi-k3.cpp
@@ -237,7 +237,12 @@ llama_model_kimi_k3::graph::graph(const llama_model & model, const llm_graph_par
     ggml_tensor * cur;
     ggml_tensor * inpL;
 
-    inpL = build_inp_embd(model.tok_embd);
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    inpL = build_inp_embd(stage_filtered && il_start > 0 ? nullptr : model.tok_embd);
     cb(inpL, "inp_embd", -1);
 
     // K3 MLA is nope-only, so there is no position input
@@ -248,7 +253,7 @@ llama_model_kimi_k3::graph::graph(const llama_model & model, const llm_graph_par
     auto * inp_attn_kv = !hparams.is_mla() ? inp_kv->get_attn() : nullptr;
     auto * inp_attn_k  =  hparams.is_mla() ? inp_k->get_attn()  : nullptr;
 
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     const int64_t n_head_kda = hparams.n_head();
     const int64_t head_dim   = hparams.n_embd_head_kda;
@@ -272,7 +277,9 @@ llama_model_kimi_k3::graph::graph(const llama_model & model, const llm_graph_par
     const bool     use_attn_res  = res_bs > 0;
     const int64_t  n_embd_latent = hparams.n_expert_latent > 0 ? hparams.n_expert_latent : n_embd;
 
-    for (int il = 0; il < n_layer; ++il) {
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         // the residual stream, banked on checkpoint layers and then restarted
@@ -325,7 +332,15 @@ llama_model_kimi_k3::graph::graph(const llama_model & model, const llm_graph_par
         cb(prefix_sum, "l_out", il);
 
         inpL = prefix_sum;
+        end_block(inpL, il);
     }
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(inpL, "stage_boundary", il_end - 1);
+        res->t_embd = inpL;
+        ggml_build_forward_expand(gf, inpL);
+        return;
+    }
+
 
     cur = inpL;
 
-- 
2.54.0


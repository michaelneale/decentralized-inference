From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate qwen4exp stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index abf6a0502fbfbcad3232228dc0f45c18fba2091d..f438932345bd00c0cf637f56c251c13de5afd042 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -124,8 +124,21 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
         output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, TENSOR_DUPLICATED);
     }
 
+    const llama_model_loader_stage_filter load_filter = llama_model_loader_get_stage_filter();
+    bool stage_contains_ple = !load_filter.enabled;
+    if (load_filter.enabled) {
+        const int32_t layer_start = std::max<int32_t>(load_filter.layer_start, 0);
+        const int32_t layer_end = std::min<int32_t>(load_filter.layer_end, hparams.n_layer());
+        for (int32_t il = layer_start; il < layer_end; ++il) {
+            if (hparams.is_ple(static_cast<uint32_t>(il))) {
+                stage_contains_ple = true;
+                break;
+            }
+        }
+    }
+
     // flat [ple_head_dim, n_rows] gather target; n_rows is padded, so read it back
-    if (hparams.ple_n_heads > 0) {
+    if (hparams.ple_n_heads > 0 && stage_contains_ple) {
         const std::string ple_name = tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight").str();
         const auto & ple_w = ml.require_weight(ple_name.c_str());
         const int64_t ple_rows = ple_w.tensor->ne[1];
@@ -294,9 +307,25 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
     int sections[4];
     std::copy(std::begin(hparams.rope_sections), std::begin(hparams.rope_sections) + 4, sections);
 
-    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
-    cb(inpL, "model.input_embed", -1);
-    ggml_build_forward_expand(gf, inpL);
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    ggml_tensor * inpL = nullptr;
+    if (stage_filtered && il_start > 0) {
+        auto inp_hc = std::make_unique<llm_graph_input_hyperconnection>(n_embd, hc);
+        inp_hc->values = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_embd, hc, n_tokens);
+        cb(inp_hc->values, "hc_stage_input", -1);
+        ggml_set_input(inp_hc->values);
+        inpL = inp_hc->values;
+        res->t_skippy_activation_input = inpL;
+        res->add_input(std::move(inp_hc));
+    } else {
+        inpL = build_inp_embd(model.tok_embd);
+        cb(inpL, "model.input_embed", -1);
+        ggml_build_forward_expand(gf, inpL);
+    }
 
     auto * inp = build_inp_mem_hybrid();
 
@@ -311,22 +340,39 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
     }
 
     ggml_tensor * inp_pos     = build_inp_pos();
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
+    // a stage that retains no PLE layer also skips the PLE gather table:
+    // load_arch_tensors does not load it when no retained layer reads it
     ggml_tensor * ple_emb = nullptr;
-    if (hparams.ple_n_heads > 0) {
+    bool stage_contains_ple = false;
+    for (int il = il_start; il < il_end; ++il) {
+        if (hparams.is_ple(static_cast<uint32_t>(il))) {
+            stage_contains_ple = true;
+            break;
+        }
+    }
+    if (hparams.ple_n_heads > 0 && stage_contains_ple) {
         ple_emb = build_inp_ple(mctx_hyb);
         // make sure ple_emb and build_inp_embd are in the same graph split
         ggml_build_forward_expand(gf, ple_emb);
     }
 
-    // the wide residual starts as hc identical copies of the embedding
-    ggml_tensor * res_hc = ggml_repeat_4d(ctx0,
-            ggml_reshape_3d(ctx0, inpL, n_embd, 1, n_tokens),
-            n_embd, hc, n_tokens, 1);
-    cb(res_hc, "hc_init", -1);
+    // The first stage creates hc identical streams from token embeddings. A
+    // middle/final stage receives the prior stage's wide residual through its
+    // dedicated [n_embd, hc, tokens] graph input.
+    ggml_tensor * res_hc = il_start > 0
+            ? inpL
+            : ggml_repeat_4d(ctx0,
+                    ggml_reshape_3d(ctx0, inpL, n_embd, 1, n_tokens),
+                    n_embd, hc, n_tokens, 1);
+    if (il_start == 0) {
+        cb(res_hc, "hc_init", -1);
+    }
+
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(res_hc, il);
 
-    for (int il = 0; il < n_layer; ++il) {
         res->t_layer_inp[il] = res_hc;
 
         if (hparams.is_ple(il)) {
@@ -349,7 +395,7 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
             cur = build_layer_attn(inp->get_attn(), mctx_hyb, cur, inp_pos, sections, il);
         }
 
-        if (il == n_layer - 1 && inp_out_ids) {
+        if (il == il_end - 1 && inp_out_ids) {
             // everything below is per token, so drop the rows that produce no output
             cur    = ggml_get_rows(ctx0, cur,    inp_out_ids);
             inject = ggml_get_rows(ctx0, inject, inp_out_ids);
@@ -375,6 +421,15 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
 
         // "l_last" is the layer output name that build_cvec and imatrix look for
         cb(res_hc, "l_last", il);
+        end_block(res_hc, il);
+    }
+
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(res_hc, "stage_boundary", il_end - 1);
+        res->t_skippy_activation_output = res_hc;
+        res->t_embd = res_hc;
+        ggml_build_forward_expand(gf, res_hc);
+        return;
     }
 
     // the final mixer is the output norm: there is no separate one
@@ -525,6 +580,12 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
         ggml_set_input(qsa->blk_pos);
         ggml_set_input(qsa->bias);
 
+        request_input(qsa->k_idxs,    "qwen4exp.qsa.key_indices");
+        request_input(qsa->cell_blk,  "qwen4exp.qsa.cell_blocks");
+        request_input(qsa->blk_cells, "qwen4exp.qsa.block_cells");
+        request_input(qsa->blk_pos,   "qwen4exp.qsa.block_positions");
+        request_input(qsa->bias,      "qwen4exp.qsa.bias");
+
         inp = qsa.get();
         res->add_input(std::move(qsa));
         qsa_inps.emplace((uint32_t) r, inp);
@@ -838,7 +899,7 @@ ggml_tensor * llama_model_qwen4exp::graph::build_layer_attn_linear(
     ggml_tensor * conv_input = build_conv_state_at(inp, conv_states_all, qkv_mixed,
             conv_kernel_size - 1, conv_channels, il);
 
-    ggml_tensor * state = build_rs(inp, ssm_states_all, hparams.n_embd_s(), n_seqs);
+    ggml_tensor * state = build_rs(inp, ssm_states_all, hparams.n_embd_s(), n_seqs, skippy_state_kind::recurrent_ssm, il);
     state = ggml_reshape_4d(ctx0, state, head_v_dim, head_v_dim, num_v_heads, n_seqs);
     cb(state, "state_predelta", il);
 
@@ -1071,7 +1132,7 @@ ggml_tensor * llama_model_qwen4exp::graph::build_conv_state_at(
 
     auto it = rs_rows.find(conv_states_all);
     if (it == rs_rows.end()) {
-        it = rs_rows.emplace(conv_states_all, build_rs(inp, conv_states_all, row_total, n_seqs)).first;
+        it = rs_rows.emplace(conv_states_all, build_rs(inp, conv_states_all, row_total, n_seqs, skippy_state_kind::recurrent_conv, il)).first;
     }
     ggml_tensor * rows = it->second;
 
@@ -1093,7 +1154,9 @@ ggml_tensor * llama_model_qwen4exp::graph::build_conv_state_at(
             conv_states_all->nb[1],
             kv_head * row_size);
 
-    ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_cont(ctx0, tail), dst));
+    ggml_tensor * conv_write = ggml_cpy(ctx0, ggml_cont(ctx0, tail), dst);
+    ggml_build_forward_expand(gf, conv_write);
+    state_write(skippy_state_kind::recurrent_conv, conv_states_all, conv_write, il);
 
     return conv_input;
 }
@@ -1108,6 +1171,7 @@ ggml_tensor * llama_model_qwen4exp::graph::build_inp_ple(
 
     ple_inp->rows = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_heads * n_tokens);
     ggml_set_input(ple_inp->rows);
+    request_input(ple_inp->rows, "qwen4exp.ple.rows");
     ggml_tensor * rows = ple_inp->rows;
     res->add_input(std::move(ple_inp));
 
-- 
2.54.0


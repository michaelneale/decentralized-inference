From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate granite-switch stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/granite-switch.cpp b/src/models/granite-switch.cpp
index 7c9a901c8a4352c11232f6ff4f95ed4fa43c84a3..f4e9a216854694ca7ae8df336fa0fb6cacc7dd0f 100644
--- a/src/models/granite-switch.cpp
+++ b/src/models/granite-switch.cpp
@@ -248,8 +248,13 @@ llama_model_granite_switch::graph::graph(
     res->add_input(std::move(inp_switch));
 
     // embed the substituted ids directly; build_inp_embd would embed the raw tokens
-    ggml_tensor * inpL = ggml_get_rows(ctx0, model.tok_embd, sub_tokens);
-    if (hparams.f_embedding_scale != 0.0f) {
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    ggml_tensor * inpL = stage_filtered && il_start > 0 ? build_inp_embd(nullptr) : ggml_get_rows(ctx0, model.tok_embd, sub_tokens);
+    if ((!stage_filtered || il_start == 0) && (hparams.f_embedding_scale != 0.0f)) {
         inpL = ggml_scale(ctx0, inpL, hparams.f_embedding_scale);
     }
     cb(inpL, "inp_embd", -1);
@@ -286,11 +291,13 @@ llama_model_granite_switch::graph::graph(
     ggml_tensor * adapter_ids = ggml_cast(ctx0, slot_f, GGML_TYPE_I32);
     cb(adapter_ids, "adapter_ids", -1);
 
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     ggml_tensor * cur;
 
-    for (int il = 0; il < n_layer; ++il) {
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
@@ -298,7 +305,7 @@ llama_model_granite_switch::graph::graph(
 
         cur = build_attention_layer(cur, inp_pos, adapter_ids, inp_attn, model, n_embd_head, il);
 
-        if (il == n_layer - 1 && inp_out_ids) {
+        if (il == il_end - 1 && inp_out_ids) {
             cur   = ggml_get_rows(ctx0, cur,   inp_out_ids);
             inpSA = ggml_get_rows(ctx0, inpSA, inp_out_ids);
             // keep adapter_ids aligned to the kept rows (2D round-trip for get_rows)
@@ -311,7 +318,15 @@ llama_model_granite_switch::graph::graph(
         cur = build_layer_ffn(cur, inpSA, adapter_ids, model, il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(inpL, "stage_boundary", il_end - 1);
+        res->t_embd = inpL;
+        ggml_build_forward_expand(gf, inpL);
+        return;
+    }
+
 
     cur = inpL;
 
-- 
2.54.0


         res->t_layer_inp[il] = inpL;
 
         const auto & layer = model.layers[il];
@@ -351,7 +366,7 @@ llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph
             cb(cur, "mla_out", il);
         }
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate qwen4exp stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 051b1e6d375eca78ca533ec7d0bb4c2ac7c1aa26..3e8ec9f55f2c2f4fe99b40ceb0225bc942a21b7e 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -355,9 +355,18 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
     int sections[4];
     std::copy(std::begin(hparams.rope_sections), std::begin(hparams.rope_sections) + 4, sections);
 
-    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
-    cb(inpL, "model.input_embed", -1);
-    ggml_build_forward_expand(gf, inpL);
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    ggml_tensor * inpL = (!stage_filtered || il_start == 0) ? build_inp_embd(model.tok_embd) : nullptr;
+    if (!stage_filtered || il_start == 0) {
+        cb(inpL, "model.input_embed", -1);
+    }
+    if (!stage_filtered || il_start == 0) {
+        ggml_build_forward_expand(gf, inpL);
+    }
 
     auto * inp = build_inp_mem_hybrid();
 
@@ -371,23 +380,51 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
                 "the indexer cache must track the attention cache cell for cell");
     }
 
-    ggml_tensor * inp_pos     = build_inp_pos();
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+    bool skippy_has_attention_layer = false;
+    for (int skippy_il = il_start; skippy_il < il_end; ++skippy_il) {
+        if (!hparams.is_recr(skippy_il)) {
+            skippy_has_attention_layer = true;
+            break;
+        }
+    }
+
+    ggml_tensor * inp_pos     = skippy_has_attention_layer ? build_inp_pos() : nullptr;
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     ggml_tensor * ple_emb = nullptr;
-    if (hparams.ple_n_heads > 0) {
+    bool skippy_stage_contains_ple = false;
+    for (int skippy_il = il_start; skippy_il < il_end; ++skippy_il) {
+        if (hparams.is_ple(static_cast<uint32_t>(skippy_il))) {
+            skippy_stage_contains_ple = true;
+            break;
+        }
+    }
+
+    if ((hparams.ple_n_heads > 0) && skippy_stage_contains_ple) {
         ple_emb = build_inp_ple(mctx_hyb);
         // make sure ple_emb and build_inp_embd are in the same graph split
         ggml_build_forward_expand(gf, ple_emb);
     }
 
     // the wide residual starts as hc identical copies of the embedding
-    ggml_tensor * res_hc = ggml_repeat_4d(ctx0,
+    ggml_tensor * res_hc = stage_filtered && il_start > 0 ? nullptr : ggml_repeat_4d(ctx0,
             ggml_reshape_3d(ctx0, inpL, n_embd, 1, n_tokens),
             n_embd, hc, n_tokens, 1);
+    if (stage_filtered && il_start > 0) {
+        auto stage_inp = std::make_unique<llm_graph_input_hyperconnection>(n_embd, hc);
+        stage_inp->values = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_embd, hc, n_tokens);
+        cb(stage_inp->values, "hc_stage_input", -1);
+        ggml_set_input(stage_inp->values);
+        res_hc = stage_inp->values;
+        res->t_skippy_activation_input = res_hc;
+        res->add_input(std::move(stage_inp));
+    }
+
     cb(res_hc, "hc_init", -1);
 
-    for (int il = 0; il < n_layer; ++il) {
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(res_hc, il);
+
         res->t_layer_inp[il] = res_hc;
 
         if (hparams.is_ple(il)) {
@@ -410,7 +447,7 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
             cur = build_layer_attn(inp->get_attn(), mctx_hyb, cur, inp_pos, sections, il);
         }
 
-        if (il == n_layer - 1 && inp_out_ids) {
+        if (il == il_end - 1 && inp_out_ids) {
             // everything below is per token, so drop the rows that produce no output
             cur    = ggml_get_rows(ctx0, cur,    inp_out_ids);
             inject = ggml_get_rows(ctx0, inject, inp_out_ids);
@@ -436,8 +473,17 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
 
         // "l_last" is the layer output name that build_cvec and imatrix look for
         cb(res_hc, "l_last", il);
+        end_block(res_hc, il);
+    }
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(res_hc, "stage_boundary", il_end - 1);
+        res->t_skippy_activation_output = res_hc;
+        res->t_embd = res_hc;
+        ggml_build_forward_expand(gf, res_hc);
+        return;
     }
 
+
     // the final mixer is the output norm: there is no separate one
     ggml_tensor * cur = build_hc_mix(res_hc,
             model.hc_head_norm, model.hc_head_down, model.hc_head_up,
-- 
2.54.0


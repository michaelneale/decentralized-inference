diff --git a/src/models/bailingmoe3.cpp b/src/models/bailingmoe3.cpp
index 17d0d8b738cf44dd059ec7dc273dcd61de73f00e..fd1fdce87bf3e4ecf5662068f2b8e774ece9cfa6 100644

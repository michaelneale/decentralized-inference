Subject: [PATCH] skippy: register Falcon-H1 block boundaries

---
 src/models/falcon-h1.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/models/falcon-h1.cpp b/src/models/falcon-h1.cpp
index 98b2000ae..a0afc1040 100644
--- a/src/models/falcon-h1.cpp
+++ b/src/models/falcon-h1.cpp
@@ -135,6 +135,8 @@ llama_model_falcon_h1::graph::graph(const llama_model & model, const llm_graph_p
     ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
@@ -194,6 +196,8 @@ llama_model_falcon_h1::graph::graph(const llama_model & model, const llm_graph_p
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
 
+        end_block(cur, il);
+
         // input for next layer
         inpL = cur;
     }

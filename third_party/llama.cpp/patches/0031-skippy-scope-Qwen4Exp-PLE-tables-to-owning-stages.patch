From 5f82062ed159f9194d55a5b805350eabb9842ae6 Mon Sep 17 00:00:00 2001
From: Jimmy
 <1fe240cd1a8cf775f6f3060f115e5a303181f3abf28ad4cb0c2515f4a02b36a8@meshllm.communities.buzz.xyz>
Date: Sat, 29 Aug 2026 02:13:55 +1000
Subject: [PATCH 31/56] skippy: scope Qwen4Exp PLE tables to owning stages

Co-authored-by: michaelneale <14976+michaelneale@users.noreply.github.com>

Signed-off-by: michaelneale <14976+michaelneale@users.noreply.github.com>
---
 src/llama-model-loader.cpp   | 22 ++++++++++++++++++----
 src/models/qwen4exp.cpp      | 29 ++++++++++++++++++++++++++---
 src/skippy/model_package.cpp | 35 +++++++++++++++++++++++++++++++++--
 3 files changed, 77 insertions(+), 9 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 1dcfb890f..3b91fbad6 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1116,6 +1116,19 @@ static bool weight_buft_supported(const llama_hparams & hparams, ggml_tensor * w
 }
 
 // find the first buffer type in the list that can use the tensor
+static bool skippy_stage_contains_ple(
+        const llama_hparams & hparams,
+        const llama_model_loader_stage_filter & filter) {
+    const int32_t layer_start = std::max<int32_t>(filter.layer_start, 0);
+    const int32_t layer_end = std::min<int32_t>(filter.layer_end, hparams.n_layer());
+    for (int32_t il = layer_start; il < layer_end; ++il) {
+        if (hparams.is_ple(static_cast<uint32_t>(il))) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static ggml_backend_buffer_type_t select_weight_buft(const llama_hparams & hparams, ggml_tensor * tensor, ggml_op op, const buft_list_t * buft_list) {
     GGML_ASSERT(!buft_list->empty());
     for (const auto & cur : *buft_list) {
@@ -1234,6 +1247,9 @@ struct ggml_tensor * llama_model_loader::create_tensor(
             return false;
         }
 
+        const bool stage_contains_ple = llm_kv.arch == LLM_ARCH_QWEN4EXP &&
+                hparams.ple_n_heads > 0 && skippy_stage_contains_ple(hparams, g_skippy_filter);
+
         bool keep = true;
         switch (info.layer) {
             case LLM_TENSOR_LAYER_INPUT:
@@ -1264,11 +1280,9 @@ struct ggml_tensor * llama_model_loader::create_tensor(
                    (tn.tensor == LLM_TENSOR_ALTUP_PROJ && g_skippy_filter.include_embeddings) ||
                    (tn.tensor == LLM_TENSOR_ALTUP_UNEMBD_PROJ && g_skippy_filter.include_output);
         }
-        if (!keep && llm_kv.arch == LLM_ARCH_QWEN4EXP && hparams.ple_n_heads > 0) {
+        if (!keep && stage_contains_ple) {
             // QWEN4EXP's PLE n-gram table is classified as an input tensor, but it is
-            // read by every retained PLE layer, not only by a stage that owns the
-            // embeddings. load_arch_tensors also require_weight()s it unconditionally
-            // whenever ple_n_heads > 0, so a stage that drops it cannot load at all.
+            // read by a retained PLE layer independently of the token embeddings.
             keep = tn.tensor == LLM_TENSOR_PER_LAYER_TOKEN_EMBD;
         }
         if (!keep &&
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 9f6e4f671..a2c313ed8 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -166,8 +166,22 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
         output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, TENSOR_DUPLICATED);
     }
 
-    // flat [ple_head_dim, n_rows] gather target
-    if (hparams.ple_n_heads > 0) {
+    const llama_model_loader_stage_filter load_filter = llama_model_loader_get_stage_filter();
+    bool stage_contains_ple = !load_filter.enabled;
+    if (load_filter.enabled) {
+        const int32_t layer_start = std::max<int32_t>(load_filter.layer_start, 0);
+        const int32_t layer_end = std::min<int32_t>(load_filter.layer_end, hparams.n_layer());
+        for (int32_t il = layer_start; il < layer_end; ++il) {
+            if (hparams.is_ple(static_cast<uint32_t>(il))) {
+                stage_contains_ple = true;
+                break;
+            }
+        }
+    }
+
+    // flat [ple_head_dim, n_rows] gather target; a stage that owns no PLE layer
+    // skips the table entirely so it is not retained by the stage load
+    if (hparams.ple_n_heads > 0 && stage_contains_ple) {
         // the head ranges are what the gather indexes, so they set the minimum row count
         int64_t ple_rows = 0;
         for (uint32_t h = 0; h < hparams.ple_n_heads; ++h) {
@@ -376,8 +390,17 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
     ggml_tensor * inp_pos     = build_inp_pos();
     ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
+    // a stage that retains no PLE layer also skips the PLE gather table:
+    // load_arch_tensors does not load it when no retained layer reads it
     ggml_tensor * ple_emb = nullptr;
-    if (hparams.ple_n_heads > 0) {
+    bool stage_contains_ple = false;
+    for (int il = il_start; il < il_end; ++il) {
+        if (hparams.is_ple(static_cast<uint32_t>(il))) {
+            stage_contains_ple = true;
+            break;
+        }
+    }
+    if (hparams.ple_n_heads > 0 && stage_contains_ple) {
         ple_emb = build_inp_ple(mctx_hyb);
         // make sure ple_emb and build_inp_embd are in the same graph split
         ggml_build_forward_expand(gf, ple_emb);
diff --git a/src/skippy/model_package.cpp b/src/skippy/model_package.cpp
index 65d15b717..36f32119a 100644
--- a/src/skippy/model_package.cpp
+++ b/src/skippy/model_package.cpp
@@ -250,7 +250,38 @@ static bool skippy_parse_tensor_metadata(skippy_model_info * info) {
     return ok && info->tensors.size() == static_cast<size_t>(n_tensors);
 }
 
-static bool skippy_tensor_selected(const skippy_tensor_meta & tensor, const skippy_slice_range & range) {
+static bool skippy_stage_contains_ple(
+        const skippy_model_info & info,
+        const skippy_slice_range & range) {
+    return std::any_of(info.tensors.begin(), info.tensors.end(), [&](const skippy_tensor_meta & tensor) {
+        if (tensor.layer_index < range.layer_start || tensor.layer_index >= range.layer_end) {
+            return false;
+        }
+        static const std::regex ple_pattern("^blk\\.[0-9]+\\.ple_");
+        return std::regex_search(tensor.name, ple_pattern);
+    });
+}
+
+static bool skippy_tensor_selected(
+        const skippy_model_info & info,
+        const skippy_tensor_meta & tensor,
+        const skippy_slice_range & range) {
+    if (tensor.name == "per_layer_token_embd.weight") {
+        const bool qwen4exp_shape = std::any_of(
+                info.tensors.begin(), info.tensors.end(), [](const skippy_tensor_meta & candidate) {
+                    static const std::regex ple_pattern("^blk\\.[0-9]+\\.ple_");
+                    return std::regex_search(candidate.name, ple_pattern);
+                });
+        if (qwen4exp_shape) {
+            // Qwen4Exp has sparse PLE consumers. Infer them from the PLE block
+            // tensors because a split-shard GGUF context exposes only shard-local
+            // metadata and may omit qwen4exp.ple.layers entirely.
+            return skippy_stage_contains_ple(info, range);
+        }
+        // Other families using this shared table consume it throughout their
+        // blocks; preserve retention on every stage for those architectures.
+        return true;
+    }
     if (tensor.layer_index >= 0) {
         return tensor.layer_index >= range.layer_start && tensor.layer_index < range.layer_end;
     }
@@ -578,7 +609,7 @@ enum skippy_status skippy_write_slice_gguf(
 
     std::vector<skippy_source_tensor> selected;
     for (const skippy_tensor_meta & tensor : info->tensors) {
-        if (skippy_tensor_selected(tensor, *range)) {
+        if (skippy_tensor_selected(*info, tensor, *range)) {
             selected.push_back({ info, &tensor });
         }
     }

@@ -84,6 +84,32 @@ struct skippy_gemma3n_altup_scope {
     bool enabled = false;
 };
 
+struct skippy_qwen4exp_hc_scope {
+    skippy_qwen4exp_hc_scope(
+            const void * payload,
+            uint32_t token_count,
+            int32_t n_embd,
+            int32_t n_hc) {
+        if (payload != nullptr && token_count > 0 && n_embd > 0 && n_hc > 0) {
+            skippy_activation_qwen4exp_hc activation;
+            activation.values = static_cast<const float *>(payload);
+            activation.token_count = token_count;
+            activation.n_embd = static_cast<uint32_t>(n_embd);
+            activation.n_hc = static_cast<uint32_t>(n_hc);
+            skippy_graph_set_qwen4exp_hc(activation);
+            enabled = true;
+        }
+    }
+
+    ~skippy_qwen4exp_hc_scope() {
+        if (enabled) {
+            skippy_graph_clear_qwen4exp_hc();
+        }
+    }
+
+    bool enabled = false;
+};

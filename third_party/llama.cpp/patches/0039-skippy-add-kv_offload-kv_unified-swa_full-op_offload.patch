+    target_include_directories(skippy-tokenization PRIVATE .)
+    target_compile_features(skippy-tokenization PRIVATE cxx_std_17)
+    target_link_libraries(skippy-tokenization PRIVATE llama)
+    add_test(NAME skippy_tokenization COMMAND skippy-tokenization
+        "${PROJECT_SOURCE_DIR}/models/ggml-vocab-llama-spm.gguf")
+
+    add_executable(skippy-hardware-application-probe
+        skippy/tests/hardware_application_probe.cpp)
+    target_include_directories(skippy-hardware-application-probe PRIVATE .)
+    target_compile_features(skippy-hardware-application-probe PRIVATE cxx_std_17)
+    target_link_libraries(skippy-hardware-application-probe PRIVATE llama)
+    add_test(
+        NAME skippy_hardware_application_probe
+        COMMAND skippy-hardware-application-probe)
+endif()
+
 if (BUILD_SHARED_LIBS)
     set_target_properties(llama PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
diff --git a/src/skippy/model_load_config.cpp b/src/skippy/model_load_config.cpp
index 43c95ee4d..594caf75e 100644
--- a/src/skippy/model_load_config.cpp
+++ b/src/skippy/model_load_config.cpp
@@ -130,9 +130,31 @@ void skippy_apply_model_load_memory_config(
     if (config == nullptr) {
         return;
     }
-    if (config->use_mlock) {
+    if (config->use_direct_io) {
+        params.load_mode = LLAMA_LOAD_MODE_DIRECT_IO;
+    } else if (config->use_mlock) {
         params.load_mode = LLAMA_LOAD_MODE_MLOCK;
     } else if (config->has_mmap_override) {
         params.load_mode = config->use_mmap ? LLAMA_LOAD_MODE_MMAP : LLAMA_LOAD_MODE_NONE;
     }
+    params.check_tensors = config->check_tensors;
+    params.no_host = config->no_host_buffer;
+    if (config->has_main_gpu_override) {
+        params.main_gpu = config->main_gpu;
+    }
+    if (config->split_mode != SKIPPY_TRISTATE_AUTO) {
+        params.split_mode = static_cast<llama_split_mode>(config->split_mode);
+    }
+    if (config->disable_repack || config->filter_tensors_on_load) {
+        params.use_extra_bufts = false;
+    }
+}
+
+void skippy_apply_context_hardware_config(
+        const struct skippy_runtime_config * config,
+        llama_context_params & params) {
+    if (config == nullptr || config->op_offload == SKIPPY_TRISTATE_AUTO) {
+        return;
+    }
+    params.op_offload = config->op_offload == SKIPPY_TRISTATE_TRUE;
 }
diff --git a/src/skippy/model_load_config_internal.h b/src/skippy/model_load_config_internal.h
index 8bd88058a..0f7c83139 100644
--- a/src/skippy/model_load_config_internal.h
+++ b/src/skippy/model_load_config_internal.h
@@ -20,3 +20,6 @@ enum skippy_status skippy_apply_selected_backend_device(
 void skippy_apply_model_load_memory_config(
         const skippy_runtime_config * config,
         llama_model_params & params);
+void skippy_apply_context_hardware_config(
+        const skippy_runtime_config * config,
+        llama_context_params & params);
diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index 64ddaf1bb..33c54cf42 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -452,6 +452,18 @@ static void skippy_enable_integrated_mtp_tensors(
                       config->mtp_source == SKIPPY_MTP_SOURCE_INTEGRATED;
 }
 
+// Applies a tri-state config override on top of a derived default. Auto
+// (SKIPPY_TRISTATE_AUTO) keeps the derived value; false/true replace it.
+static bool skippy_resolve_tristate(int32_t tristate, bool derived_default) {
+    if (tristate == SKIPPY_TRISTATE_FALSE) {
+        return false;
+    }
+    if (tristate == SKIPPY_TRISTATE_TRUE) {
+        return true;
+    }
+    return derived_default;
+}
+
 extern "C" {
 
 static enum skippy_status skippy_finish_model_open(
@@ -518,6 +530,12 @@ static enum skippy_status skippy_finish_model_open(
     params.n_threads_batch = config != nullptr && config->n_threads_batch > 0 ? config->n_threads_batch : params.n_threads;
     params.n_seq_max = stage_model->lane_count;
     params.kv_unified = stage_model->lane_count > 1;
+    if (config != nullptr) {
+        params.kv_unified = skippy_resolve_tristate(config->kv_unified, params.kv_unified);
+        params.offload_kqv = skippy_resolve_tristate(config->kv_offload, params.offload_kqv);
+        params.swa_full = skippy_resolve_tristate(config->swa_full, params.swa_full);
+        skippy_apply_context_hardware_config(config, params);
+    }
     params.type_k = config != nullptr && config->cache_type_k > 0 ? static_cast<ggml_type>(config->cache_type_k) : GGML_TYPE_F16;
     params.type_v = config != nullptr && config->cache_type_v > 0 ? static_cast<ggml_type>(config->cache_type_v) : GGML_TYPE_F16;
     params.flash_attn_type = config != nullptr ? static_cast<llama_flash_attn_type>(config->flash_attn_type) : LLAMA_FLASH_ATTN_TYPE_AUTO;
@@ -637,9 +655,6 @@ enum skippy_status skippy_model_open_impl(
     if (config != nullptr) {
         params.n_gpu_layers = config->n_gpu_layers;
         skippy_apply_model_load_memory_config(config, params);
-        if (config->disable_repack || config->filter_tensors_on_load) {
-            params.use_extra_bufts = false;
-        }
     }
     if (event_scope.is_enabled()) {
         params.progress_callback = skippy_model_open_progress_callback;
@@ -724,9 +739,6 @@ enum skippy_status skippy_model_open_from_parts_impl(
     if (config != nullptr) {
         params.n_gpu_layers = config->n_gpu_layers;
         skippy_apply_model_load_memory_config(config, params);
-        if (config->disable_repack || config->filter_tensors_on_load) {
-            params.use_extra_bufts = false;
-        }
     }
     if (event_scope.is_enabled()) {
         params.progress_callback = skippy_model_open_progress_callback;
@@ -783,9 +795,6 @@ enum skippy_status skippy_model_attach_mtp_draft_model(
     if (config != nullptr) {
         model_params.n_gpu_layers = config->n_gpu_layers;
         skippy_apply_model_load_memory_config(config, model_params);
-        if (config->disable_repack || config->filter_tensors_on_load) {
-            model_params.use_extra_bufts = false;
-        }
     }
 
     llama_backend_init();
@@ -815,6 +824,12 @@ enum skippy_status skippy_model_attach_mtp_draft_model(
     ctx_params.n_threads_batch = config != nullptr && config->n_threads_batch > 0 ? config->n_threads_batch : ctx_params.n_threads;
     ctx_params.n_seq_max = target_model->lane_count;
     ctx_params.kv_unified = target_model->lane_count > 1;
+    if (config != nullptr) {
+        ctx_params.kv_unified = skippy_resolve_tristate(config->kv_unified, ctx_params.kv_unified);
+        ctx_params.offload_kqv = skippy_resolve_tristate(config->kv_offload, ctx_params.offload_kqv);
+        ctx_params.swa_full = skippy_resolve_tristate(config->swa_full, ctx_params.swa_full);
+        skippy_apply_context_hardware_config(config, ctx_params);
+    }
     ctx_params.type_k = config != nullptr && config->cache_type_k > 0 ? static_cast<ggml_type>(config->cache_type_k) : GGML_TYPE_F16;
     ctx_params.type_v = config != nullptr && config->cache_type_v > 0 ? static_cast<ggml_type>(config->cache_type_v) : GGML_TYPE_F16;
     ctx_params.flash_attn_type = config != nullptr ? static_cast<llama_flash_attn_type>(config->flash_attn_type) : LLAMA_FLASH_ATTN_TYPE_AUTO;
diff --git a/src/skippy/tests/hardware_application_probe.cpp b/src/skippy/tests/hardware_application_probe.cpp
new file mode 100644
index 000000000..42fae794a
--- /dev/null
+++ b/src/skippy/tests/hardware_application_probe.cpp
@@ -0,0 +1,53 @@
+#include "skippy/model_load_config_internal.h"
+#include "skippy/runtime.h"
+
+#include <cstdio>
+
+static bool require(bool condition, const char * message) {
+    if (!condition) {
+        std::fprintf(stderr, "%s\n", message);
+    }
+    return condition;
+}
+
+int main() {
+    skippy_runtime_config config{};
+    config.use_direct_io = true;
+    config.use_mlock = true;
+    config.has_mmap_override = true;
+    config.use_mmap = true;
+    config.no_host_buffer = true;
+    config.check_tensors = true;
+    config.has_main_gpu_override = true;
+    config.main_gpu = 2;
+    config.split_mode = LLAMA_SPLIT_MODE_ROW;
+    config.disable_repack = true;
+
+    llama_model_params model_params = llama_model_default_params();
+    skippy_apply_model_load_memory_config(&config, model_params);
+
+    bool passed = true;
+    passed &= require(model_params.load_mode == LLAMA_LOAD_MODE_DIRECT_IO,
+            "direct I/O must take precedence over mmap and mlock");
+    passed &= require(model_params.main_gpu == 2, "main_gpu override was not applied");
+    passed &= require(model_params.split_mode == LLAMA_SPLIT_MODE_ROW, "split mode was not applied");
+    passed &= require(model_params.no_host, "host-buffer policy was not applied");
+    passed &= require(model_params.check_tensors, "tensor checking was not applied");
+    passed &= require(!model_params.use_extra_bufts, "disabled repack must disable extra buffer types");
+
+    llama_context_params context_params = llama_context_default_params();
+    context_params.op_offload = true;
+    config.op_offload = SKIPPY_TRISTATE_AUTO;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(context_params.op_offload, "auto op_offload must preserve the derived default");
+
+    config.op_offload = SKIPPY_TRISTATE_FALSE;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(!context_params.op_offload, "false op_offload override was not applied");
+
+    config.op_offload = SKIPPY_TRISTATE_TRUE;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(context_params.op_offload, "true op_offload override was not applied");
+
+    return passed ? 0 : 1;
+}

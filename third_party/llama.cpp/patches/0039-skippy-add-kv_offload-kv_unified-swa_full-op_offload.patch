From e18b65b84418d41ead23ea8d70f28aaa906d258c Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 27 Aug 2026 15:26:27 -0400
Subject: [PATCH 39/56] skippy: add kv_offload, kv_unified, swa_full, op_offload,
 no_host_buffer, check_tensors, direct_io, main_gpu, and split_mode runtime
 config controls

---
 CMakeLists.txt                                |  5 ++
 include/skippy/common.h                       |  2 +-
 include/skippy/runtime.h                      | 34 ++++++++++++
 src/CMakeLists.txt                            | 18 +++++++
 src/skippy/model_load_config.cpp              | 24 ++++++++-
 src/skippy/model_load_config_internal.h       |  3 ++
 src/skippy/model_loading.cpp                  | 33 ++++++++----
 .../tests/hardware_application_probe.cpp      | 53 +++++++++++++++++++
 8 files changed, 161 insertions(+), 11 deletions(-)
 create mode 100644 src/skippy/tests/hardware_application_probe.cpp


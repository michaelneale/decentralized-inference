+            had_old_value = true;
+            this->old_value = old_value;
+        }
+        set_test_env(name, value);
+    }
+
+    ~scoped_test_env() {
+        if (had_old_value) {
+            set_test_env(name, old_value.c_str());
+        } else {
+            unset_test_env(name);
+        }
+    }
+
+private:

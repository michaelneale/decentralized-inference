index 3a00c0e93..572d833ab 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -1061,6 +1061,12 @@ public:
     ggml_tensor * get_skippy_rwkv7_v_first() const { return t_skippy_rwkv7_v_first; }
     ggml_tensor * get_skippy_gemma3n_altup() const { return t_skippy_gemma3n_altup; }

+    }
 
     ggml_tensor * get_layer_inp(int il) const { return t_layer_inp[il]; }
 
@@ -1099,6 +1105,8 @@ public:
     ggml_tensor * t_skippy_rwkv7_v_first = nullptr;
     ggml_tensor * t_skippy_gemma3n_altup = nullptr;
     ggml_tensor * t_skippy_glm_dsa_top_k = nullptr;
+    ggml_tensor * t_skippy_activation_input = nullptr;
+    ggml_tensor * t_skippy_activation_output = nullptr;
 
     std::vector<ggml_tensor *> t_layer_inp;
 
diff --git a/src/skippy/abi.cpp b/src/skippy/abi.cpp
index f48e56cb5..1c3574149 100644

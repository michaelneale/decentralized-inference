@@ -34,7 +34,7 @@ extern "C" {
 
 #define SKIPPY_ABI_VERSION_MAJOR 0
 #define SKIPPY_ABI_VERSION_MINOR 1
-#define SKIPPY_ABI_VERSION_PATCH 44
+#define SKIPPY_ABI_VERSION_PATCH 45
 
 #if defined(_MSC_VER)
 #define SKIPPY_DEPRECATED(message) __declspec(deprecated(message))
@@ -73,6 +73,7 @@ enum skippy_feature {
     SKIPPY_FEATURE_NGRAM_CACHE_DRAFT      = 1 << 26,
     SKIPPY_FEATURE_INKLING_MTP_MM         = 1 << 27,
     SKIPPY_FEATURE_ITERATION_BATCH        = 1 << 28,
+    SKIPPY_FEATURE_ACTIVATION_BOUNDARY     = 1 << 29,
 };
 
 enum skippy_status {
diff --git a/include/skippy/runtime.h b/include/skippy/runtime.h
index ba62f60cf..f63a3418f 100644
--- a/include/skippy/runtime.h
+++ b/include/skippy/runtime.h
@@ -37,6 +37,7 @@ enum skippy_mtp_source {
 
 struct skippy_model;
 struct skippy_session;
+struct skippy_activation_boundary_desc;
 
 /** @brief Model, stage, memory, cache, device, and family-policy load options. */
 struct skippy_runtime_config {
@@ -164,6 +165,16 @@ LLAMA_API enum skippy_status skippy_model_free(
 LLAMA_API const struct llama_model * skippy_model_llama_model(
         const struct skippy_model * model);
 
+/** @brief Reads the configured stage graph's observed output boundary descriptor. */
+LLAMA_API bool skippy_model_output_activation_boundary(
+        const struct skippy_model * model,
+        struct skippy_activation_boundary_desc * out_desc);
+
+/** @brief Reads the configured stage graph's observed input boundary descriptor. */
+LLAMA_API bool skippy_model_input_activation_boundary(
+        const struct skippy_model * model,
+        struct skippy_activation_boundary_desc * out_desc);
+
 /** @brief Creates a fresh inference session for an opened model. */
 LLAMA_API enum skippy_status skippy_session_create(
         struct skippy_model * model,
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 756d09a14..6526dd382 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -12,6 +12,7 @@
 #include "llama-ext.h"
 #include "llama-sampler.h"
 #include "llama.h"
+#include "skippy/graph_filter_scope.h"
 
 #include <cinttypes>
 #include <cmath>
@@ -2448,6 +2449,32 @@ llm_graph_result * llama_context::get_gf_res_prev() const {
     return static_cast<llm_graph_result *>(gf_res_prev.get());
 }
 
+bool llama_context::get_activation_boundary(
+        enum ggml_type & type,
+        uint64_t & elements_per_token,
+        uint64_t & bytes_per_token) const {
+    if (!activation_boundary_observed || !activation_boundary_stable) {
+        return false;
+    }
+    type = activation_boundary_type;
+    elements_per_token = activation_boundary_elements_per_token;
+    bytes_per_token = activation_boundary_bytes_per_token;
+    return true;
+}
+
+bool llama_context::get_input_activation_boundary(
+        enum ggml_type & type,
+        uint64_t & elements_per_token,
+        uint64_t & bytes_per_token) const {
+    if (!input_activation_boundary_observed || !input_activation_boundary_stable) {
+        return false;
+    }
+    type = input_activation_boundary_type;
+    elements_per_token = input_activation_boundary_elements_per_token;
+    bytes_per_token = input_activation_boundary_bytes_per_token;
+    return true;
+}
+
 ggml_cgraph * llama_context::graph_reserve(
         uint32_t n_tokens, uint32_t n_seqs, uint32_t n_outputs, const llama_memory_context_i * mctx, bool split_only, size_t * sizes) {
     LLAMA_LOG_DEBUG("%s: reserving a graph for ubatch with n_tokens = %4u, n_seqs = %2u, n_outputs = %4u\n", __func__, n_tokens, n_seqs, n_outputs);
@@ -2482,6 +2509,68 @@ ggml_cgraph * llama_context::graph_reserve(
 
     auto * gf = model.build_graph(gparams);
 
+    const auto graph_boundary_per_token = [](
+            const ggml_tensor * boundary,
+            uint64_t token_count,
+            uint64_t & elements_per_token,
+            uint64_t & bytes_per_token) {
+        if (boundary == nullptr || !ggml_is_contiguous(boundary) || token_count == 0) {
+            return false;
+        }
+        const uint64_t total_elements = static_cast<uint64_t>(ggml_nelements(boundary));
+        if (total_elements == 0 || total_elements % token_count != 0) {
+            return false;
+        }
+        elements_per_token = total_elements / token_count;
+        const uint64_t total_bytes = static_cast<uint64_t>(ggml_nbytes(boundary));
+        if (total_bytes == 0 || total_bytes % token_count != 0) {
+            return false;
+        }
+        bytes_per_token = total_bytes / token_count;
+        return bytes_per_token > 0;
+    };
+
+    const skippy_graph_filter & stage_filter = skippy_graph_get_filter();
+    if (stage_filter.enabled && !stage_filter.include_embeddings) {
+        const ggml_tensor * boundary = res->get_skippy_activation_input();
+        uint64_t elements_per_token = 0;
+        uint64_t bytes_per_token = 0;
+        if (graph_boundary_per_token(boundary, ubatch.n_tokens, elements_per_token, bytes_per_token)) {
+            if (!input_activation_boundary_observed) {
+                input_activation_boundary_observed = true;
+                input_activation_boundary_type = boundary->type;
+                input_activation_boundary_elements_per_token = elements_per_token;
+                input_activation_boundary_bytes_per_token = bytes_per_token;
+            } else if (input_activation_boundary_type != boundary->type ||
+                       input_activation_boundary_elements_per_token != elements_per_token ||
+                       input_activation_boundary_bytes_per_token != bytes_per_token) {
+                input_activation_boundary_stable = false;
+            }
+        } else {
+            input_activation_boundary_stable = false;
+        }
+    }
+
+    if (stage_filter.enabled && !stage_filter.include_output) {
+        const ggml_tensor * boundary = res->get_skippy_activation_output();
+        uint64_t elements_per_token = 0;
+        uint64_t bytes_per_token = 0;
+        if (graph_boundary_per_token(boundary, ubatch.n_tokens, elements_per_token, bytes_per_token)) {
+            if (!activation_boundary_observed) {
+                activation_boundary_observed = true;
+                activation_boundary_type = boundary->type;
+                activation_boundary_elements_per_token = elements_per_token;
+                activation_boundary_bytes_per_token = bytes_per_token;
+            } else if (activation_boundary_type != boundary->type ||
+                       activation_boundary_elements_per_token != elements_per_token ||
+                       activation_boundary_bytes_per_token != bytes_per_token) {
+                activation_boundary_stable = false;
+            }
+        } else {
+            activation_boundary_stable = false;
+        }
+    }
+
     this->n_outputs = save_n_outputs;
 
     // initialize scheduler with the specified graph
diff --git a/src/llama-context.h b/src/llama-context.h
index 20c121b24..9e883575f 100644

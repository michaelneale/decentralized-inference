 #include "skippy/sampling_internal.h"
 #include "skippy/speculative_internal.h"
 #include "skippy/model_loading_internal.h"
@@ -696,6 +697,58 @@ static enum skippy_status skippy_finish_model_open(
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
 
+    const auto fail_boundary_load = [&](const char * message) {
+        if (event_scope != nullptr) {
+            event_scope->emit_failure(SKIPPY_STATUS_RUNTIME_ERROR, message);
+        }
+        llama_free(stage_model->ctx);
+        stage_model->ctx = nullptr;
+        llama_model_free(model);
+        delete stage_model;
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, message);
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    };
+
+    if (config != nullptr && config->filter_tensors_on_load && !config->include_output) {
+        enum ggml_type type = GGML_TYPE_COUNT;
+        uint64_t elements_per_token = 0;
+        uint64_t bytes_per_token = 0;
+        if (!stage_model->ctx->get_activation_boundary(type, elements_per_token, bytes_per_token)) {
+            return fail_boundary_load("stage graph did not expose a stable output activation boundary");
+        }
+        stage_model->has_output_activation_boundary = true;
+        stage_model->output_activation_boundary = {
+            SKIPPY_ACTIVATION_BOUNDARY_DESC_VERSION,
+            static_cast<uint32_t>(type),
+            static_cast<uint32_t>(SKIPPY_ACTIVATION_LAYOUT_TOKEN_MAJOR),
+            0,
+            elements_per_token,
+            bytes_per_token,
+            skippy_activation_required_frame_flags(stage_model),
+            skippy_activation_required_sidebands(stage_model),
+        };
+    }
+
+    if (config != nullptr && config->filter_tensors_on_load && !config->include_embeddings) {
+        enum ggml_type type = GGML_TYPE_COUNT;
+        uint64_t elements_per_token = 0;
+        uint64_t bytes_per_token = 0;
+        if (!stage_model->ctx->get_input_activation_boundary(type, elements_per_token, bytes_per_token)) {
+            return fail_boundary_load("stage graph did not expose a stable input activation boundary");
+        }
+        stage_model->has_input_activation_boundary = true;
+        stage_model->input_activation_boundary = {
+            SKIPPY_ACTIVATION_BOUNDARY_DESC_VERSION,
+            static_cast<uint32_t>(type),
+            static_cast<uint32_t>(SKIPPY_ACTIVATION_LAYOUT_TOKEN_MAJOR),
+            0,
+            elements_per_token,
+            bytes_per_token,
+            skippy_activation_required_frame_flags(stage_model),
+            skippy_activation_required_sidebands(stage_model),
+        };
+    }
+
     if (skippy_should_create_native_mtp_sidecar(model, config)) {
         llama_context_params mtp_params = params;
         mtp_params.ctx_type = LLAMA_CONTEXT_TYPE_MTP;

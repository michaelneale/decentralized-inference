     const bool qwen4exp_activation_input = session->stage_model->model->arch == LLM_ARCH_QWEN4EXP;
-    if (qwen4exp_activation_input && token_ids == nullptr) {
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "Qwen4Exp activation input requires token-id sideband");
+    if (token_ids_required && token_ids == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation boundary requires token-id sideband");
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
     const int32_t n_embd_inp = llama_model_n_embd_inp(session->stage_model->model);
@@ -762,9 +764,11 @@ enum skippy_status skippy_verify_activation_frame(
 
     const int32_t n_tokens = static_cast<int32_t>(token_count);
     const int32_t n_embd = llama_model_n_embd(session->stage_model->model);
+    const bool token_ids_required =
+            (skippy_activation_required_sidebands(session->stage_model) & SKIPPY_ACTIVATION_SIDEBAND_TOKEN_IDS) != 0;
     const bool qwen4exp_activation_input = session->stage_model->model->arch == LLM_ARCH_QWEN4EXP;
-    if (qwen4exp_activation_input && token_ids == nullptr) {
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "Qwen4Exp verification requires token-id sideband");
+    if (token_ids_required && token_ids == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation verification requires token-id sideband");
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
     const int32_t n_altup = static_cast<int32_t>(session->stage_model->model->hparams.n_altup);
diff --git a/src/skippy/activation_internal.h b/src/skippy/activation_internal.h
index 09ca50578..6eb4a66d5 100644
--- a/src/skippy/activation_internal.h
+++ b/src/skippy/activation_internal.h
@@ -9,6 +9,7 @@
 #include <cstdint>
 
 struct skippy_session;
+struct skippy_model;
 
 bool skippy_emits_activation_frame(const skippy_session * session);
 bool skippy_is_rwkv7_activation_model(const skippy_session * session);
@@ -39,6 +40,8 @@ size_t skippy_activation_payload_bytes(
         size_t token_count,

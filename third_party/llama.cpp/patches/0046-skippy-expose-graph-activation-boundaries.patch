diff --git a/src/skippy/activation_layout.cpp b/src/skippy/activation_layout.cpp
index 57000b5d6..a40ebf8e2 100644
--- a/src/skippy/activation_layout.cpp
+++ b/src/skippy/activation_layout.cpp
@@ -384,6 +384,23 @@ bool skippy_has_activation_payload(const skippy_activation_desc * desc, const vo
     return desc != nullptr && desc->payload_bytes > 0 && payload != nullptr;
 }
 
+uint64_t skippy_activation_required_frame_flags(const skippy_model * model) {
+    if (model != nullptr && model->model != nullptr && model->model->arch == LLM_ARCH_GEMMA3N) {
+        return SKIPPY_ACTIVATION_FLAG_GEMMA3N_ALTUP;
+    }
+    return 0;
+}
+
+uint64_t skippy_activation_required_sidebands(const skippy_model * model) {
+    if (model == nullptr || model->model == nullptr) {
+        return 0;
+    }
+    if (model->model->arch == LLM_ARCH_GEMMA3N || model->model->arch == LLM_ARCH_QWEN4EXP) {
+        return SKIPPY_ACTIVATION_SIDEBAND_TOKEN_IDS;
+    }
+    return 0;
+}
+
 extern "C" {
 enum skippy_status skippy_session_copy_output_activation_frame(
         struct skippy_session * session,
diff --git a/src/skippy/model_lifecycle.cpp b/src/skippy/model_lifecycle.cpp
index 2828ffe38..4ccf2c4a2 100644
--- a/src/skippy/model_lifecycle.cpp
+++ b/src/skippy/model_lifecycle.cpp
@@ -123,5 +123,25 @@ const struct llama_model * skippy_model_llama_model(
     return model != nullptr ? model->model : nullptr;
 }
 
+bool skippy_model_output_activation_boundary(
+        const struct skippy_model * model,
+        struct skippy_activation_boundary_desc * out_desc) {
+    if (model == nullptr || out_desc == nullptr || !model->has_output_activation_boundary) {
+        return false;
+    }
+    *out_desc = model->output_activation_boundary;
+    return true;
+}
+
+bool skippy_model_input_activation_boundary(
+        const struct skippy_model * model,
+        struct skippy_activation_boundary_desc * out_desc) {
+    if (model == nullptr || out_desc == nullptr || !model->has_input_activation_boundary) {
+        return false;
+    }
+    *out_desc = model->input_activation_boundary;
+    return true;
+}
+
 
 } // extern "C"
diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index 166f2f7b7..0202e5a1c 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -51,6 +51,7 @@
 using json = nlohmann::ordered_json;
 
 #include "skippy/execution_internal.h"

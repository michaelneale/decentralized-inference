From 39da9386b2e4d75fe88fe3f392c3f8162dd0e4cc Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sat, 5 Sep 2026 02:00:59 -0400
Subject: [PATCH] skippy: add process-global runtime event reporter (bit 31)

Bumps SKIPPY_ABI_VERSION_PATCH to 53 (the one bump for this atomically
landed capability series; sibling family patches do not bump again) and
adds SKIPPY_FEATURE_RUNTIME_EVENT_REPORTER (bit 31).

Adds skippy_set_runtime_event_reporter / skippy_clear_runtime_event_reporter
installing one process-global reporter; replacing a reporter and clear()
both block until every in-flight callback from the previous reporter has
returned, so no callback into that reporter occurs after either operation
returns. Extends skippy_runtime_event_v1 with four append-only
numeric_summary fields after detail_len, under the unchanged
SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION.

Adds a private src/skippy/events_internal.h dispatch() seam shared by
every family emit entrypoint added by sibling patches, plus a new
skippy-runtime-events-test executable exercising the reporter mechanism
itself (install/dispatch/clear/quiescence/struct-size) via that seam and
the pre-existing MODEL_OPEN category, with no dependency on any one
family's own emit entrypoint.

Rebased onto main's graph-derived package-v2 queue as patches 0020-0029.
Feature bits 31-36 are unchanged.

---
 include/skippy/common.h             |  12 +-
 include/skippy/events.h             |  37 +++++
 src/CMakeLists.txt                  |  21 +++
 src/skippy/abi.cpp                  |   3 +-
 src/skippy/events.cpp               | 172 ++++++++++++++++++++
 src/skippy/events_internal.h        |  35 ++++
 src/skippy/tests/runtime_events.cpp | 238 ++++++++++++++++++++++++++++
 7 files changed, 516 insertions(+), 2 deletions(-)
 create mode 100644 src/skippy/events.cpp
 create mode 100644 src/skippy/events_internal.h
 create mode 100644 src/skippy/tests/runtime_events.cpp

diff --git a/include/skippy/common.h b/include/skippy/common.h
index b156cb5eb..98d69de67 100644
--- a/include/skippy/common.h
+++ b/include/skippy/common.h
@@ -46,7 +46,7 @@ extern "C" {
 
 #define SKIPPY_ABI_VERSION_MAJOR 0
 #define SKIPPY_ABI_VERSION_MINOR 1
-#define SKIPPY_ABI_VERSION_PATCH 52
+#define SKIPPY_ABI_VERSION_PATCH 53
 
 #if defined(_MSC_VER)
 #define SKIPPY_DEPRECATED(message) __declspec(deprecated(message))
@@ -90,6 +90,16 @@ enum skippy_feature {
     SKIPPY_FEATURE_MODEL_SOURCE            = 1 << 30,
 };
 
+// Feature bit 31 is declared as a `uint64_t` constant, not an `enum
+// skippy_feature` member: later bits in this same numbering space (32-36,
+// added by sibling capability patches) exceed the range a C11 `enum`'s
+// underlying type is portably guaranteed to hold (ISO C11 6.7.2.2p4 only
+// requires the type to represent `int`-range values). Bit 31 is kept
+// consistent with those siblings rather than split across two declaration
+// styles. `skippy_abi_features()` already returns `uint64_t`, so callers
+// combine these with the enum bits identically either way.
+#define SKIPPY_FEATURE_RUNTIME_EVENT_REPORTER ((uint64_t)1 << 31)
+
 enum skippy_status {
     SKIPPY_STATUS_OK                      = 0,
     SKIPPY_STATUS_ERROR                   = 1,
diff --git a/include/skippy/events.h b/include/skippy/events.h
index 9fee2715f..97d451269 100644
--- a/include/skippy/events.h
+++ b/include/skippy/events.h
@@ -84,6 +84,14 @@ struct skippy_runtime_event_v1 {
     uint32_t reserved1;
     const char * detail_ptr;
     uint64_t detail_len;
+
+    // Append-only extension fields. Advertised by `struct_size` under the
+    // unchanged SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION; a caller only reads a
+    // field when `struct_size` covers its offset.
+    uint64_t numeric_summary_0;
+    uint64_t numeric_summary_1;
+    uint64_t numeric_summary_2;
+    uint64_t numeric_summary_3;
 };
 
 /** @brief Callback type used by a runtime event reporter. */
@@ -99,6 +107,35 @@ struct skippy_runtime_event_reporter_v1 {
     void * user_data;
 };
 
+/**
+ * @brief Installs one process-global runtime-scoped event reporter.
+ *
+ * Requires SKIPPY_FEATURE_RUNTIME_EVENT_REPORTER. Replaces any previously
+ * installed global reporter. The per-call model-open reporter passed to a
+ * `*_with_events` entrypoint still takes precedence for
+ * SKIPPY_RUNTIME_EVENT_CATEGORY_MODEL_OPEN events during that call; the
+ * global reporter receives events published through it by any capability
+ * module (backend/device/KV/diagnostic/unload/model-load-v2, added by
+ * sibling patches) via the shared internal dispatch path.
+ *
+ * Returns SKIPPY_STATUS_INVALID_ARGUMENT if `reporter` is null or its
+ * `struct_size` is smaller than `sizeof(struct
+ * skippy_runtime_event_reporter_v1)`.
+ * When replacing an existing reporter, waits until every in-flight callback
+ * using the previous reporter has returned before installing the replacement.
+ */
+LLAMA_API enum skippy_status skippy_set_runtime_event_reporter(
+        const struct skippy_runtime_event_reporter_v1 * reporter);
+
+/**
+ * @brief Removes the process-global runtime-scoped event reporter.
+ *
+ * Returns only after every in-flight callback invocation of the previously
+ * installed reporter has returned, so no callback occurs after this call
+ * returns. Idempotent: clearing when no reporter is installed is a no-op.
+ */
+LLAMA_API void skippy_clear_runtime_event_reporter(void);
+
 #ifdef __cplusplus
 }
 #endif

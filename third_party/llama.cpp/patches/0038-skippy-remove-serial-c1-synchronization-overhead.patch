         skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "llama_decode failed for scheduler iteration");
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
+    skippy_mark_context_work_pending(first->stage_model);
 
     float * embeddings = request_embeddings ? llama_get_embeddings(first->ctx) : nullptr;
     if (request_embeddings && embeddings == nullptr) {
@@ -545,6 +546,7 @@ enum skippy_status skippy_decode_step_frame_batch_sampled(
         skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "llama_decode failed");
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
+    skippy_mark_context_work_pending(first->stage_model);
 
     float * embeddings = nullptr;
     if (skippy_emits_activation_frame(first)) {
diff --git a/src/skippy/execution-single.cpp b/src/skippy/execution-single.cpp
index 57098af41..0ce65471f 100644
--- a/src/skippy/execution-single.cpp
+++ b/src/skippy/execution-single.cpp
@@ -226,6 +226,7 @@ enum skippy_status skippy_decode_batch_sampled(
         skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "llama_decode failed");
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
+    skippy_mark_context_work_pending(first->stage_model);
     llama_batch_free(batch);
 
     for (int32_t i = 0; i < n_tokens; ++i) {
diff --git a/src/skippy/runtime_support.h b/src/skippy/runtime_support.h
index 8146f5a65..2d35f7d5f 100644
--- a/src/skippy/runtime_support.h
+++ b/src/skippy/runtime_support.h
@@ -21,6 +21,9 @@ enum skippy_status skippy_require_usable_session(
 int32_t skippy_stage_layer_count(const llama_model * model);
 int32_t skippy_claim_execution_lane(skippy_model * model);
 void skippy_release_execution_lane(skippy_model * model, int32_t seq_id);
+void skippy_mark_context_work_pending(skippy_model * model);
+void skippy_mark_context_synchronized(skippy_model * model);
+void skippy_synchronize_context_if_pending(skippy_model * model);
 bool skippy_memory_needs_verify_checkpoint(llama_memory_t memory);
 void skippy_mtp_clear_session_state(skippy_session * session);
 void skippy_clear_chat_sampling(skippy_session * session);
diff --git a/src/skippy/runtime_types.h b/src/skippy/runtime_types.h
index 51f4f71cb..2a3b87f40 100644
--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -5,6 +5,7 @@
 #include "llama-context.h"
 #include "llama-model.h"
 
+#include <atomic>
 #include <cstddef>
 #include <cstdint>
 #include <mutex>
@@ -82,6 +83,7 @@ struct skippy_model {
     llama_context * ctx = nullptr;
     llama_model * mtp_model = nullptr;
     llama_context * mtp_ctx = nullptr;
+    std::atomic<bool> context_work_pending{false};
     skippy_runtime_config config = {};
     skippy_glm_dsa_op_timing glm_dsa_timing = {};
     bool executable = true;
@@ -115,6 +116,11 @@ struct skippy_session {
     int32_t preserve_prefix_tokens = 0;
     std::vector<llama_token> token_history;
     std::vector<skippy_token_signal> signal_history;
+    std::vector<llama_pos> prefill_positions;
+    std::vector<int32_t> prefill_n_seq_ids;
+    std::vector<llama_seq_id> prefill_seq_ids;
+    std::vector<llama_seq_id *> prefill_seq_id_ptrs;
+    std::vector<int8_t> prefill_logits;
     llama_sampler * sampling_chain = nullptr;
     llama_sampler * grammar_sampler = nullptr;
     bool sampling_backend_enabled = false;
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 6fb1e1f64..a2d695de7 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -12,6 +12,7 @@
 #include <algorithm>
 #include <cmath>
 #include <cstdint>
+#include <cstring>
 #include <exception>
 #include <limits>
 #include <regex>
@@ -84,18 +85,30 @@ enum skippy_status skippy_decode_tokens(
     }
 
     const llama_pos token_start = session->n_past;
-    llama_batch batch = llama_batch_init(n_tokens, 0, 1);
-    batch.n_tokens = n_tokens;
+    session->prefill_positions.resize(token_count);
+    session->prefill_n_seq_ids.resize(token_count, 1);
+    session->prefill_seq_ids.resize(token_count, session->seq_id);
+    session->prefill_seq_id_ptrs.resize(token_count);
+    session->prefill_logits.resize(token_count, 0);
     for (int32_t i = 0; i < n_tokens; ++i) {
-        batch.token[i] = token_ids[i];
-        batch.pos[i] = session->n_past + i;
-        batch.n_seq_id[i] = 1;
-        batch.seq_id[i][0] = session->seq_id;
-        batch.logits[i] = request_logits && i == n_tokens - 1 ? 1 : 0;
-    }
+        const size_t index = static_cast<size_t>(i);
+        session->prefill_positions[index] = session->n_past + i;
+        session->prefill_n_seq_ids[index] = 1;
+        session->prefill_seq_ids[index] = session->seq_id;
+        session->prefill_seq_id_ptrs[index] = &session->prefill_seq_ids[index];
+        session->prefill_logits[index] = request_logits && i == n_tokens - 1 ? 1 : 0;
+    }
+    llama_batch batch = {
+        /*n_tokens =*/ n_tokens,
+        /*token    =*/ const_cast<llama_token *>(token_ids),
+        /*embd     =*/ nullptr,
+        /*pos      =*/ session->prefill_positions.data(),
+        /*n_seq_id =*/ session->prefill_n_seq_ids.data(),
+        /*seq_id   =*/ session->prefill_seq_id_ptrs.data(),
+        /*logits   =*/ session->prefill_logits.data(),
+    };
 
     enum skippy_status status = skippy_decode_batch(session, batch, token_count, glm_dsa_phase_hint, out_error);
-    llama_batch_free(batch);
     if (status == SKIPPY_STATUS_OK) {
         skippy_record_tokens(session, token_ids, token_count);
         status = skippy_mtp_sync_target_inputs(session, token_ids, nullptr, token_count, token_start, out_error);
@@ -392,6 +406,41 @@ static bool skippy_sampling_configs_equal(
     return true;
 }
 
+bool skippy_reuse_plain_chat_sampling(
+        skippy_session * session,
+        const skippy_sampling_config * sampling,
+        const char * metadata_json,
+        uint64_t prompt_token_count) {
+    if (session == nullptr || sampling == nullptr || metadata_json == nullptr ||
+            std::strcmp(metadata_json, "{\"grammar\":\"\"}") != 0 ||
+            session->sampling_chain == nullptr || session->grammar_sampler != nullptr ||
+            !session->sampling_config_valid || session->sampling_config.logit_bias_count != 0 ||
+            sampling->logit_bias_count != 0 ||
+            !skippy_sampling_configs_equal(session->sampling_config, *sampling)) {
+        return false;
+    }
+    llama_sampler_reset(session->sampling_chain);
+    session->chat_sampling_metadata = metadata_json;
+    session->grammar_generated_start = prompt_token_count;
+    session->sampling_accepted_token_count = 0;
+    skippy_refresh_backend_sampling(session, sampling);
+    return true;
+}
+
+bool skippy_reset_reusable_sampling(skippy_session * session) {
+    if (session == nullptr || session->sampling_chain == nullptr ||
+            session->grammar_sampler != nullptr || !session->sampling_config_valid ||
+            session->sampling_config.logit_bias_count != 0) {
+        return false;
+    }
+    llama_sampler_reset(session->sampling_chain);
+    session->chat_sampling_metadata.clear();
+    session->grammar_generated_start = 0;
+    session->sampling_accepted_token_count = 0;
+    skippy_refresh_backend_sampling(session, &session->sampling_config);
+    return true;
+}
+
 llama_sampler * skippy_build_sampling_chain(
         skippy_session * session,
         const skippy_sampling_config * sampling) {
@@ -623,9 +672,16 @@ static void skippy_sync_chat_sampling_history(skippy_session * session) {
 static llama_token skippy_chat_sample_token(skippy_session * session, int32_t logits_index) {
     skippy_sync_chat_sampling_history(session);
     if (session->sampling_backend_enabled) {
+        const llama_token sampled = llama_get_sampled_token_ith(session->ctx, logits_index);
+        skippy_mark_context_synchronized(session->stage_model);
+        if (sampled != LLAMA_TOKEN_NULL) {
+            llama_sampler_accept(session->sampling_chain, sampled);
+            return sampled;
+        }
         return llama_sampler_sample(session->sampling_chain, session->ctx, logits_index);
     }
     llama_synchronize(session->ctx);
+    skippy_mark_context_synchronized(session->stage_model);
 
     const llama_vocab * vocab = llama_model_get_vocab(session->stage_model->model);
     const int32_t n_vocab = llama_vocab_n_tokens(vocab);
diff --git a/src/skippy/sampling_internal.h b/src/skippy/sampling_internal.h
index 768ccb350..9f819704f 100644
--- a/src/skippy/sampling_internal.h
+++ b/src/skippy/sampling_internal.h
@@ -32,6 +32,12 @@ llama_token skippy_greedy_sample_context(const llama_model * model, llama_contex
 llama_token skippy_greedy_sample_ith(skippy_session * session, int32_t index);
 llama_sampler * skippy_build_sampling_chain(skippy_session * session, const skippy_sampling_config * sampling);
 void skippy_refresh_backend_sampling(skippy_session * session, const skippy_sampling_config * sampling);
+bool skippy_reuse_plain_chat_sampling(
+        skippy_session * session,
+        const skippy_sampling_config * sampling,
+        const char * metadata_json,
+        uint64_t prompt_token_count);
+bool skippy_reset_reusable_sampling(skippy_session * session);
 bool skippy_init_chat_grammar_sampler(
         skippy_session * session,
         const nlohmann::ordered_json & metadata,
diff --git a/src/skippy/session.cpp b/src/skippy/session.cpp
index ef1ff64ac..aae665f53 100644
--- a/src/skippy/session.cpp
+++ b/src/skippy/session.cpp
@@ -115,6 +115,24 @@ void skippy_release_execution_lane(skippy_model * model, int32_t seq_id) {
     }
 }
 
+void skippy_mark_context_work_pending(skippy_model * model) {
+    if (model != nullptr) {
+        model->context_work_pending.store(true, std::memory_order_release);
+    }
+}
+
+void skippy_mark_context_synchronized(skippy_model * model) {
+    if (model != nullptr) {
+        model->context_work_pending.store(false, std::memory_order_release);
+    }
+}
+
+void skippy_synchronize_context_if_pending(skippy_model * model) {
+    if (model != nullptr && model->ctx != nullptr &&
+            model->context_work_pending.exchange(false, std::memory_order_acq_rel)) {
+        model->ctx->synchronize();
+    }
+}
 
 extern "C" {
 enum skippy_status skippy_session_create(
@@ -209,6 +227,7 @@ enum skippy_status skippy_session_end_external_decode(
     if (g_skippy_external_decode_session == session) {
         g_skippy_external_decode_session = nullptr;
     }
+    skippy_mark_context_work_pending(session->stage_model);
     skippy_graph_clear_filter();
     return skippy_success(out_error);
 }
@@ -265,6 +284,10 @@ enum skippy_status skippy_session_configure_chat_sampling(
         skippy_clear_chat_sampling(session);
         return skippy_success(out_error);
     }
+    if (skippy_reuse_plain_chat_sampling(
+            session, sampling, metadata_json, prompt_token_count)) {
+        return skippy_success(out_error);
+    }
 
     try {
         json metadata = json::parse(metadata_json);
@@ -304,7 +327,7 @@ enum skippy_status skippy_session_reset(
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
 
-    session->ctx->synchronize();
+    skippy_synchronize_context_if_pending(session->stage_model);
     llama_memory_t memory = session->ctx->get_memory();
     if (memory == nullptr) {
         skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "runtime memory is unavailable");
@@ -327,11 +350,12 @@ enum skippy_status skippy_session_reset(
         session->token_history.clear();
     }
     session->signal_history.clear();
-    skippy_clear_chat_sampling(session);
+    if (!skippy_reset_reusable_sampling(session)) {
+        skippy_clear_chat_sampling(session);
+    }
     skippy_mtp_clear_session_state(session);
     session->reset_required = false;
     session->verify_checkpoints.clear();
-    session->ctx->synchronize();
     return skippy_success(out_error);
 }
 
@@ -344,7 +368,7 @@ enum skippy_status skippy_session_free(
         }
         if (session->ctx != nullptr) {
             if (session->preserve_prefix_on_free && !session->borrowed_sequence && session->stage_model != nullptr) {
-                session->ctx->synchronize();
+                skippy_synchronize_context_if_pending(session->stage_model);
                 if (llama_memory_t memory = session->ctx->get_memory()) {
                     llama_memory_seq_rm(
                             memory,
@@ -352,7 +376,6 @@ enum skippy_status skippy_session_free(
                             static_cast<llama_pos>(session->preserve_prefix_tokens),
                             -1);
                 }
-                session->ctx->synchronize();
             } else {
                 skippy_session_reset(session, nullptr);
                 if (!session->borrowed_sequence && session->stage_model != nullptr && session->seq_id >= 0) {
diff --git a/src/skippy/state.cpp b/src/skippy/state.cpp
index 3a8763869..a2292fef8 100644
--- a/src/skippy/state.cpp
+++ b/src/skippy/state.cpp
@@ -840,7 +840,7 @@ enum skippy_status skippy_session_save_prefix(
         return status;
     }
 
-    session->ctx->synchronize();
+    skippy_synchronize_context_if_pending(session->stage_model);
     llama_memory_seq_rm(memory, cache_seq_id, -1, -1);
     if (token_count > 0) {
         llama_memory_seq_cp(memory, session->seq_id, cache_seq_id, 0, static_cast<llama_pos>(token_count));
@@ -885,7 +885,7 @@ enum skippy_status skippy_session_restore_prefix(
         return status;
     }
 
-    session->ctx->synchronize();
+    skippy_synchronize_context_if_pending(session->stage_model);
     if (token_count > 0) {
         const llama_pos max_pos = llama_memory_seq_pos_max(memory, cache_seq_id);
         if (max_pos < static_cast<llama_pos>(token_count - 1)) {
@@ -954,7 +954,7 @@ enum skippy_status skippy_session_create_from_resident_prefix(
         return status;
     }
 
-    model->ctx->synchronize();
+    skippy_synchronize_context_if_pending(model);
     if (token_count > 0) {
         const llama_pos max_pos = llama_memory_seq_pos_max(memory, cache_seq_id);
         if (max_pos < static_cast<llama_pos>(token_count - 1)) {
@@ -1015,7 +1015,7 @@ enum skippy_status skippy_session_drop_sequence(
     if (status != SKIPPY_STATUS_OK) {
         return status;
     }
-    session->ctx->synchronize();
+    skippy_synchronize_context_if_pending(session->stage_model);
     llama_memory_seq_rm(memory, seq_id, -1, -1);
     return skippy_success(out_error);
 }

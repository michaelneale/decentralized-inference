From 691cb63a2f0c537edb5296e8ed353e9a2442d260 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sat, 29 Aug 2026 10:28:15 +1000
Subject: [PATCH 32/56] skippy: cache chat templates for model lifetime

---
 common/stage-chat.cpp          | 44 ++++++++++++++++++++++++++++++++--
 src/skippy/model_lifecycle.cpp |  3 +++
 src/skippy/runtime_types.h     |  3 +++
 src/skippy/tokenization.cpp    | 35 +++++++++++++++++++++++++++
 4 files changed, 83 insertions(+), 2 deletions(-)

diff --git a/common/stage-chat.cpp b/common/stage-chat.cpp
index 8aa563bef..02492ad81 100644
--- a/common/stage-chat.cpp
+++ b/common/stage-chat.cpp
@@ -12,6 +12,38 @@
 
 using json = common_json;
 
+using skippy_chat_templates_create_fn = void * (*)(const llama_model * model);
+using skippy_chat_templates_free_fn = void (*)(void * templates);
+
+extern "C" LLAMA_API void * skippy_model_chat_templates_get_or_init(
+        struct skippy_model * model,
+        skippy_chat_templates_create_fn create,
+        skippy_chat_templates_free_fn free_templates);
+extern "C" LLAMA_API void skippy_model_chat_templates_lock(struct skippy_model * model);
+extern "C" LLAMA_API void skippy_model_chat_templates_unlock(struct skippy_model * model);
+
+class skippy_chat_templates_lock_guard {
+public:
+    explicit skippy_chat_templates_lock_guard(skippy_model * model) : model(model) {
+        skippy_model_chat_templates_lock(model);
+    }
+
+    ~skippy_chat_templates_lock_guard() {
+        skippy_model_chat_templates_unlock(model);
+    }
+
+private:
+    skippy_model * model;
+};
+
+static void * skippy_common_chat_templates_create(const llama_model * model) {
+    return common_chat_templates_init(model, "").release();
+}
+
+static void skippy_common_chat_templates_free(void * templates) {
+    common_chat_templates_free(static_cast<common_chat_templates *>(templates));
+}
+
 static skippy_error * skippy_common_make_error(enum skippy_status status, const char * message) {
     skippy_error * error = new skippy_error{};
     error->status = status;
@@ -212,8 +244,16 @@ enum skippy_status skippy_apply_chat_template_json(
             inputs.chat_template_kwargs["reasoning_effort"] = "0";
         }
 
-        common_chat_templates_ptr tmpls = common_chat_templates_init(native_model, "");
-        common_chat_params params = common_chat_templates_apply(tmpls.get(), inputs);
+        common_chat_templates * tmpls = static_cast<common_chat_templates *>(
+                skippy_model_chat_templates_get_or_init(
+                    model,
+                    skippy_common_chat_templates_create,
+                    skippy_common_chat_templates_free));
+        if (tmpls == nullptr) {
+            throw std::runtime_error("failed to initialize model chat templates");
+        }
+        skippy_chat_templates_lock_guard templates_lock(model);
+        common_chat_params params = common_chat_templates_apply(tmpls, inputs);
         prompt = params.prompt;
 
         const bool parse_tool_calls = !inputs.tools.empty() && inputs.tool_choice != COMMON_CHAT_TOOL_CHOICE_NONE;
diff --git a/src/skippy/model_lifecycle.cpp b/src/skippy/model_lifecycle.cpp
index f46335ba7..2828ffe38 100644
--- a/src/skippy/model_lifecycle.cpp
+++ b/src/skippy/model_lifecycle.cpp
@@ -109,6 +109,9 @@ enum skippy_status skippy_model_free(
         if (model->ctx != nullptr) {
             llama_free(model->ctx);
         }
+        if (model->chat_templates != nullptr && model->chat_templates_free != nullptr) {
+            model->chat_templates_free(model->chat_templates);
+        }
         llama_model_free(model->model);
         delete model;
     }
diff --git a/src/skippy/runtime_types.h b/src/skippy/runtime_types.h
index ff8024a5f..f83801c97 100644
--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -89,6 +89,9 @@ struct skippy_model {
     std::mutex lane_mutex;
     std::vector<bool> lane_in_use;
     std::vector<std::vector<llama_token>> lane_resident_prefix_tokens;
+    std::mutex chat_templates_mutex;
+    void * chat_templates = nullptr;
+    void (*chat_templates_free)(void *) = nullptr;
 };
 
 struct skippy_verify_checkpoint {
diff --git a/src/skippy/tokenization.cpp b/src/skippy/tokenization.cpp
index 89d69ff3a..386ad3f24 100644
--- a/src/skippy/tokenization.cpp
+++ b/src/skippy/tokenization.cpp
@@ -6,9 +6,44 @@
 
 #include <cstring>
 #include <limits>
+#include <mutex>
 #include <string>
 #include <vector>
 
+using skippy_chat_templates_create_fn = void * (*)(const llama_model * model);
+using skippy_chat_templates_free_fn = void (*)(void * templates);
+
+extern "C" LLAMA_API void * skippy_model_chat_templates_get_or_init(
+        struct skippy_model * model,
+        skippy_chat_templates_create_fn create,
+        skippy_chat_templates_free_fn free_templates) {
+    if (model == nullptr || model->model == nullptr || create == nullptr || free_templates == nullptr) {
+        return nullptr;
+    }
+
+    std::lock_guard<std::mutex> lock(model->chat_templates_mutex);
+    if (model->chat_templates == nullptr) {
+        model->chat_templates = create(model->model);
+        if (model->chat_templates == nullptr) {
+            return nullptr;
+        }
+        model->chat_templates_free = free_templates;
+    }
+    return model->chat_templates;
+}
+
+extern "C" LLAMA_API void skippy_model_chat_templates_lock(struct skippy_model * model) {
+    if (model != nullptr) {
+        model->chat_templates_mutex.lock();
+    }
+}
+
+extern "C" LLAMA_API void skippy_model_chat_templates_unlock(struct skippy_model * model) {
+    if (model != nullptr) {
+        model->chat_templates_mutex.unlock();
+    }
+}
+
 extern "C" {
 
 enum skippy_status skippy_tokenize(
-- 
2.55.0


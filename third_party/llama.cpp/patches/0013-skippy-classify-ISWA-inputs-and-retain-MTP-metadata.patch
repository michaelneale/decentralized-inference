diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index cf82e3925..05145d9f7 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1772,6 +1772,52 @@ void llm_graph_context::request_inputs(llm_graph_input_attn_k * input) const {
     request_input(input->self_kq_mask, "attention.mask");
 }
 
+void llm_graph_context::request_inputs(llm_graph_input_attn_kv_iswa * input) const {
+    request_input(input->self_k_idxs, "attention.base.key_indices");
+    request_input(input->self_v_idxs, "attention.base.value_indices");
+    request_input(input->self_kq_mask, "attention.base.mask");
+    request_input(input->self_k_rot, "attention.base.key_rotation");
+    request_input(input->self_v_rot, "attention.base.value_rotation");
+    request_input(input->self_k_idxs_swa, "attention.swa.key_indices");
+    request_input(input->self_v_idxs_swa, "attention.swa.value_indices");
+    request_input(input->self_kq_mask_swa, "attention.swa.mask");
+    request_input(input->self_k_rot_swa, "attention.swa.key_rotation");
+    request_input(input->self_v_rot_swa, "attention.swa.value_rotation");
+}
+
+void llm_graph_context::request_inputs(llm_graph_input_attn_k_iswa * input) const {
+    request_input(input->self_k_idxs, "attention.base.key_indices");
+    request_input(input->self_kq_mask, "attention.base.mask");
+    request_input(input->self_k_rot, "attention.base.key_rotation");
+    request_input(input->self_k_idxs_swa, "attention.swa.key_indices");
+    request_input(input->self_kq_mask_swa, "attention.swa.mask");
+    request_input(input->self_k_rot_swa, "attention.swa.key_rotation");
+}
+
+void llm_graph_context::request_inputs(llm_graph_input_attn_k_dsa * input) const {
+    request_input(input->self_k_idxs_mla, "attention.dsa.mla.key_indices");
+    request_input(input->self_k_idxs_lid, "attention.dsa.indexer.key_indices");
+    request_input(input->self_kq_mask_mla, "attention.dsa.mla.mask");
+    request_input(input->self_kq_mask_lid, "attention.dsa.indexer.mask");
+    request_input(input->self_k_rot_lid, "attention.dsa.indexer.key_rotation");
+}
+
+void llm_graph_context::request_inputs(llm_graph_input_attn_k_dsa_iswa * input) const {
+    request_inputs(input->get_dsa());
+    request_input(input->get_swa()->self_k_idxs, "attention.swa.key_indices");
+    request_input(input->get_swa()->self_kq_mask, "attention.swa.mask");
+}
+
+void llm_graph_context::request_inputs(llm_graph_input_attn_kv_msa * input) const {
+    request_inputs(static_cast<llm_graph_input_attn_kv *>(input));
+    request_input(input->self_k_idxs_idx, "attention.msa.indexer.key_indices");
+}
+
+void llm_graph_context::request_inputs(llm_graph_input_mem_hybrid_iswa * input) const {
+    request_inputs(input->get_attn());
+    request_inputs(input->get_recr());
+}
+
 void llm_graph_context::request_inputs(llm_graph_input_rs * input) const {
     request_input(input->s_copy, "recurrent.copy_indices");
 }
@@ -3482,13 +3528,17 @@ ggml_tensor * llm_graph_context::build_attn(
     if (k_cur) {
         const auto & k_idxs = is_swa ? inp->get_k_idxs_swa() : inp->get_k_idxs();
 
-        ggml_build_forward_expand(gf, mctx_cur->cpy_k(ctx0, k_cur, k_idxs, il));
+        ggml_tensor * k_write = mctx_cur->cpy_k(ctx0, k_cur, k_idxs, il);
+        ggml_build_forward_expand(gf, k_write);
+        state_write(skippy_state_kind::kv_key, k_write, k_write, il);
     }
 
     if (v_cur) {
         const auto & v_idxs = is_swa ? inp->get_v_idxs_swa() : inp->get_v_idxs();
 
-        ggml_build_forward_expand(gf, mctx_cur->cpy_v(ctx0, v_cur, v_idxs, il));
+        ggml_tensor * v_write = mctx_cur->cpy_v(ctx0, v_cur, v_idxs, il);
+        ggml_build_forward_expand(gf, v_write);
+        state_write(skippy_state_kind::kv_value, v_write, v_write, il);
     }
 
     const auto & kq_mask = is_swa ? inp->get_kq_mask_swa() : inp->get_kq_mask();
@@ -3497,6 +3547,9 @@ ggml_tensor * llm_graph_context::build_attn(
     ggml_tensor * k = mctx_cur->get_k(ctx0, il);
     ggml_tensor * v = mctx_cur->get_v(ctx0, il);
 
+    state_read(skippy_state_kind::kv_key,   k, il);
+    state_read(skippy_state_kind::kv_value, v, il);
+
     ggml_tensor * cur = build_attn_mha(q, k, v, kq_b, kq_mask, sinks, v_mla, 0, kq_scale, il);
     cb(cur, "kqv_out", il);
 
@@ -3558,7 +3611,9 @@ ggml_tensor * llm_graph_context::build_attn(
     if (k_cur) {
         const auto & k_idxs = is_swa ? inp->get_k_idxs_swa() : inp->get_k_idxs();
 
-        ggml_build_forward_expand(gf, mctx_cur->cpy_k(ctx0, k_cur, k_idxs, il));
+        ggml_tensor * k_write = mctx_cur->cpy_k(ctx0, k_cur, k_idxs, il);
+        ggml_build_forward_expand(gf, k_write);
+        state_write(skippy_state_kind::kv_key, k_write, k_write, il);
     }
 
     const auto & kq_mask = is_swa ? inp->get_kq_mask_swa() : inp->get_kq_mask();
@@ -3568,6 +3623,8 @@ ggml_tensor * llm_graph_context::build_attn(
     ggml_tensor * k = mctx_cur->get_k(ctx0, il);
     ggml_tensor * v = ggml_view_4d(ctx0, k, v_cur->ne[0], k->ne[1], k->ne[2], k->ne[3], k->nb[1], k->nb[2], k->nb[3], 0);
 
+    state_read(skippy_state_kind::kv_key, k, il);
+
     ggml_tensor * cur = build_attn_mha(q, k, v, kq_b, kq_mask, sinks, v_mla, 0, kq_scale, il);
     cb(cur, "kqv_out", il);
 
@@ -3682,6 +3739,8 @@ llm_graph_input_attn_k_dsa * llm_graph_context::build_attn_inp_k_dsa() const {
 
     auto inp = build_attn_inp_k_dsa_impl(ctx0, ubatch, hparams, cparams, mctx_cur);
 
+    request_inputs(inp.get());
+
     return (llm_graph_input_attn_k_dsa *) res->add_input(std::move(inp));
 }
 
@@ -3699,6 +3758,7 @@ llm_graph_input_attn_k_dsa_iswa * llm_graph_context::build_attn_inp_k_dsa_iswa()
     inp_swa->self_kq_mask_cnv = inp_swa->self_kq_mask;
 
     auto inp = std::make_unique<llm_graph_input_attn_k_dsa_iswa>(std::move(inp_dsa), std::move(inp_swa), mctx_cur);
+    request_inputs(inp.get());
 
     return (llm_graph_input_attn_k_dsa_iswa *) res->add_input(std::move(inp));
 }
@@ -3728,6 +3788,8 @@ llm_graph_input_attn_kv_msa * llm_graph_context::build_attn_inp_kv_msa(bool msa_
         inp->self_k_idxs_idx = mctx_idx->build_input_k_idxs(ctx0, ubatch);
     }
 
+    request_inputs(inp.get());
+
     return (llm_graph_input_attn_kv_msa *) res->add_input(std::move(inp));
 }
 
@@ -3763,6 +3825,8 @@ llm_graph_input_attn_kv_iswa * llm_graph_context::build_attn_inp_kv_iswa() const
     inp->self_k_rot_swa = mctx_cur->get_swa()->build_input_k_rot(ctx0);
     inp->self_v_rot_swa = mctx_cur->get_swa()->build_input_v_rot(ctx0);
 
+    request_inputs(inp.get());
+
     return (llm_graph_input_attn_kv_iswa *) res->add_input(std::move(inp));
 }
 
@@ -3791,6 +3855,8 @@ llm_graph_input_attn_k_iswa * llm_graph_context::build_attn_inp_k_iswa() const {
 
     inp->self_k_rot_swa = mctx_cur->get_swa()->build_input_k_rot(ctx0);
 
+    request_inputs(inp.get());
+
     return (llm_graph_input_attn_k_iswa *) res->add_input(std::move(inp));
 }
 
@@ -4035,6 +4101,7 @@ llm_graph_input_mem_hybrid_iswa * llm_graph_context::build_inp_mem_hybrid_iswa()
     }
 
     auto inp = std::make_unique<llm_graph_input_mem_hybrid_iswa>(cparams, std::move(inp_attn), std::move(inp_rs), mctx_cur);
+    request_inputs(inp.get());
 
     return (llm_graph_input_mem_hybrid_iswa *) res->add_input(std::move(inp));
 }

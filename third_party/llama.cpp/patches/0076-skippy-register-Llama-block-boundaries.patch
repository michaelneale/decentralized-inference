Subject: [PATCH] skippy: register Llama block boundaries

---
 src/models/llama.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/models/llama.cpp b/src/models/llama.cpp
index 77658a81e..fc376ccce 100644
--- a/src/models/llama.cpp
+++ b/src/models/llama.cpp
@@ -129,6 +129,8 @@ llama_model_llama::graph<embed>::graph(const llama_model & model, const llm_grap
     ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -228,6 +230,8 @@ llama_model_llama::graph<embed>::graph(const llama_model & model, const llm_grap
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
 
+        end_block(cur, il);
+
         // input for next layer
         inpL = cur;
     }

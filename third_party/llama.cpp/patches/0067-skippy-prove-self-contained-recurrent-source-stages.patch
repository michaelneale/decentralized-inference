From cd99c9fcf7527674f6537aee257fd76ad590d648 Mon Sep 17 00:00:00 2001
From: Galadriel
 <b81c841ed20a8e17caf4e6fac2f6f3bc61d304c84b8394720f6d00f37538c47e@meshllm.communities.buzz.xyz>
Date: Sat, 5 Sep 2026 20:22:22 +1000
Subject: [PATCH] skippy: prove self-contained recurrent source stages

---
 src/CMakeLists.txt                          | 18 +++++
 src/models/mamba.cpp                        |  4 +
 src/skippy/tests/noalloc_graph_planning.cpp | 90 +++++++++++++++++----
 3 files changed, 95 insertions(+), 17 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 5572cfce9..a323bff2f 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -203,6 +203,24 @@ if (LLAMA_STAGE_BUILD_TESTS)
             2)
     set_tests_properties(skippy_noalloc_graph_planning_recurrent_rollback PROPERTIES
         FIXTURES_REQUIRED skippy-noalloc-nemotron-h-fixture)
+
+    add_test(
+        NAME skippy_generate_mamba2_fixture
+        COMMAND skippy-model-fixture-generator
+            --arch mamba2
+            --seed 1
+            --out "${SKIPPY_MODEL_FIXTURE_DIR}")
+    set_tests_properties(skippy_generate_mamba2_fixture PROPERTIES
+        FIXTURES_SETUP skippy-noalloc-mamba2-fixture)
+
+    add_test(
+        NAME skippy_noalloc_graph_planning_recurrent_source
+        COMMAND skippy-noalloc-graph-planning
+            "${SKIPPY_MODEL_FIXTURE_DIR}/mamba2-dense.gguf"
+            1
+            "recurrent,recurrent")
+    set_tests_properties(skippy_noalloc_graph_planning_recurrent_source PROPERTIES
+        FIXTURES_REQUIRED skippy-noalloc-mamba2-fixture)
 endif()
 
 if (BUILD_SHARED_LIBS)
diff --git a/src/models/mamba.cpp b/src/models/mamba.cpp
index 99e2c825e..50d4523f0 100644
--- a/src/models/mamba.cpp
+++ b/src/models/mamba.cpp
@@ -101,6 +101,8 @@ llama_model_mamba::graph::graph(const llama_model & model, const llm_graph_param
     ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     for (int il = il_start; il < il_end; ++il) {
+        begin_block(inpL, il);
+
         // norm
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
         cb(cur, "attn_norm", il);
@@ -122,6 +124,8 @@ llama_model_mamba::graph::graph(const llama_model & model, const llm_graph_param
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
 
+        end_block(cur, il);
+
         // input for next layer
         inpL = cur;
     }
diff --git a/src/skippy/tests/noalloc_graph_planning.cpp b/src/skippy/tests/noalloc_graph_planning.cpp
index 04064fbf2..b8807005b 100644
--- a/src/skippy/tests/noalloc_graph_planning.cpp
+++ b/src/skippy/tests/noalloc_graph_planning.cpp
@@ -17,6 +17,7 @@
 #include <cstdio>
 #include <cstdlib>
 #include <string>
+#include <unordered_set>
 #include <vector>
 
 static bool is_dummy_buffer(const ggml_tensor * tensor) {
@@ -215,8 +216,10 @@ static bool check_stage_slices(
     const int32_t n_layer = llama_model_n_layer(model);
     std::vector<std::string> selected_dependencies;
     std::vector<skippy_guarded_stage_slice_plan> stage_plans;
-    bool has_recurrent_layer = false;
+    bool has_downstream_recurrent_layer = false;
     bool proved_noncontiguous_recurrent_slice = false;
+    bool proved_self_contained_recurrent_source = false;
+    const bool recurrent_layer0 = model->hparams.is_recr(0);
     for (int32_t layer = 0; layer < n_layer; ++layer) {
         const skippy_execution_profile_guard guard = {
             n_tokens,
@@ -276,23 +279,71 @@ static bool check_stage_slices(
                     profile_name, layer);
             return false;
         }
-        if (layer > 0 && model->hparams.is_recr(layer)) {
-            has_recurrent_layer = true;
-            const ggml_tensor * entry = graph_result->get_block_boundaries()[2 * layer].tensor;
-            int32_t entry_index = -1;
-            for (int32_t index = 0; index < ggml_graph_n_nodes(graph); ++index) {
-                if (ggml_graph_node(graph, index) == entry) {
-                    entry_index = index;
-                    break;
+        if (model->hparams.is_recr(layer)) {
+            if (layer > 0) {
+                has_downstream_recurrent_layer = true;
+                // every recurrent stage that has an upstream stage must claim
+                // its pre-entry auxiliary cone
+                const ggml_tensor * entry = graph_result->get_block_boundaries()[2 * layer].tensor;
+                int32_t entry_index = -1;
+                for (int32_t index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+                    if (ggml_graph_node(graph, index) == entry) {
+                        entry_index = index;
+                        break;
+                    }
                 }
+                if (entry_index < 0 || selection.node_indices.front() >= entry_index) {
+                    std::fprintf(stderr,
+                            "metadata-only %s recurrent layer %d slice omitted its pre-entry auxiliary cone\n",
+                            profile_name, layer);
+                    return false;
+                }
+                proved_noncontiguous_recurrent_slice = true;
+            } else {
+                // a recurrent source stage has no upstream stage to import the
+                // cone from: it must be self-contained and own its state effects
+                if (!selection.activation_imports.empty()) {
+                    std::fprintf(stderr,
+                            "metadata-only %s recurrent layer 0 slice imports an activation\n",
+                            profile_name);
+                    return false;
+                }
+                if (selection.request_inputs.empty()) {
+                    std::fprintf(stderr,
+                            "metadata-only %s recurrent layer 0 slice has no request input\n",
+                            profile_name);
+                    return false;
+                }
+                std::unordered_set<int32_t> selected(
+                        selection.node_indices.begin(), selection.node_indices.end());
+                size_t write_effects = 0;
+                for (const auto & effect : selection.state_effects) {
+                    if (effect.layer != 0 || effect.access != skippy_state_access::write) {
+                        continue;
+                    }
+                    ++write_effects;
+                    int32_t effect_index = -1;
+                    for (int32_t index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+                        if (ggml_graph_node(graph, index) == effect.effect_node) {
+                            effect_index = index;
+                            break;
+                        }
+                    }
+                    if (effect_index < 0 || selected.find(effect_index) == selected.end()) {
+                        std::fprintf(stderr,
+                                "metadata-only %s recurrent layer 0 slice does not own a state write node\n",
+                                profile_name);
+                        return false;
+                    }
+                }
+                if (write_effects == 0) {
+                    std::fprintf(stderr,
+                            "metadata-only %s recurrent layer 0 slice carries no state write effects\n",
+                            profile_name);
+                    return false;
+                }
+                proved_self_contained_recurrent_source = true;
             }
-            if (entry_index < 0 || selection.node_indices.front() >= entry_index) {
-                std::fprintf(stderr,
-                        "metadata-only %s recurrent layer %d slice omitted its pre-entry auxiliary cone\n",
-                        profile_name, layer);
-                return false;
-            }
-            proved_noncontiguous_recurrent_slice = true;
         }
         selected_dependencies.insert(
                 selected_dependencies.end(),
@@ -332,11 +383,16 @@ static bool check_stage_slices(
                 profile_name);
         return false;
     }
-    if (has_recurrent_layer && !proved_noncontiguous_recurrent_slice) {
+    if (has_downstream_recurrent_layer && !proved_noncontiguous_recurrent_slice) {
         std::fprintf(stderr, "metadata-only %s did not prove a non-contiguous recurrent slice\n",
                 profile_name);
         return false;
     }
+    if (recurrent_layer0 && !proved_self_contained_recurrent_source) {
+        std::fprintf(stderr, "metadata-only %s did not prove a self-contained recurrent source stage\n",
+                profile_name);
+        return false;
+    }
     return true;
 }
 
-- 
2.54.0


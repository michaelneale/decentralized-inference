From ec35f9ab5952ae028a5010b24387f2e772e47cf3 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 27 Aug 2026 04:30:00 +0000
Subject: [PATCH 27/56] skippy: vectorize greedy sampling on Apple

---
 src/CMakeLists.txt      |  5 +++++
 src/skippy/sampling.cpp | 20 ++++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index ca62cfd96..e3bf733af 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -82,3 +82,8 @@ if (BUILD_SHARED_LIBS)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
     target_compile_definitions(llama PUBLIC  LLAMA_SHARED)
 endif()
+if (APPLE)
+    find_library(SKIPPY_ACCELERATE_FRAMEWORK Accelerate REQUIRED)
+    target_link_libraries(llama PRIVATE ${SKIPPY_ACCELERATE_FRAMEWORK})
+endif()
+
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 1e342060c..0538678f0 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -19,6 +19,10 @@
 #include <utility>
 #include <vector>
 
+#if defined(__APPLE__)
+#include <Accelerate/Accelerate.h>
+#endif
+
 using json = nlohmann::ordered_json;
 
 void skippy_record_tokens(
@@ -159,6 +163,22 @@ static llama_token skippy_greedy_sample_context_with_eog_policy(
         return 0;
     }
 
+#if defined(__APPLE__)
+    // Accelerate preserves the scalar path's first-index tie behavior while
+    // avoiding a branch-heavy full-vocabulary scan on every generated row.
+    float accelerated_best_logit = -std::numeric_limits<float>::infinity();
+    vDSP_Length best_index = 0;
+    vDSP_maxvi(
+            logits,
+            1,
+            &accelerated_best_logit,
+            &best_index,
+            static_cast<vDSP_Length>(n_vocab));
+    if (!ignore_eog || !llama_vocab_is_eog(vocab, static_cast<llama_token>(best_index))) {
+        return static_cast<llama_token>(best_index);
+    }
+#endif
+
     llama_token best = 0;
     float best_logit = -std::numeric_limits<float>::infinity();
     for (int32_t token = 0; token < n_vocab; ++token) {
-- 
2.55.0


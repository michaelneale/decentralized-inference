+            previous_position = write.second;
+        }
+    }
+
+    for (const auto & node_position : graph_positions) {
+        const ggml_tensor * node = node_position.first;
+        if (node->op != GGML_OP_CPY && node->op != GGML_OP_SET_ROWS && node->op != GGML_OP_SCALE) {

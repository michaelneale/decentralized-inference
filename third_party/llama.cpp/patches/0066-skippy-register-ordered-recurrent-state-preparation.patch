-        if (effect.storage->view_src != nullptr) {
-            error = effect_error("state effect %zu storage is a view, not canonical", i);
+        const owner key = {static_cast<int32_t>(effect.kind), effect.layer, effect.storage};
+        const auto inserted = storage_owners.emplace(effect.storage, key);
+        if (!inserted.second && inserted.first->second != key) {
+            error = effect_error("state effect %zu conflicts with another storage owner", i);
             return false;
         }
         if (effect.access == skippy_state_access::read) {
-            if (!seen_reads.insert({static_cast<int32_t>(effect.kind), effect.layer}).second) {
-                error = effect_error("state effect %zu duplicates a (kind, layer) read owner", i);
+            if (effect.effect_node != nullptr || effect.write_ordinal != -1 ||
+                    !seen_reads.insert({static_cast<int32_t>(effect.kind), effect.layer}).second) {
+                error = effect_error("state effect %zu has an invalid or duplicate read owner", i);
                 return false;
             }
-            reads.insert({static_cast<int32_t>(effect.kind), effect.layer, effect.storage});
+            reads.insert(key);
         } else {
-            if (effect.effect_node == nullptr) {
-                error = effect_error("state effect %zu write has no ordered effect node", i);
-                return false;
-            }
-            if (graph_nodes.find(effect.effect_node) == graph_nodes.end()) {
-                error = effect_error("state effect %zu write node is not in the exact graph", i);
+            const auto position = graph_positions.find(effect.effect_node);
+            if (position == graph_positions.end() || !(effect.effect_node->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+                error = effect_error("state effect %zu write node is not executable in the exact graph", i);
                 return false;
             }
             if (!seen_write_nodes.insert(effect.effect_node).second) {
                 error = effect_error("state effect %zu duplicates an exact write node", i);
                 return false;
             }
+            if (!valid_write_destination(effect.effect_node, effect.storage)) {
+                error = effect_error("state effect %zu has an unsupported write or invalid destination", i);
+                return false;

+++ b/src/skippy/tests/renamed_multishard_planning.cpp
@@ -0,0 +1,564 @@
+#include "ggml-backend.h"
+#include "ggml.h"
+#include "gguf.h"
+#include "llama-context.h"
+#include "llama-kv-cache.h"
+#include "llama-memory-hybrid.h"

From ec7e7fb64228a0844170e05452e9a3874c6d3d9c Mon Sep 17 00:00:00 2001
From: Michael Neale <14976+michaelneale@users.noreply.github.com>
Date: Tue, 18 Aug 2026 16:44:10 +1000
Subject: [PATCH 14/56] skippy: roll back bounded verify windows in place

Recurrent memory supports bounded in-place rollback through the RS
snapshot index, but the verify window copied the whole sequence state to
host memory before every batched verify, and replayed accepted tokens
serially on partial accept. Skip both when the span fits inside
n_rs_seq. Staged sessions keep the checkpoint: they roll back across
hosts, where an in-process RS index is not a usable restore point.
---
 src/skippy/activation.cpp    | 26 ++++++++++++++++++++++++++
 src/skippy/runtime_support.h |  3 +++
 src/skippy/state.cpp         |  5 +++++
 3 files changed, 34 insertions(+)

diff --git a/src/skippy/activation.cpp b/src/skippy/activation.cpp
index 4b208cd4b..2e85acf51 100644
--- a/src/skippy/activation.cpp
+++ b/src/skippy/activation.cpp
@@ -64,6 +64,29 @@ bool skippy_memory_needs_verify_checkpoint(llama_memory_t memory) {
            dynamic_cast<llama_memory_recurrent *>(memory) != nullptr;
 }
 
+// Recurrent memory can roll a bounded number of trailing positions back in
+// place: the RS cache is widened to (1 + n_rs_seq) snapshot groups and
+// llama_memory_recurrent::seq_rm rewinds via set_rs_idx when the rollback fits
+// inside that bound. When it does, copying the whole sequence state to host
+// memory before every verify is pure overhead, and the seq_rm path in
+// skippy_trim_session restores the accepted prefix exactly - without the
+// serial replay of accepted tokens that the checkpoint restore path performs.
+//
+// Staged sessions are excluded: they roll back across hosts, where an
+// in-process RS index is not a usable restore point.
+bool skippy_verify_window_can_roll_back_in_place(
+        const skippy_session * session,
+        size_t token_count) {
+    if (session == nullptr || session->ctx == nullptr || skippy_is_filtered(session)) {
+        return false;
+    }
+    const uint32_t n_rs_seq = session->ctx->get_cparams().n_rs_seq;
+    if (n_rs_seq == 0 || token_count == 0 || token_count > static_cast<size_t>(n_rs_seq)) {
+        return false;
+    }
+    return llm_arch_supports_rs_rollback(session->ctx->get_model().arch);
+}
+
 enum skippy_status skippy_checkpoint_verify_window(
         skippy_session * session,
         const llama_token * token_ids,
@@ -79,6 +102,9 @@ enum skippy_status skippy_checkpoint_verify_window(
     if (!skippy_memory_needs_verify_checkpoint(memory)) {
         return skippy_success(out_error);
     }
+    if (skippy_verify_window_can_roll_back_in_place(session, token_count)) {
+        return skippy_success(out_error);
+    }
 
     session->ctx->synchronize();
     const size_t state_size = llama_state_seq_get_size_ext(
diff --git a/src/skippy/runtime_support.h b/src/skippy/runtime_support.h
index 29c88b137..8146f5a65 100644
--- a/src/skippy/runtime_support.h
+++ b/src/skippy/runtime_support.h
@@ -24,6 +24,9 @@ void skippy_release_execution_lane(skippy_model * model, int32_t seq_id);
 bool skippy_memory_needs_verify_checkpoint(llama_memory_t memory);
 void skippy_mtp_clear_session_state(skippy_session * session);
 void skippy_clear_chat_sampling(skippy_session * session);
+bool skippy_verify_window_can_roll_back_in_place(
+        const skippy_session * session,
+        size_t token_count);
 enum skippy_status skippy_restore_verify_prefix(
         skippy_session * session,
         uint64_t token_count,
diff --git a/src/skippy/state.cpp b/src/skippy/state.cpp
index 5b64b97a9..375cc7196 100644
--- a/src/skippy/state.cpp
+++ b/src/skippy/state.cpp
@@ -654,6 +654,11 @@ enum skippy_status skippy_retire_verify_checkpoint(
     if (!skippy_memory_needs_verify_checkpoint(session->ctx->get_memory())) {
         return skippy_success(out_error);
     }
+    // No checkpoint is taken when the span rolls back in place, so there is
+    // nothing to retire.
+    if (skippy_verify_window_can_roll_back_in_place(session, static_cast<size_t>(token_count))) {
+        return skippy_success(out_error);
+    }
     if (!skippy_retire_verify_checkpoint_exact(
                 session->verify_checkpoints, token_start, token_count)) {
         skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "verify-window checkpoint was not found");

+++ b/src/skippy/stage_slice_plan.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "block_boundaries.h"
+#include "state_effects.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct ggml_cgraph;
+struct ggml_tensor;
+
+struct skippy_parameter_binding {
+    const ggml_tensor * tensor = nullptr;
+    std::string identity;
+};
+
+struct skippy_stage_slice_selection {
+    int32_t layer_start = 0;
+    int32_t layer_end = 0;
+    std::vector<int32_t> node_indices;
+    std::vector<const ggml_tensor *> activation_imports;
+    std::vector<const ggml_tensor *> activation_exports;
+    std::vector<const ggml_tensor *> request_inputs;
+    std::vector<std::string> parameter_identities;
+    std::vector<skippy_state_effect> state_effects;
+};
+
+bool skippy_select_stage_slice(
+        ggml_cgraph * graph,
+        const std::vector<skippy_block_boundary> & boundaries,
+        const std::vector<skippy_state_effect> & state_effects,
+        const std::vector<skippy_parameter_binding> & parameters,
+        int32_t layer_count,
+        int32_t layer_start,
+        int32_t layer_end,
+        skippy_stage_slice_selection & selection,
+        std::string & error);
diff --git a/src/skippy/tests/noalloc_graph_planning.cpp b/src/skippy/tests/noalloc_graph_planning.cpp
index f433ad31e..c19928fb1 100644
--- a/src/skippy/tests/noalloc_graph_planning.cpp
+++ b/src/skippy/tests/noalloc_graph_planning.cpp
@@ -9,6 +9,7 @@
 #include "llama.h"
 #include "skippy/block_boundaries.h"
 #include "skippy/graph_dependencies.h"
+#include "skippy/stage_slice_plan.h"
 #include "skippy/state_effects.h"
 
 #include <algorithm>
@@ -196,6 +197,106 @@ static size_t layer_state_count(
     return count;
 }
 
+static bool check_stage_slices(
+        const llm_graph_result * graph_result,
+        ggml_cgraph * graph,
+        const llama_model * model,
+        const char * profile_name,
+        const std::vector<std::string> & full_dependencies) {
+    std::vector<skippy_parameter_binding> parameters;
+    for (const auto & [name, tensor] : llama_internal_get_tensor_map(model)) {
+        parameters.push_back({tensor, name});
+    }
+
+    const int32_t n_layer = llama_model_n_layer(model);
+    std::vector<std::string> selected_dependencies;
+    bool has_recurrent_layer = false;
+    bool proved_noncontiguous_recurrent_slice = false;
+    for (int32_t layer = 0; layer < n_layer; ++layer) {
+        skippy_stage_slice_selection selection;
+        std::string error;
+        if (!skippy_select_stage_slice(
+                    graph,
+                    graph_result->get_block_boundaries(),
+                    graph_result->get_state_effects(),
+                    parameters,
+                    n_layer,
+                    layer,
+                    layer + 1,
+                    selection,
+                    error)) {
+            std::fprintf(stderr, "metadata-only %s layer %d slice invalid: %s\n",
+                    profile_name, layer, error.c_str());
+            return false;
+        }
+        if (selection.node_indices.empty() || selection.parameter_identities.empty()) {
+            std::fprintf(stderr, "metadata-only %s layer %d slice is incomplete\n",
+                    profile_name, layer);
+            return false;
+        }
+        if (!std::is_sorted(selection.node_indices.begin(), selection.node_indices.end()) ||
+                std::adjacent_find(selection.node_indices.begin(), selection.node_indices.end()) != selection.node_indices.end()) {
+            std::fprintf(stderr, "metadata-only %s layer %d slice nodes are not normalized\n",
+                    profile_name, layer);
+            return false;
+        }
+        for (int32_t index : selection.node_indices) {
+            if (index < 0 || index >= ggml_graph_n_nodes(graph)) {
+                std::fprintf(stderr, "metadata-only %s layer %d slice has an invalid node index\n",
+                        profile_name, layer);
+                return false;
+            }
+        }
+        if (layer > 0 && selection.activation_imports.empty()) {
+            std::fprintf(stderr, "metadata-only %s layer %d slice has no activation import\n",
+                    profile_name, layer);
+            return false;
+        }
+        if (layer + 1 < n_layer && selection.activation_exports.empty()) {
+            std::fprintf(stderr, "metadata-only %s layer %d slice has no activation export\n",
+                    profile_name, layer);
+            return false;
+        }
+        if (layer > 0 && model->hparams.is_recr(layer)) {
+            has_recurrent_layer = true;
+            const ggml_tensor * entry = graph_result->get_block_boundaries()[2 * layer].tensor;
+            int32_t entry_index = -1;
+            for (int32_t index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+                if (ggml_graph_node(graph, index) == entry) {
+                    entry_index = index;
+                    break;
+                }
+            }
+            if (entry_index < 0 || selection.node_indices.front() >= entry_index) {
+                std::fprintf(stderr,
+                        "metadata-only %s recurrent layer %d slice omitted its pre-entry auxiliary cone\n",
+                        profile_name, layer);
+                return false;
+            }
+            proved_noncontiguous_recurrent_slice = true;
+        }
+        selected_dependencies.insert(
+                selected_dependencies.end(),
+                selection.parameter_identities.begin(),
+                selection.parameter_identities.end());
+    }
+    std::sort(selected_dependencies.begin(), selected_dependencies.end());
+    selected_dependencies.erase(
+            std::unique(selected_dependencies.begin(), selected_dependencies.end()),
+            selected_dependencies.end());
+    if (selected_dependencies != full_dependencies) {
+        std::fprintf(stderr, "metadata-only %s slices do not cover the exact graph dependency set\n",
+                profile_name);
+        return false;
+    }
+    if (has_recurrent_layer && !proved_noncontiguous_recurrent_slice) {
+        std::fprintf(stderr, "metadata-only %s did not prove a non-contiguous recurrent slice\n",
+                profile_name);
+        return false;
+    }
+    return true;
+}
+
 static bool layer_has_state(
         const std::vector<skippy_state_effect> & effects,
         int32_t layer,
@@ -405,6 +506,10 @@ static bool build_graph_profile(
         llama_free(context);
         return false;
     }
+    if (!check_stage_slices(graph_result, graph, model, profile_name, result.dependencies)) {
+        llama_free(context);
+        return false;
+    }
     llama_free(context);
     return true;
 }
diff --git a/src/skippy/tests/stage_slice_plan.cpp b/src/skippy/tests/stage_slice_plan.cpp
new file mode 100644
index 000000000..3053376dc
--- /dev/null
+++ b/src/skippy/tests/stage_slice_plan.cpp
@@ -0,0 +1,133 @@
+#include "ggml.h"
+#include "skippy/stage_slice_plan.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+static bool contains_tensor(
+        const std::vector<const ggml_tensor *> & tensors,
+        const ggml_tensor * expected) {
+    return std::find(tensors.begin(), tensors.end(), expected) != tensors.end();
+}
+
+static int check_middle_stage_selection() {
+    std::vector<uint8_t> buffer(ggml_tensor_overhead() * 96 + ggml_graph_overhead_custom(96, false));
+    ggml_init_params params = { buffer.size(), buffer.data(), true };
+    ggml_context * ctx = ggml_init(params);
+
+    ggml_tensor * tokens = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * request = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_set_input(tokens);
+    ggml_set_input(request);
+    ggml_tensor * parameter_0 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * parameter_1 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * parameter_2 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * state = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+
+    ggml_tensor * entry_0 = ggml_mul(ctx, tokens, parameter_0);
+    ggml_tensor * pass_through = ggml_mul(ctx, entry_0, parameter_0);
+    ggml_tensor * exit_0 = ggml_add(ctx, entry_0, pass_through);
+    ggml_tensor * local_state_read = ggml_add(ctx, state, request);
+    ggml_tensor * exit_1 = ggml_add(ctx, exit_0, ggml_mul(ctx, local_state_read, parameter_1));
+    ggml_tensor * state_write = ggml_cpy(ctx, exit_1, state);
+    ggml_tensor * exit_2 = ggml_add(ctx, ggml_mul(ctx, exit_1, parameter_2), pass_through);
+    ggml_tensor * logits = ggml_mul(ctx, exit_2, parameter_2);
+
+    ggml_cgraph * graph = ggml_new_graph_custom(ctx, 96, false);
+    ggml_build_forward_expand(graph, pass_through);
+    ggml_build_forward_expand(graph, state_write);
+    ggml_build_forward_expand(graph, logits);
+
+    const std::vector<skippy_block_boundary> boundaries = {
+        {skippy_block_boundary_kind::entry, 0, entry_0},
+        {skippy_block_boundary_kind::exit, 0, exit_0},
+        {skippy_block_boundary_kind::entry, 1, exit_0},
+        {skippy_block_boundary_kind::exit, 1, exit_1},
+        {skippy_block_boundary_kind::entry, 2, exit_1},
+        {skippy_block_boundary_kind::exit, 2, exit_2},
+    };
+    const std::vector<skippy_state_effect> effects = {
+        {skippy_state_kind::recurrent_conv, skippy_state_access::read, 1, state, nullptr},
+        {skippy_state_kind::recurrent_conv, skippy_state_access::write, 1, state, state_write},
+    };
+    const std::vector<skippy_parameter_binding> parameter_bindings = {
+        {parameter_0, "block.0.weight"},
+        {parameter_1, "block.1.weight"},
+        {parameter_2, "block.2.weight"},
+    };
+
+    skippy_stage_slice_selection selection;
+    std::string error;
+    if (!skippy_select_stage_slice(
+                graph,
+                boundaries,
+                effects,
+                parameter_bindings,
+                3,
+                1,
+                2,
+                selection,
+                error)) {
+        std::fprintf(stderr, "middle stage selection failed: %s\n", error.c_str());
+        ggml_free(ctx);
+        return 1;
+    }
+    if (selection.parameter_identities != std::vector<std::string>{"block.1.weight"}) {
+        std::fprintf(stderr, "middle stage selected the wrong parameters:");
+        for (const std::string & identity : selection.parameter_identities) {
+            std::fprintf(stderr, " %s", identity.c_str());
+        }
+        std::fprintf(stderr, "\n");
+        ggml_free(ctx);
+        return 2;
+    }
+    if (!contains_tensor(selection.activation_imports, exit_0) ||
+            !contains_tensor(selection.activation_imports, pass_through) ||
+            !contains_tensor(selection.activation_exports, exit_1) ||
+            !contains_tensor(selection.activation_exports, pass_through)) {
+        std::fprintf(stderr, "middle stage lost an activation or pass-through frontier\n");
+        ggml_free(ctx);
+        return 3;
+    }
+    if (!contains_tensor(selection.request_inputs, request) ||
+            contains_tensor(selection.request_inputs, tokens)) {
+        std::fprintf(stderr, "middle stage request-input classification is incorrect\n");
+        ggml_free(ctx);
+        return 4;
+    }
+    if (selection.state_effects.size() != 2) {
+        std::fprintf(stderr, "middle stage did not retain its state owner and write effect\n");
+        ggml_free(ctx);
+        return 5;
+    }
+    if (selection.node_indices.size() < 4) {
+        std::fprintf(stderr, "middle stage omitted locally resolvable state preparation\n");
+        ggml_free(ctx);
+        return 6;
+    }
+
+    ggml_set_input(parameter_1);
+    if (skippy_select_stage_slice(
+                graph,
+                boundaries,
+                effects,
+                parameter_bindings,
+                3,
+                1,
+                2,
+                selection,
+                error)) {
+        std::fprintf(stderr, "multiply classified parameter was accepted\n");
+        ggml_free(ctx);
+        return 7;
+    }
+
+    ggml_free(ctx);
+    return 0;
+}
+
+int main() {
+    return check_middle_stage_selection();
+}

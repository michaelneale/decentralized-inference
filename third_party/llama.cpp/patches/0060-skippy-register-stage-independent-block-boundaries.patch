diff --git a/src/skippy/block_boundaries.cpp b/src/skippy/block_boundaries.cpp
new file mode 100644
index 000000000..e72a49b0c
--- /dev/null
+++ b/src/skippy/block_boundaries.cpp
@@ -0,0 +1,64 @@
+#include "block_boundaries.h"
+
+#include "ggml.h"
+
+#include <cinttypes>
+#include <cstdio>
+
+static std::string boundary_error(const char * fmt, int32_t layer) {
+    char buf[192];
+    std::snprintf(buf, sizeof(buf), fmt, layer);
+    return buf;
+}
+
+bool skippy_validate_block_boundaries(
+        const std::vector<skippy_block_boundary> & boundaries,
+        int32_t layer_start,
+        int32_t layer_end,
+        std::string & error) {
+    if (layer_start < 0 || layer_end < layer_start) {
+        error = "invalid declared layer range";
+        return false;
+    }
+
+    const size_t expected = 2 * static_cast<size_t>(layer_end - layer_start);
+    if (boundaries.size() != expected) {
+        error = "boundary record count does not match declared layer range";
+        return false;
+    }
+
+    const ggml_tensor * prev_exit = nullptr;
+    size_t index = 0;
+    for (int32_t layer = layer_start; layer < layer_end; ++layer) {
+        const skippy_block_boundary & entry = boundaries[index++];
+        const skippy_block_boundary & exit  = boundaries[index++];
+
+        if (entry.kind != skippy_block_boundary_kind::entry) {
+            error = boundary_error("layer %" PRId32 " record is not an ordered entry", layer);
+            return false;
+        }
+        if (exit.kind != skippy_block_boundary_kind::exit) {
+            error = boundary_error("layer %" PRId32 " record is not an ordered exit", layer);
+            return false;
+        }
+        if (entry.layer != layer || exit.layer != layer) {
+            error = boundary_error("layer %" PRId32 " boundary pair is missing, duplicated, or unordered", layer);
+            return false;
+        }
+        if (entry.tensor == nullptr) {
+            error = boundary_error("layer %" PRId32 " entry tensor is null", layer);
+            return false;
+        }
+        if (exit.tensor == nullptr) {
+            error = boundary_error("layer %" PRId32 " exit tensor is null", layer);
+            return false;
+        }
+        if (prev_exit != nullptr && entry.tensor != prev_exit) {
+            error = boundary_error("layer %" PRId32 " entry does not chain from the previous exit", layer);
+            return false;
+        }
+        prev_exit = exit.tensor;
+    }
+
+    return true;
+}
diff --git a/src/skippy/block_boundaries.h b/src/skippy/block_boundaries.h
new file mode 100644
index 000000000..7c9aae114
--- /dev/null
+++ b/src/skippy/block_boundaries.h
@@ -0,0 +1,42 @@
+#pragma once
+
+// Stage-independent block boundary records for the executable graph.
+//
+// Model graph builders register a canonical entry and exit tensor for every
+// transformer or recurrent block, keyed by the block's layer ordinal. The
+// records are owned by the exact graph result that built them and carry no
+// stage range, endpoint ownership, family policy, tensor-name rule, or split
+// decision. Boundaries are validated structurally, never inferred from node
+// names.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct ggml_tensor;
+
+enum class skippy_block_boundary_kind : int32_t {
+    entry = 0,
+    exit  = 1,
+};
+
+struct skippy_block_boundary {
+    skippy_block_boundary_kind kind = skippy_block_boundary_kind::entry;
+    int32_t layer = -1;
+    const ggml_tensor * tensor = nullptr;
+};
+
+// Validate the boundary records registered while building one graph profile.
+//
+// Fails closed: returns false and sets `error` when any declared layer in
+// [layer_start, layer_end) is missing a record, any record is duplicated,
+// records are unordered or interleaved, an entry/exit pair is mismatched, a
+// record lies outside the declared range, or a canonical tensor is null.
+// Consecutive blocks must chain: the entry tensor of layer N+1 must be the
+// exit tensor of layer N, so a registered frontier cannot silently diverge
+// from the values that actually cross it.
+bool skippy_validate_block_boundaries(
+        const std::vector<skippy_block_boundary> & boundaries,
+        int32_t layer_start,
+        int32_t layer_end,
+        std::string & error);
diff --git a/src/skippy/tests/noalloc_graph_planning.cpp b/src/skippy/tests/noalloc_graph_planning.cpp
index 49246c110..c2908dd78 100644
--- a/src/skippy/tests/noalloc_graph_planning.cpp
+++ b/src/skippy/tests/noalloc_graph_planning.cpp
@@ -8,6 +8,7 @@
 #include "llama-memory-recurrent.h"
 #include "llama-model.h"
 #include "llama.h"
+#include "skippy/block_boundaries.h"
 #include "skippy/graph_dependencies.h"
 
 #include <algorithm>
@@ -159,6 +160,7 @@ static llama_model * load_metadata_only_model(const char * model_path) {
 
 struct graph_profile_result {
     int node_count = 0;
+    size_t boundary_pairs = 0;
     std::vector<std::string> dependencies;
 };
 
@@ -193,6 +195,18 @@ static bool build_graph_profile(
         return false;
     }
     result.node_count = ggml_graph_n_nodes(graph);
+
+    const llm_graph_result * graph_result = context->get_gf_res_reserve();
+    const auto & boundaries = graph_result->get_block_boundaries();
+    std::string boundary_error;
+    if (!skippy_validate_block_boundaries(boundaries, 0, llama_model_n_layer(model), boundary_error)) {
+        std::fprintf(stderr, "metadata-only %s block boundaries invalid: %s\n",
+                profile_name, boundary_error.c_str());
+        llama_free(context);
+        return false;
+    }
+    result.boundary_pairs = boundaries.size() / 2;
+
     result.dependencies = skippy_graph_parameter_dependencies(graph, model);
     if (result.dependencies.empty()) {
         std::fprintf(stderr, "metadata-only %s graph has no parameter dependencies\n", profile_name);
@@ -245,22 +259,90 @@ static int check_noalloc_graphs(const char * model_path, bool expect_recurrent)
         llama_model_free(model);
         return 5;
     }
+    const size_t expected_pairs = static_cast<size_t>(llama_model_n_layer(model));
+    if (prefill.boundary_pairs != expected_pairs ||
+            batched.boundary_pairs != expected_pairs ||
+            decode.boundary_pairs != expected_pairs) {
+        std::fprintf(stderr,
+                "metadata-only block boundary pairs differ from declared layers: prefill=%zu batched=%zu decode=%zu expected=%zu\n",
+                prefill.boundary_pairs,
+                batched.boundary_pairs,
+                decode.boundary_pairs,
+                expected_pairs);
+        llama_model_free(model);
+        return 6;
+    }
 
-    std::printf("metadata-only planning: prefill_nodes=%d batched_nodes=%d decode_nodes=%d parameters=%zu recurrent=%d\n",
+    std::printf("metadata-only planning: prefill_nodes=%d batched_nodes=%d decode_nodes=%d parameters=%zu block_pairs=%zu recurrent=%d\n",
             prefill.node_count,
             batched.node_count,
             decode.node_count,
             prefill.dependencies.size(),
+            prefill.boundary_pairs,
             expect_recurrent ? 1 : 0);
     llama_model_free(model);
     return 0;
 }
 
+static bool check_boundary_validation_rejects() {
+    ggml_tensor a = {};
+    ggml_tensor b = {};
+    ggml_tensor c = {};
+    std::string error;
+
+    const std::vector<skippy_block_boundary> valid = {
+        {skippy_block_boundary_kind::entry, 0, &a},
+        {skippy_block_boundary_kind::exit,  0, &b},
+        {skippy_block_boundary_kind::entry, 1, &b},
+        {skippy_block_boundary_kind::exit,  1, &c},
+    };
+    if (!skippy_validate_block_boundaries(valid, 0, 2, error)) {
+        std::fprintf(stderr, "valid boundary chain rejected: %s\n", error.c_str());
+        return false;
+    }
+
+    const std::vector<std::vector<skippy_block_boundary>> rejected = {
+        // missing layer 1 records
+        {{skippy_block_boundary_kind::entry, 0, &a},
+         {skippy_block_boundary_kind::exit,  0, &b}},
+        // duplicated entry instead of exit
+        {{skippy_block_boundary_kind::entry, 0, &a},
+         {skippy_block_boundary_kind::entry, 0, &a},
+         {skippy_block_boundary_kind::entry, 1, &b},
+         {skippy_block_boundary_kind::exit,  1, &c}},
+        // unordered layers
+        {{skippy_block_boundary_kind::entry, 1, &b},
+         {skippy_block_boundary_kind::exit,  1, &c},
+         {skippy_block_boundary_kind::entry, 0, &a},
+         {skippy_block_boundary_kind::exit,  0, &b}},
+        // entry does not chain from previous exit
+        {{skippy_block_boundary_kind::entry, 0, &a},
+         {skippy_block_boundary_kind::exit,  0, &b},
+         {skippy_block_boundary_kind::entry, 1, &a},
+         {skippy_block_boundary_kind::exit,  1, &c}},
+        // null canonical tensor
+        {{skippy_block_boundary_kind::entry, 0, &a},
+         {skippy_block_boundary_kind::exit,  0, nullptr},
+         {skippy_block_boundary_kind::entry, 1, &b},
+         {skippy_block_boundary_kind::exit,  1, &c}},
+    };
+    for (size_t i = 0; i < rejected.size(); ++i) {
+        if (skippy_validate_block_boundaries(rejected[i], 0, 2, error)) {
+            std::fprintf(stderr, "invalid boundary case %zu was accepted\n", i);
+            return false;
+        }
+    }
+    return true;
+}
+
 int main(int argc, char ** argv) {
     if (argc != 3) {
         std::fprintf(stderr, "usage: %s MODEL_PATH EXPECT_RECURRENT\n", argv[0]);
         return 64;
     }
+    if (!check_boundary_validation_rejects()) {
+        return 65;
+    }
     llama_backend_init();
     const int result = check_noalloc_graphs(argv[1], std::string(argv[2]) == "1");
     llama_backend_free();

+static bool check_state_validation_rejects() {
+    // minimal real graph so effect nodes can be checked for membership
+    std::vector<uint8_t> buf(ggml_tensor_overhead() * 16 + ggml_graph_overhead());
+    ggml_init_params init = { buf.size(), buf.data(), true };
+    ggml_context * ctx = ggml_init(init);
+    ggml_tensor * storage = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * value   = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * node    = ggml_add(ctx, storage, value);
+    ggml_tensor * node2   = ggml_sub(ctx, storage, value);
+    ggml_tensor * stray   = ggml_mul(ctx, storage, value);
+    ggml_cgraph * graph   = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, node);
+    ggml_build_forward_expand(graph, node2);
+
+    std::string error;
+    const auto kv = skippy_state_kind::kv_key;
+    const auto rd = skippy_state_access::read;
+    const auto wr = skippy_state_access::write;
+
+    const std::vector<skippy_state_effect> valid = {
+        {kv, rd, 0, storage, nullptr},
+        {kv, wr, 0, storage, node},
+    };
+    if (!skippy_validate_state_effects(valid, graph, error)) {
+        std::fprintf(stderr, "valid state effects rejected: %s\n", error.c_str());
+        ggml_free(ctx);
+        return false;
+    }
+
+    // multiple ordered writes (rollback slots) with distinct exact nodes are valid
+    const std::vector<skippy_state_effect> valid_multi_write = {
+        {kv, rd, 0, storage, nullptr},
+        {kv, wr, 0, storage, node},
+        {kv, wr, 0, storage, node2},
+    };
+    if (!skippy_validate_state_effects(valid_multi_write, graph, error)) {
+        std::fprintf(stderr, "valid multi-write state effects rejected: %s\n", error.c_str());
+        ggml_free(ctx);
+        return false;
+    }
+
+    const std::vector<std::vector<skippy_state_effect>> rejected = {
+        // unknown kind
+        {{static_cast<skippy_state_kind>(99), rd, 0, storage, nullptr}},
+        // invalid layer
+        {{kv, rd, -1, storage, nullptr}},
+        // null storage
+        {{kv, rd, 0, nullptr, nullptr}},
+        // write without effect node
+        {{kv, rd, 0, storage, nullptr}, {kv, wr, 0, storage, nullptr}},
+        // write whose effect node is not in the exact graph
+        {{kv, rd, 0, storage, nullptr}, {kv, wr, 0, storage, stray}},
+        // duplicate (kind, layer) read owner
+        {{kv, rd, 0, storage, nullptr}, {kv, rd, 0, storage, nullptr}},
+        // duplicate exact write node
+        {{kv, rd, 0, storage, nullptr}, {kv, wr, 0, storage, node}, {kv, wr, 0, storage, node}},
+        // write without matching read owner
+        {{kv, wr, 0, storage, node}},
+    };
+    for (size_t i = 0; i < rejected.size(); ++i) {
+        if (skippy_validate_state_effects(rejected[i], graph, error)) {
+            std::fprintf(stderr, "invalid state effect case %zu was accepted\n", i);
+            ggml_free(ctx);
+            return false;
+        }
+    }
+    ggml_free(ctx);
+    return true;
+}

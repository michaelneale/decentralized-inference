diff --git a/src/skippy/state_effects.cpp b/src/skippy/state_effects.cpp
new file mode 100644
index 000000000..a0456aef0
--- /dev/null
+++ b/src/skippy/state_effects.cpp
@@ -0,0 +1,118 @@
+#include "state_effects.h"
+
+#include "ggml.h"
+
+#include <cinttypes>
+#include <cstdio>
+#include <set>
+#include <tuple>
+#include <unordered_set>
+
+const ggml_tensor * skippy_state_canonical_storage(const ggml_tensor * tensor) {
+    while (tensor != nullptr && tensor->view_src != nullptr) {
+        tensor = tensor->view_src;
+    }
+    return tensor;
+}
+
+static std::string effect_error(const char * fmt, size_t index) {
+    char buf[192];
+    std::snprintf(buf, sizeof(buf), fmt, index);
+    return buf;
+}
+
+static bool state_kind_known(skippy_state_kind kind) {
+    switch (kind) {
+        case skippy_state_kind::kv_key:
+        case skippy_state_kind::kv_value:
+        case skippy_state_kind::recurrent_conv:
+        case skippy_state_kind::recurrent_ssm:
+            return true;
+    }
+    return false;
+}
+
+static bool state_access_known(skippy_state_access access) {
+    switch (access) {
+        case skippy_state_access::read:
+        case skippy_state_access::write:
+            return true;
+    }
+    return false;
+}
+
+bool skippy_validate_state_effects(
+        const std::vector<skippy_state_effect> & effects,
+        const ggml_cgraph * graph,
+        std::string & error) {
+    if (graph == nullptr) {
+        error = "state effects require the exact graph";
+        return false;
+    }
+
+    std::unordered_set<const ggml_tensor *> graph_nodes;
+    for (int i = 0; i < ggml_graph_n_nodes(const_cast<ggml_cgraph *>(graph)); ++i) {
+        graph_nodes.insert(ggml_graph_node(const_cast<ggml_cgraph *>(graph), i));
+    }
+
+    std::set<std::tuple<int32_t, int32_t>> seen_reads;
+    std::unordered_set<const ggml_tensor *> seen_write_nodes;
+    std::set<std::tuple<int32_t, int32_t, const ggml_tensor *>> reads;
+
+    for (size_t i = 0; i < effects.size(); ++i) {
+        const skippy_state_effect & effect = effects[i];
+        if (!state_kind_known(effect.kind)) {
+            error = effect_error("state effect %zu has an unknown kind", i);
+            return false;
+        }
+        if (!state_access_known(effect.access)) {
+            error = effect_error("state effect %zu has an unknown access", i);
+            return false;
+        }
+        if (effect.layer < 0) {
+            error = effect_error("state effect %zu has an invalid layer", i);
+            return false;
+        }
+        if (effect.storage == nullptr) {
+            error = effect_error("state effect %zu has null storage", i);
+            return false;
+        }
+        if (effect.storage->view_src != nullptr) {
+            error = effect_error("state effect %zu storage is a view, not canonical", i);
+            return false;
+        }
+        if (effect.access == skippy_state_access::read) {
+            if (!seen_reads.insert({static_cast<int32_t>(effect.kind), effect.layer}).second) {
+                error = effect_error("state effect %zu duplicates a (kind, layer) read owner", i);
+                return false;
+            }
+            reads.insert({static_cast<int32_t>(effect.kind), effect.layer, effect.storage});
+        } else {
+            if (effect.effect_node == nullptr) {
+                error = effect_error("state effect %zu write has no ordered effect node", i);
+                return false;
+            }
+            if (graph_nodes.find(effect.effect_node) == graph_nodes.end()) {
+                error = effect_error("state effect %zu write node is not in the exact graph", i);
+                return false;
+            }
+            if (!seen_write_nodes.insert(effect.effect_node).second) {
+                error = effect_error("state effect %zu duplicates an exact write node", i);
+                return false;
+            }
+        }
+    }
+
+    for (size_t i = 0; i < effects.size(); ++i) {
+        const skippy_state_effect & effect = effects[i];
+        if (effect.access != skippy_state_access::write) {
+            continue;
+        }
+        if (reads.find({static_cast<int32_t>(effect.kind), effect.layer, effect.storage}) == reads.end()) {
+            error = effect_error("state effect %zu write has no matching read owner", i);
+            return false;
+        }
+    }
+
+    return true;
+}
diff --git a/src/skippy/state_effects.h b/src/skippy/state_effects.h
new file mode 100644
index 000000000..f0aec1aec
--- /dev/null
+++ b/src/skippy/state_effects.h
@@ -0,0 +1,58 @@
+#pragma once
+
+// Stage-independent persistent-state access/effect records for the
+// executable graph.
+//
+// Generic graph helpers register every persistent-state read and ordered
+// write they establish, keyed by semantic state kind and layer ordinal and
+// owned by the exact graph result that built them. Records carry no stage
+// range, endpoint ownership, family policy, tensor-name rule, or split
+// decision. Storage identity is the canonical backing tensor: views are
+// resolved through view_src before recording.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct ggml_cgraph;
+struct ggml_tensor;
+
+enum class skippy_state_kind : int32_t {
+    kv_key         = 0,
+    kv_value       = 1,
+    recurrent_conv = 2,
+    recurrent_ssm  = 3,
+};
+
+enum class skippy_state_access : int32_t {
+    read  = 0,
+    write = 1,
+};
+
+struct skippy_state_effect {
+    skippy_state_kind kind = skippy_state_kind::kv_key;
+    skippy_state_access access = skippy_state_access::read;
+    int32_t layer = -1;
+    // canonical backing storage tensor of the persistent state
+    const ggml_tensor * storage = nullptr;
+    // for writes: the graph node that establishes the ordered state update;
+    // null for reads, whose ordering the storage dependency already carries
+    const ggml_tensor * effect_node = nullptr;
+};
+
+// Resolve a possibly-view tensor to its canonical backing storage.
+const ggml_tensor * skippy_state_canonical_storage(const ggml_tensor * tensor);
+
+// Validate the state effects registered while building one graph profile.
+//
+// Fails closed: returns false and sets `error` on an unknown kind or access,
+// invalid layer, null storage, a write without an effect node, a write whose
+// effect node is not present in the exact graph, a duplicate (kind, layer)
+// read record, a duplicate exact write node, or a write without a matching
+// read of the same kind and layer against the same canonical storage. A
+// state owner may register multiple ordered writes (for example recurrent
+// rollback slots) as long as each carries a distinct exact graph node.
+bool skippy_validate_state_effects(
+        const std::vector<skippy_state_effect> & effects,
+        const ggml_cgraph * graph,
+        std::string & error);
diff --git a/src/skippy/tests/noalloc_graph_planning.cpp b/src/skippy/tests/noalloc_graph_planning.cpp
index a5814145d..f433ad31e 100644
--- a/src/skippy/tests/noalloc_graph_planning.cpp
+++ b/src/skippy/tests/noalloc_graph_planning.cpp
@@ -9,10 +9,12 @@
 #include "llama.h"
 #include "skippy/block_boundaries.h"
 #include "skippy/graph_dependencies.h"
+#include "skippy/state_effects.h"
 
 #include <algorithm>
 #include <cstdint>
 #include <cstdio>
+#include <cstdlib>
 #include <string>
 #include <vector>
 
@@ -176,9 +178,144 @@ static llama_model * load_metadata_only_model(const char * model_path) {
 struct graph_profile_result {
     int node_count = 0;
     size_t boundary_pairs = 0;
+    size_t state_effects = 0;
     std::vector<std::string> dependencies;
 };
 
+static size_t layer_state_count(
+        const std::vector<skippy_state_effect> & effects,
+        int32_t layer,
+        skippy_state_kind kind,
+        skippy_state_access access) {
+    size_t count = 0;
+    for (const auto & effect : effects) {
+        if (effect.layer == layer && effect.kind == kind && effect.access == access) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+static bool layer_has_state(
+        const std::vector<skippy_state_effect> & effects,
+        int32_t layer,
+        skippy_state_kind kind,
+        skippy_state_access access) {
+    return layer_state_count(effects, layer, kind, access) > 0;
+}
+
+enum class layer_state_class {
+    kv,
+    recurrent,
+    none,
+};
+
+static bool parse_layer_classes(const char * spec, std::vector<layer_state_class> & classes) {
+    std::string token;
+    for (const char * c = spec;; ++c) {
+        if (*c == ',' || *c == '\0') {
+            if (token == "kv") {
+                classes.push_back(layer_state_class::kv);
+            } else if (token == "recurrent") {
+                classes.push_back(layer_state_class::recurrent);
+            } else if (token == "none") {
+                classes.push_back(layer_state_class::none);
+            } else {
+                return false;
+            }
+            token.clear();
+            if (*c == '\0') {
+                return !classes.empty();
+            }
+        } else {
+            token += *c;
+        }
+    }
+}
+
+static bool check_state_effects(
+        const llm_graph_result * graph_result,
+        ggml_cgraph * graph,
+        const llama_model * model,
+        const char * profile_name,
+        const std::vector<layer_state_class> & layer_classes,
+        size_t expected_conv_writes) {
+    const auto & effects = graph_result->get_state_effects();
+    std::string effect_error;
+    if (!skippy_validate_state_effects(effects, graph, effect_error)) {
+        std::fprintf(stderr, "metadata-only %s state effects invalid: %s\n",
+                profile_name, effect_error.c_str());
+        return false;
+    }
+
+    const int32_t n_layer = llama_model_n_layer(model);
+    if (layer_classes.size() != static_cast<size_t>(n_layer)) {
+        std::fprintf(stderr, "fixture declares %d layers but %zu layer classes were specified\n",
+                n_layer, layer_classes.size());
+        return false;
+    }
+
+    // every declared layer carries exactly its expected local state class
+    for (int32_t il = 0; il < n_layer; ++il) {
+        const layer_state_class expected = layer_classes[il];
+
+        const size_t kv_key_reads    = layer_state_count(effects, il, skippy_state_kind::kv_key, skippy_state_access::read);
+        const size_t kv_key_writes   = layer_state_count(effects, il, skippy_state_kind::kv_key, skippy_state_access::write);
+        const size_t kv_value_reads  = layer_state_count(effects, il, skippy_state_kind::kv_value, skippy_state_access::read);
+        const size_t kv_value_writes = layer_state_count(effects, il, skippy_state_kind::kv_value, skippy_state_access::write);
+        const size_t conv_reads      = layer_state_count(effects, il, skippy_state_kind::recurrent_conv, skippy_state_access::read);
+        const size_t conv_writes     = layer_state_count(effects, il, skippy_state_kind::recurrent_conv, skippy_state_access::write);

diff --git a/src/skippy/state_effects.cpp b/src/skippy/state_effects.cpp
new file mode 100644
index 000000000..589cf5cc2
--- /dev/null
+++ b/src/skippy/state_effects.cpp
@@ -0,0 +1,119 @@
+#include "state_effects.h"
+
+#include "ggml.h"
+
+#include <cinttypes>
+#include <cstdio>
+#include <set>
+#include <tuple>
+#include <unordered_set>
+
+const ggml_tensor * skippy_state_canonical_storage(const ggml_tensor * tensor) {
+    while (tensor != nullptr && tensor->view_src != nullptr) {
+        tensor = tensor->view_src;
+    }
+    return tensor;
+}
+
+static std::string effect_error(const char * fmt, size_t index) {
+    char buf[192];
+    std::snprintf(buf, sizeof(buf), fmt, index);
+    return buf;
+}
+
+static bool state_kind_known(skippy_state_kind kind) {
+    switch (kind) {
+        case skippy_state_kind::kv_key:
+        case skippy_state_kind::kv_value:
+        case skippy_state_kind::recurrent_conv:
+        case skippy_state_kind::recurrent_ssm:
+            return true;
+    }
+    return false;
+}
+
+static bool state_access_known(skippy_state_access access) {
+    switch (access) {
+        case skippy_state_access::read:
+        case skippy_state_access::write:
+            return true;
+    }
+    return false;
+}
+
+bool skippy_validate_state_effects(
+        const std::vector<skippy_state_effect> & effects,
+        const ggml_cgraph * graph,
+        std::string & error) {
+    if (graph == nullptr) {
+        error = "state effects require the exact graph";
+        return false;
+    }
+
+    std::unordered_set<const ggml_tensor *> graph_nodes;
+    for (int i = 0; i < ggml_graph_n_nodes(const_cast<ggml_cgraph *>(graph)); ++i) {
+        graph_nodes.insert(ggml_graph_node(const_cast<ggml_cgraph *>(graph), i));
+    }
+
+    using access_key = std::tuple<int32_t, int32_t, int32_t>;
+    std::set<access_key> seen;
+    std::set<std::tuple<int32_t, int32_t, const ggml_tensor *>> reads;
+
+    for (size_t i = 0; i < effects.size(); ++i) {
+        const skippy_state_effect & effect = effects[i];
+        if (!state_kind_known(effect.kind)) {
+            error = effect_error("state effect %zu has an unknown kind", i);
+            return false;
+        }
+        if (!state_access_known(effect.access)) {
+            error = effect_error("state effect %zu has an unknown access", i);
+            return false;
+        }
+        if (effect.layer < 0) {
+            error = effect_error("state effect %zu has an invalid layer", i);
+            return false;
+        }
+        if (effect.storage == nullptr) {
+            error = effect_error("state effect %zu has null storage", i);
+            return false;
+        }
+        if (effect.storage->view_src != nullptr) {
+            error = effect_error("state effect %zu storage is a view, not canonical", i);
+            return false;
+        }
+        const access_key key{
+            static_cast<int32_t>(effect.kind),
+            static_cast<int32_t>(effect.access),
+            effect.layer,
+        };
+        if (!seen.insert(key).second) {
+            error = effect_error("state effect %zu duplicates a (kind, access, layer) record", i);
+            return false;
+        }
+        if (effect.access == skippy_state_access::read) {
+            reads.insert({static_cast<int32_t>(effect.kind), effect.layer, effect.storage});
+        } else {
+            if (effect.effect_node == nullptr) {
+                error = effect_error("state effect %zu write has no ordered effect node", i);
+                return false;
+            }
+            if (graph_nodes.find(effect.effect_node) == graph_nodes.end()) {
+                error = effect_error("state effect %zu write node is not in the exact graph", i);
+                return false;
+            }
+        }
+    }
+
+    for (size_t i = 0; i < effects.size(); ++i) {
+        const skippy_state_effect & effect = effects[i];
+        if (effect.access != skippy_state_access::write) {
+            continue;
+        }
+        if (reads.find({static_cast<int32_t>(effect.kind), effect.layer, effect.storage}) == reads.end()) {
+            error = effect_error("state effect %zu write has no matching read owner", i);
+            return false;
+        }
+    }
+
+    return true;
+}
diff --git a/src/skippy/state_effects.h b/src/skippy/state_effects.h
new file mode 100644
index 000000000..a4a57865e
--- /dev/null
+++ b/src/skippy/state_effects.h
@@ -0,0 +1,56 @@
+#pragma once
+
+// Stage-independent persistent-state access/effect records for the
+// executable graph.
+//
+// Generic graph helpers register every persistent-state read and ordered
+// write they establish, keyed by semantic state kind and layer ordinal and
+// owned by the exact graph result that built them. Records carry no stage
+// range, endpoint ownership, family policy, tensor-name rule, or split
+// decision. Storage identity is the canonical backing tensor: views are
+// resolved through view_src before recording.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct ggml_cgraph;
+struct ggml_tensor;
+
+enum class skippy_state_kind : int32_t {
+    kv_key         = 0,
+    kv_value       = 1,
+    recurrent_conv = 2,
+    recurrent_ssm  = 3,
+};
+
+enum class skippy_state_access : int32_t {
+    read  = 0,
+    write = 1,
+};
+
+struct skippy_state_effect {
+    skippy_state_kind kind = skippy_state_kind::kv_key;
+    skippy_state_access access = skippy_state_access::read;
+    int32_t layer = -1;
+    // canonical backing storage tensor of the persistent state
+    const ggml_tensor * storage = nullptr;
+    // for writes: the graph node that establishes the ordered state update;
+    // null for reads, whose ordering the storage dependency already carries
+    const ggml_tensor * effect_node = nullptr;
+};
+
+// Resolve a possibly-view tensor to its canonical backing storage.
+const ggml_tensor * skippy_state_canonical_storage(const ggml_tensor * tensor);
+
+// Validate the state effects registered while building one graph profile.
+//
+// Fails closed: returns false and sets `error` on an unknown kind or access,
+// invalid layer, null storage, a write without an effect node, a write whose
+// effect node is not present in the exact graph, a duplicate (kind, access,
+// layer) record, or a write without a matching read of the same kind and
+// layer against the same canonical storage.
+bool skippy_validate_state_effects(
+        const std::vector<skippy_state_effect> & effects,
+        const ggml_cgraph * graph,
+        std::string & error);
diff --git a/src/skippy/tests/noalloc_graph_planning.cpp b/src/skippy/tests/noalloc_graph_planning.cpp
index a5814145d..2fd838615 100644
--- a/src/skippy/tests/noalloc_graph_planning.cpp
+++ b/src/skippy/tests/noalloc_graph_planning.cpp
@@ -9,6 +9,7 @@
 #include "llama.h"
 #include "skippy/block_boundaries.h"
 #include "skippy/graph_dependencies.h"
+#include "skippy/state_effects.h"
 
 #include <algorithm>
 #include <cstdint>
@@ -176,9 +177,87 @@ static llama_model * load_metadata_only_model(const char * model_path) {
 struct graph_profile_result {
     int node_count = 0;
     size_t boundary_pairs = 0;
+    size_t state_effects = 0;
     std::vector<std::string> dependencies;
 };
 
+static bool layer_has_state(
+        const std::vector<skippy_state_effect> & effects,
+        int32_t layer,
+        skippy_state_kind kind,
+        skippy_state_access access) {
+    for (const auto & effect : effects) {
+        if (effect.layer == layer && effect.kind == kind && effect.access == access) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool check_state_effects(
+        const llm_graph_result * graph_result,
+        ggml_cgraph * graph,
+        const llama_model * model,
+        const char * profile_name) {
+    const auto & effects = graph_result->get_state_effects();
+    std::string effect_error;
+    if (!skippy_validate_state_effects(effects, graph, effect_error)) {
+        std::fprintf(stderr, "metadata-only %s state effects invalid: %s\n",
+                profile_name, effect_error.c_str());
+        return false;
+    }
+
+    // every declared layer carries its expected local state class
+    const int32_t n_layer = llama_model_n_layer(model);
+    for (int32_t il = 0; il < n_layer; ++il) {
+        const bool recurrent = model->hparams.is_recr(il);
+        bool ok = true;
+        if (recurrent) {
+            ok = layer_has_state(effects, il, skippy_state_kind::recurrent_conv, skippy_state_access::read) &&
+                 layer_has_state(effects, il, skippy_state_kind::recurrent_conv, skippy_state_access::write) &&
+                 layer_has_state(effects, il, skippy_state_kind::recurrent_ssm, skippy_state_access::read) &&
+                 layer_has_state(effects, il, skippy_state_kind::recurrent_ssm, skippy_state_access::write);
+        } else {
+            ok = layer_has_state(effects, il, skippy_state_kind::kv_key, skippy_state_access::read) &&
+                 layer_has_state(effects, il, skippy_state_kind::kv_key, skippy_state_access::write) &&
+                 layer_has_state(effects, il, skippy_state_kind::kv_value, skippy_state_access::read) &&
+                 layer_has_state(effects, il, skippy_state_kind::kv_value, skippy_state_access::write);
+        }
+        if (!ok) {
+            std::fprintf(stderr,
+                    "metadata-only %s layer %d does not declare its expected %s state class\n",
+                    profile_name, il, recurrent ? "recurrent" : "KV");
+            return false;
+        }
+        // no layer declares the other class's state
+        const bool cross = recurrent
+                ? (layer_has_state(effects, il, skippy_state_kind::kv_key, skippy_state_access::read) ||
+                   layer_has_state(effects, il, skippy_state_kind::kv_value, skippy_state_access::read))
+                : (layer_has_state(effects, il, skippy_state_kind::recurrent_conv, skippy_state_access::read) ||
+                   layer_has_state(effects, il, skippy_state_kind::recurrent_ssm, skippy_state_access::read));
+        if (cross) {
+            std::fprintf(stderr,
+                    "metadata-only %s layer %d declares state of the wrong class\n",
+                    profile_name, il);
+            return false;
+        }
+    }
+
+    // persistent state stays local: no state storage is an activation boundary
+    const ggml_tensor * activation_in  = skippy_state_canonical_storage(graph_result->get_skippy_activation_input());
+    const ggml_tensor * activation_out = skippy_state_canonical_storage(graph_result->get_skippy_activation_output());
+    for (const auto & effect : effects) {
+        if (effect.storage == activation_in || effect.storage == activation_out) {
+            std::fprintf(stderr,
+                    "metadata-only %s state storage leaked into an activation boundary\n",
+                    profile_name);
+            return false;
+        }
+    }
+
+    return true;
+}
+
 static bool build_graph_profile(
         llama_model * model,
         bool expect_recurrent,
@@ -237,6 +316,12 @@ static bool build_graph_profile(
     }
     result.boundary_pairs = boundaries.size() / 2;
 
+    if (!check_state_effects(graph_result, graph, model, profile_name)) {
+        llama_free(context);
+        return false;
+    }
+    result.state_effects = graph_result->get_state_effects().size();
+
     result.dependencies = skippy_graph_parameter_dependencies(graph, model);
     if (result.dependencies.empty()) {
         std::fprintf(stderr, "metadata-only %s graph has no parameter dependencies\n", profile_name);
@@ -303,12 +388,24 @@ static int check_noalloc_graphs(const char * model_path, bool expect_recurrent)
         return 6;
     }
 
-    std::printf("metadata-only planning: prefill_nodes=%d batched_nodes=%d decode_nodes=%d parameters=%zu block_pairs=%zu recurrent=%d\n",
+    if (prefill.state_effects != batched.state_effects ||
+            prefill.state_effects != decode.state_effects) {
+        std::fprintf(stderr,
+                "metadata-only state effect counts differ: prefill=%zu batched=%zu decode=%zu\n",
+                prefill.state_effects,
+                batched.state_effects,
+                decode.state_effects);
+        llama_model_free(model);
+        return 7;
+    }
+
+    std::printf("metadata-only planning: prefill_nodes=%d batched_nodes=%d decode_nodes=%d parameters=%zu block_pairs=%zu state_effects=%zu recurrent=%d\n",
             prefill.node_count,
             batched.node_count,
             decode.node_count,
             prefill.dependencies.size(),
             prefill.boundary_pairs,
+            prefill.state_effects,
             expect_recurrent ? 1 : 0);
     llama_model_free(model);
     return 0;
@@ -365,6 +462,60 @@ static bool check_boundary_validation_rejects() {
     return true;
 }
 
+static bool check_state_validation_rejects() {
+    // minimal real graph so effect nodes can be checked for membership
+    std::vector<uint8_t> buf(ggml_tensor_overhead() * 16 + ggml_graph_overhead());
+    ggml_init_params init = { buf.size(), buf.data(), true };
+    ggml_context * ctx = ggml_init(init);
+    ggml_tensor * storage = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * value   = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4);
+    ggml_tensor * node    = ggml_add(ctx, storage, value);
+    ggml_tensor * stray   = ggml_mul(ctx, storage, value);
+    ggml_cgraph * graph   = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, node);
+
+    std::string error;
+    const auto kv = skippy_state_kind::kv_key;
+    const auto rd = skippy_state_access::read;
+    const auto wr = skippy_state_access::write;
+
+    const std::vector<skippy_state_effect> valid = {
+        {kv, rd, 0, storage, nullptr},
+        {kv, wr, 0, storage, node},
+    };

diff --git a/tests/test-skippy-tokenization.cpp b/tests/test-skippy-tokenization.cpp
new file mode 100644
index 000000000..32fc8a997
--- /dev/null
+++ b/tests/test-skippy-tokenization.cpp
@@ -0,0 +1,45 @@
+#include "llama.h"
+#include "skippy/tokenization.h"
+#include "skippy/errors.h"
+#include "skippy/runtime_types.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        return EXIT_FAILURE;
+    }
+    llama_backend_init();
+    auto params = llama_model_default_params();
+    params.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(argv[1], params);
+    if (model == nullptr) {
+        return EXIT_FAILURE;
+    }
+    skippy_model stage;
+    stage.model = model;
+    skippy_error * error = nullptr;
+    size_t count = 0;
+    bool ok = skippy_tokenize(&stage, "hello", false, nullptr, 1, &count, &error)
+            == SKIPPY_STATUS_INVALID_ARGUMENT;
+    ok = ok && error != nullptr && error->status == SKIPPY_STATUS_INVALID_ARGUMENT;
+    skippy_error_free(error);
+    error = nullptr;
+    ok = ok && skippy_tokenize(&stage, "hello", false, nullptr, 0, &count, &error)
+            == SKIPPY_STATUS_BUFFER_TOO_SMALL && count > 0;
+    skippy_error_free(error);
+    error = nullptr;
+    std::vector<llama_token> tokens(count);
+    const size_t expected = count;
+    ok = ok && skippy_tokenize(&stage, "hello", false, tokens.data(), tokens.size(), &count, &error)
+            == SKIPPY_STATUS_OK && count == expected;
+    skippy_error_free(error);
+    llama_model_free(model);
+    llama_backend_free();
+    if (!ok) {
+        std::fprintf(stderr, "Skippy tokenizer buffer contract failed\n");
+    }
+    return ok ? EXIT_SUCCESS : EXIT_FAILURE;

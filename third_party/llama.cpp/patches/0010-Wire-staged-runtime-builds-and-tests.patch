@@ -0,0 +1,96 @@
+import re, sys, os, subprocess, json
+
+METAL_DIR='ggml/src/ggml-metal'
+KER=METAL_DIR+'/kernels'
+
+def parse_blocks(text):
+    lines=text.split('\n')
+    n=len(lines)
+    blocks=[]  # (start,end_exclusive,name,body)
+    i=0
+    while i<n:
+        l=lines[i]
+        if not l.strip() or l.lstrip().startswith('//'):
+            i+=1; continue
+        start=i
+        j=i
+        # advance through header lines (template<...>, attributes, qualifiers) that don't open a body or end with ';'
+        brace=0
+        seen_open=False
+        while j<n:
+            lj=lines[j]
+            brace += lj.count('{')-lj.count('}')
+            if '{' in lj: seen_open=True
+            ends_stmt = lj.rstrip().endswith(';')
+            closes = seen_open and brace==0
+            if ends_stmt and brace==0:
+                j+=1; break
+            if closes:
+                j+=1
+                # include trailing ';' on next line if present
+                if j<n and lines[j].strip()==';': j+=1
+                break
+            if not seen_open and brace==0:
+                # header line; stop if line is a complete non-compound statement
+                if lj.rstrip().endswith('>') or lj.rstrip().endswith(',') or lj.lstrip().startswith(('[[','template','kernel','static','constexpr','typedef','using','struct','enum')):
+                    j+=1; continue
+                # unknown stray line
+                j+=1; break
+            j+=1
+        body='\n'.join(lines[start:j])
+        m=re.search(r'\[\[host_name\("(\w+)"\)\]\]', body)
+        if m: names=[m.group(1)]
+        else:
+            names=re.findall(r'(?:kernel\s+)?void\s+(\w+)\s*\(', body)
+            if not names:
+                m2=re.search(r'^typedef\s+.*?[\s(*](\w+)\s*(?:=|;|\))', body, re.M)
+                if m2: names=[m2.group(1)]
+                elif body.startswith('constexpr'):
+                    m3=re.match(r'constexpr\s+\S+\s+(\w+)', body)
+                    names=[m3.group(1) if m3 else body[:40]]
+                elif body.startswith('struct'):
+                    m4=re.match(r'struct\s+(\w+)', body)
+                    names=[m4.group(1) if m4 else body[:40]]
+                else:
+                    names=[body[:40].replace('\n',' ')]
+        blocks.append(dict(start=start,end=j,names=names,body=body))
+        i=j
+    return lines,blocks
+
+our_text=open(METAL_DIR+'/ggml-metal.metal').read()
+base_text=subprocess.run(['git','show','3af988fa:ggml/src/ggml-metal/ggml-metal.metal'],capture_output=True,text=True).stdout
+
+olines,oblocks=parse_blocks(our_text)
+blines,bblocks=parse_blocks(base_text)
+
+# index base blocks by name
+from collections import defaultdict
+def by_name(blocks):
+    d=defaultdict(list)
+    for b in blocks:
+        for nm in b['names']: d[nm].append(b)
+    return d
+bidx=by_name(bblocks)
+
+changed=[]; added=[]; removed=[]
+for b in oblocks:
+    key=b['names'][0]
+    cands=bidx.get(key,[])
+    match=None
+    for c in cands:
+        if c['body']==b['body']: match=c; break
+    if match: continue
+    if cands: changed.append((b,cands))
+    else: added.append(b)
+for b in bblocks:
+    key=b['names'][0]
+    if not any(key in x['names'] for x in oblocks):
+        removed.append(b)
+
+print('our blocks:',len(oblocks),'base blocks:',len(bblocks))
+print('ADDED:',len(added))
+for b in added: print('  +',b['start'],b['names'][:3],b['body'].split('\n')[0][:90])
+print('CHANGED:',len(changed))
+for b,c in changed: print('  ~',b['start'],b['names'][:3],b['body'].split('\n')[0][:90])
+print('REMOVED(base-only):',len(removed))
+for b in removed: print('  -',b['names'][:3],b['body'].split('\n')[0][:90])
diff --git a/.scratch_port/analyze2.py b/.scratch_port/analyze2.py
new file mode 100644
index 000000000..f9b0ebc5d
--- /dev/null
+++ b/.scratch_port/analyze2.py
@@ -0,0 +1,69 @@
+import re, subprocess, sys
+from collections import defaultdict
+
+METAL_DIR='ggml/src/ggml-metal'
+
+STARTER=re.compile(r'^(template|kernel|static|typedef|using|constexpr|struct|enum|union|#|\[\[|void|constant|thread|device|class|float|half|int|uint|bool|size_t|short|metal|kernel_atomic)')
+
+def split_blocks(text):
+    lines=text.split('\n')
+    n=len(lines); blocks=[]; i=0
+    while i<n:
+        l=lines[i]
+        if not l.strip() or l.lstrip().startswith('//'):
+            i+=1; continue
+        assert l==l.lstrip(), ('indented top-level line', i+1, l[:80])
+        start=i; j=i+1
+        while j<n:
+            lj=lines[j]
+            if lj.strip() and not lj.lstrip().startswith('//') and lj==lj.lstrip() and STARTER.match(lj):
+                break
+            j+=1
+        # trim trailing blank/comment lines into next block? keep them; fine
+        body='\n'.join(lines[start:j]).rstrip('\n')
+        # names
+        names=re.findall(r'\[\[host_name\("(\w+)"\)\]\]', body)
+        fn=re.findall(r'void\s+(\w+)\s*\(', body)
+        sig=body.split('\n')[0]
+        if not names:
+            m=re.match(r'constexpr\s+\S+\s+(\w+)', sig)
+            if m: names=[m.group(1)]
+            elif sig.startswith('typedef'):
+                m2=re.search(r'[\s(*](\w+)\s*(?:=|;|\))', sig)
+                names=[m2.group(1) if m2 else sig[:50]]
+            elif sig.startswith('struct'):
+                names=[re.match(r'struct\s+(\w+)',sig).group(1)]
+            else:
+                names=fn[:1] or [sig[:60]]
+        blocks.append(dict(start=start,end=j,names=names or fn or [sig[:60]],body=body,first_line=sig,funcs=fn))
+        i=j
+    return blocks
+
+our_text=open(METAL_DIR+'/ggml-metal.metal').read()
+base_text=subprocess.run(['git','show','3af988fa:ggml/src/ggml-metal/ggml-metal.metal'],capture_output=True,text=True).stdout
+ob=split_blocks(our_text)
+bb=split_blocks(base_text)
+print('our',len(ob),'base',len(bb))
+
+def by_name(blocks):
+    d=defaultdict(list)
+    for b in blocks:
+        for nm in set(b['names'])|set(b['funcs']): d[nm].append(b)
+    return d
+bidx=by_name(bb)
+
+added=[];changed=[]
+for b in ob:
+    key=b['names'][0]
+    cands=[c for c in bidx.get(key,[])]
+    if any(c['body']==b['body'] for c in cands): continue
+    if cands: changed.append((b,cands))
+    else: added.append(b)
+removed=[b for b in bb if not any(b['names'][0] in set(x['names'])|set(x['funcs']) for x in ob)]
+
+print('== ADDED',len(added))
+for b in added: print('  + line%d %s | %s' % (b['start']+1, b['names'][0], b['first_line'][:80]))
+print('== CHANGED',len(changed))
+for b,c in changed: print('  ~ line%d %s | %s (cands %d)' % (b['start']+1, b['names'][0], b['first_line'][:70], len(c)))
+print('== REMOVED',len(removed))
+for b in removed: print('  - %s | %s' % (b['names'][0], b['first_line'][:70]))
diff --git a/.scratch_port/port.py b/.scratch_port/port.py
new file mode 100644
index 000000000..d636d4f34
--- /dev/null
+++ b/.scratch_port/port.py
@@ -0,0 +1,207 @@
+import re, subprocess, os, sys, difflib
+from collections import defaultdict, OrderedDict
+
+KER='ggml/src/ggml-metal/kernels'
+FILES=[os.path.join(KER,f) for f in sorted(os.listdir(KER))]
+
+STARTER=re.compile(r'^(template|kernel|static|typedef|using|constexpr|struct|enum|union|#|\[\[|void|constant|thread|device|class|float|half|int|uint|bool|size_t|short|metal|kernel_atomic)')
+
+def split_blocks(text, fname=''):
+    lines=text.split('\n')
+    n=len(lines); blocks=[]; i=0
+    while i<n:
+        l=lines[i]
+        if not l.strip() or l.lstrip().startswith('//'):
+            i+=1; continue
+        start=i; j=i+1
+        while j<n:
+            lj=lines[j]
+            if lj.strip() and not lj.lstrip().startswith('//') and lj==lj.lstrip() and STARTER.match(lj):
+                break
+            j+=1
+        # trim trailing blanks from block
+        e=j
+        while e>start and not lines[e-1].strip(): e-=1
+        body='\n'.join(lines[start:e])
+        names=re.findall(r'\[\[host_name\("(\w+)"\)\]\]', body)
+        fn=re.findall(r'void\s+(\w+)\s*\(', body)
+        sig=body.split('\n')[0]
+        if not names:
+            m=re.match(r'constexpr\s+\S+\s+(\w+)', sig)
+            if m: names=[m.group(1)]
+            elif sig.startswith('typedef'):
+                m2=re.search(r'[\s(*](\w+)\s*(?:=|;|\))', sig)
+                names=[m2.group(1) if m2 else sig[:50]]
+            elif sig.startswith('struct'):
+                m3=re.match(r'struct\s+(\w+)',sig)
+                names=[m3.group(1) if m3 else sig[:40]]
+            elif sig.startswith(('#define','#undef','#endif','#if','#include','#pragma')):
+                names=[sig]
+            else:
+                names=fn[:1] or [sig[:60]]
+        blocks.append(dict(start=start,end=e,names=names,funcs=fn,body=body,first=sig,fname=fname))
+        i=j
+    return blocks
+
+# load HEAD tree
+head_blocks=[]
+for f in FILES:
+    head_blocks += split_blocks(open(f).read(), f)
+
+def keyset(b):
+    return set(b['names'])|set(b['funcs'])
+
+head_by_body={}
+head_by_name=defaultdict(list)
+for b in head_blocks:
+    head_by_body.setdefault(b['body'],[]).append(b)
+    for k in keyset(b): head_by_name[k].append(b)
+
+# load ours + base
+our_text=open('ggml/src/ggml-metal/ggml-metal.metal').read()
+base_text=subprocess.run(['git','show','3af988fa:ggml/src/ggml-metal/ggml-metal.metal'],capture_output=True,text=True).stdout
+ob=split_blocks(our_text,'ours')
+bb=split_blocks(base_text,'base')
+
+base_by_name=defaultdict(list)
+for b in bb:
+    for k in keyset(b): base_by_name[k].append(b)
+
+# classify our blocks
+ops=[]  # list of dicts describing operations
+for idx,b in enumerate(ob):
+    ks=keyset(b)
+    cands=[]
+    for k in b['names']:
+        for c in base_by_name.get(k,[]):
+            if c not in cands: cands.append(c)
+    exact=[c for c in cands if c['body']==b['body']]
+    if exact:
+        ops.append(dict(kind='same',our=b,base=exact[0])); continue
+    if cands:
+        # pick best matching candidate (difflib ratio on body)
+        c=max(cands,key=lambda c: difflib.SequenceMatcher(None,c['body'],b['body']).ratio())
+        ops.append(dict(kind='changed',our=b,base=c,cands=cands)); continue
+    ops.append(dict(kind='added',our=b))
+
+base_keys_present=set()
+for op in ops:
+    if op['kind'] in ('same','changed'):
+        base_keys_present |= keyset(op['base'])
+removed=[b for b in bb if not (keyset(b)&base_keys_present) and b['body'] not in {o['our']['body'] for o in ops}]
+
+# map base block -> head block
+def map_head(base_b):
+    hb=head_by_body.get(base_b['body'])
+    if hb: return hb[0],'exact'
+    for k in keyset(base_b):
+        hl=head_by_name.get(k,[])
+        if len(hl)==1: return hl[0],'name'
+        if hl:
+            return max(hl,key=lambda h: difflib.SequenceMatcher(None,h['body'],base_b['body']).ratio()),'name'
+    return None,'none'
+
+report=[]
+# process files: build per-file new content
+out=defaultdict(list)   # fname -> list of head blocks (dicts) possibly mutated
+for b in head_blocks:
+    out[b['fname']].append(b)
+
+GLM_DSA=KER+'/glm_dsa.metal'
+INSERTS=defaultdict(list)  # fname -> list of (anchor_head_block, our_block, order)
+
+# handle changed blocks
+conflicts=[]
+for op in ops:
+    if op['kind']=='changed':
+        hb,how=map_head(op['base'])
+        if hb is None:
+            conflicts.append(('changed-no-head',op['our']['first'],op['our']['start']+1)); continue
+        if hb['body']==op['base']['body']:
+            hb['body']=op['our']['body']; hb['names']=op['our']['names']; hb['funcs']=op['our']['funcs']
+            report.append(('replaced',hb['fname'],op['our']['names'][0]))
+        else:
+            # 3-way via diff3
+            import tempfile
+            with tempfile.NamedTemporaryFile('w',suffix='.mine',delete=False) as f: f.write(hb['body']); mine=f.name
+            with tempfile.NamedTemporaryFile('w',suffix='.older',delete=False) as f: f.write(op['base']['body']); older=f.name
+            with tempfile.NamedTemporaryFile('w',suffix='.yours',delete=False) as f: f.write(op['our']['body']); yours=f.name
+            r=subprocess.run(['diff3','-m','-L','HEAD','-L','base','-L','ours',mine,older,yours],capture_output=True,text=True)
+            os.unlink(mine);os.unlink(older);os.unlink(yours)
+            if '<<<<<<<' in r.stdout:
+                conflicts.append(('changed-3way-conflict',hb['fname'],op['our']['names'][0],op['our']['start']+1))
+                open('/tmp/conflict-%s-%d.txt'%(re.sub(r'\W','_',op['our']['names'][0]),op['our']['start']),'w').write(r.stdout)
+            else:
+                hb['body']=r.stdout.rstrip('\n')
+                report.append(('merged3',hb['fname'],op['our']['names'][0]))
+
+# map for anchors: for 'same' ops, find head block
+anchor_map={}  # our block index -> head block
+for i,op in enumerate(ops):
+    if op['kind'] in ('same','changed'):
+        hb,_=map_head(op['base'])
+        anchor_map[i]=hb
+
+# fallback target by name prefix for added blocks with no resolvable anchor
+def guess_file(our_b):
+    nm=' '.join(our_b['names'])+' '+our_b['first']
+    if 'lightning_indexer' in nm or 'dsa_' in nm or 'glm_moe' in nm or 'moe_' in nm or 'topk' in nm or 'decode_block' in nm or 'zero_f32' in nm and 'swiglu' not in nm:
+        return GLM_DSA
+    if 'set_rows' in nm or 'get_rows' in nm: return KER+'/quantize.metal'
+    if 'selected_row' in nm or 'glm_compact' in nm or 'absorbed' in nm or 'flash' in nm: return KER+'/fa.metal'
+    if 'mul_mv' in nm or 'swiglu' in nm: return KER+'/mul_mv.metal'
+    if 'argsort' in nm: return KER+'/argsort.metal'
+    return GLM_DSA
+
+# insert added blocks, preserving our order, after nearest preceding mapped anchor in same target file
+pending=[]
+for i,op in enumerate(ops):
+    if op['kind']!='added': 
+        # flush pending at anchor boundary that maps to a file different from pending guess? keep simple: flush pending right before next anchor
+        if pending:
+            # find target: file of this anchor
+            hb=anchor_map.get(i)
+            tgt=hb['fname'] if hb else GLM_DSA
+            INSERTS[tgt].append((hb, list(pending), i))
+            pending=[]
+        continue
+    pending.append(op['our'])
+if pending:
+    INSERTS[GLM_DSA].append((None,list(pending),len(ops)))
+
+# apply inserts: for each file, rebuild block list inserting after anchor block (or at end)
+for tgt,items in INSERTS.items():
+    blocks=out.get(tgt,[])
+    for anchor,pend,order in items:
+        if anchor is not None and anchor in blocks:
+            pos=blocks.index(anchor)+1
+            blocks[pos:pos]=pend
+        else:
+            blocks.extend(pend)
+    out[tgt]=blocks
+
+# apply removals
+for b in removed:
+    hb,how=map_head(b)
+    if hb is None:
+        report.append(('remove-missing', '', b['names'][0])); continue
+    if hb['body']!=b['body']:
+        conflicts.append(('remove-drift',hb['fname'],b['names'][0]))
+        continue
+    if hb in out.get(hb['fname'],[]):
+        out[hb['fname']].remove(hb)
+        report.append(('removed',hb['fname'],b['names'][0]))
+
+# write files
+hdr_common='#include "common.h"\n'
+for tgt,blocks in out.items():
+    body='\n\n'.join(b['body'] for b in blocks)+'\n'
+    if tgt==GLM_DSA and not os.path.exists(tgt):
+        body=hdr_common+'\n'+body
+    open(tgt,'w').write(body)
+    report.append(('wrote',tgt,str(len(blocks))+' blocks'))
+
+print('== REPORT ==')
+for r in report: print(r)
+print('== CONFLICTS ==',len(conflicts))
+for c in conflicts: print(c)

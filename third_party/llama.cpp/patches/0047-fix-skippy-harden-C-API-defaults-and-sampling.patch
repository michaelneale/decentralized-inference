From 5958112ee6413a338f6b2d2922134385e4e84f38 Mon Sep 17 00:00:00 2001
From: scama
 <a1860575018c4680d5669dd7bc3bd356b478bccb8d42e194df46304a5e25f49a@meshllm.communities.buzz.xyz>
Date: Wed, 2 Sep 2026 12:07:43 +1000
Subject: [PATCH] fix(skippy): harden C API defaults and sampling

---
 include/skippy/common.h                       |  2 +-
 include/skippy/runtime.h                      |  3 ++
 src/skippy/model_loading.cpp                  | 10 +++++++
 src/skippy/sampling.cpp                       | 29 ++++++++++++++-----
 .../tests/hardware_application_probe.cpp      | 15 ++++++++--
 src/skippy/verification.cpp                   |  4 +--
 6 files changed, 51 insertions(+), 12 deletions(-)

diff --git a/include/skippy/common.h b/include/skippy/common.h
index 6a44b660c..a9165abcf 100644
--- a/include/skippy/common.h
+++ b/include/skippy/common.h
@@ -34,7 +34,7 @@ extern "C" {
 
 #define SKIPPY_ABI_VERSION_MAJOR 0
 #define SKIPPY_ABI_VERSION_MINOR 1
-#define SKIPPY_ABI_VERSION_PATCH 45
+#define SKIPPY_ABI_VERSION_PATCH 46
 
 #if defined(_MSC_VER)
 #define SKIPPY_DEPRECATED(message) __declspec(deprecated(message))
diff --git a/include/skippy/runtime.h b/include/skippy/runtime.h
index f63a3418f..c0425211a 100644
--- a/include/skippy/runtime.h
+++ b/include/skippy/runtime.h
@@ -110,6 +110,9 @@ struct skippy_runtime_config {
     int32_t split_mode;
 };
 
+/** @brief Returns a C-safe runtime configuration with all derived-default controls set to auto. */
+LLAMA_API struct skippy_runtime_config skippy_runtime_config_default(void);
+
 /** @brief Sentinel for `skippy_runtime_config` tri-state fields: keep the derived default. */
 #define SKIPPY_TRISTATE_AUTO  (-1)
 /** @brief Sentinel for `skippy_runtime_config` tri-state fields: force false. */
diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index 0202e5a1c..673df1212 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -467,6 +467,16 @@ static bool skippy_resolve_tristate(int32_t tristate, bool derived_default) {
 
 extern "C" {
 
+struct skippy_runtime_config skippy_runtime_config_default(void) {
+    struct skippy_runtime_config config = {};
+    config.kv_offload = SKIPPY_TRISTATE_AUTO;
+    config.kv_unified = SKIPPY_TRISTATE_AUTO;
+    config.swa_full = SKIPPY_TRISTATE_AUTO;
+    config.op_offload = SKIPPY_TRISTATE_AUTO;
+    config.split_mode = SKIPPY_TRISTATE_AUTO;
+    return config;
+}
+
 static enum skippy_status skippy_finish_model_open(
         llama_model * model,
         const struct skippy_runtime_config * config,
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 774ac807c..2b3a555da 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -505,17 +505,22 @@ static std::vector<llama_logit_bias> skippy_sampling_logit_biases(
     return biases;
 }
 
-static std::vector<const char *> skippy_dry_sequence_breakers(
+static std::vector<std::string> skippy_dry_sequence_breaker_storage(
         const skippy_sampling_config * sampling) {
     const uint32_t count = std::min<uint32_t>(
             sampling->dry_sequence_breaker_count,
             SKIPPY_MAX_DRY_SEQUENCE_BREAKERS);
-    std::vector<const char *> breakers;
-    breakers.reserve(count);
+    std::vector<std::string> storage;
+    storage.reserve(count);
     for (uint32_t i = 0; i < count; ++i) {
-        breakers.push_back(sampling->dry_sequence_breakers[i]);
-    }
-    return breakers;
+        const char * begin = sampling->dry_sequence_breakers[i];
+        const char * end = std::find(
+                begin,
+                begin + SKIPPY_MAX_DRY_SEQUENCE_BREAKER_BYTES,
+                '\0');
+        storage.emplace_back(begin, end);
+    }
+    return storage;
 }
 
 static void skippy_add_configured_sampler(
@@ -543,7 +548,13 @@ static void skippy_add_configured_sampler(
         }
         case SKIPPY_SAMPLER_DRY:
         {
-            std::vector<const char *> breakers = skippy_dry_sequence_breakers(sampling);
+            std::vector<std::string> breaker_storage =
+                    skippy_dry_sequence_breaker_storage(sampling);
+            std::vector<const char *> breakers;
+            breakers.reserve(breaker_storage.size());
+            for (const std::string & breaker : breaker_storage) {
+                breakers.push_back(breaker.c_str());
+            }
             llama_sampler_chain_add(chain, llama_sampler_init_dry(
                     vocab,
                     sampling->dry_multiplier,
@@ -639,6 +650,10 @@ llama_sampler * skippy_build_sampling_chain(
                 seed);
     } else if (configured_count == 0) {
         for (const uint32_t sampler_type : default_samplers) {
+            if (sampler_type == SKIPPY_SAMPLER_TYPICAL_P &&
+                    !(sampling->typical_p > 0.0f && sampling->typical_p < 1.0f)) {
+                continue;
+            }
             if (sampler_type == SKIPPY_SAMPLER_TOP_P &&
                     !(sampling->top_p > 0.0f && sampling->top_p < 1.0f)) {
                 continue;
diff --git a/src/skippy/tests/hardware_application_probe.cpp b/src/skippy/tests/hardware_application_probe.cpp
index 42fae794a..1a1bb0ca5 100644
--- a/src/skippy/tests/hardware_application_probe.cpp
+++ b/src/skippy/tests/hardware_application_probe.cpp
@@ -11,7 +11,19 @@ static bool require(bool condition, const char * message) {
 }
 
 int main() {
-    skippy_runtime_config config{};
+    skippy_runtime_config config = skippy_runtime_config_default();
+    bool passed = true;
+    passed &= require(config.kv_offload == SKIPPY_TRISTATE_AUTO,
+            "default kv_offload must preserve the derived default");
+    passed &= require(config.kv_unified == SKIPPY_TRISTATE_AUTO,
+            "default kv_unified must preserve the derived default");
+    passed &= require(config.swa_full == SKIPPY_TRISTATE_AUTO,
+            "default swa_full must preserve the derived default");
+    passed &= require(config.op_offload == SKIPPY_TRISTATE_AUTO,
+            "default op_offload must preserve the derived default");
+    passed &= require(config.split_mode == SKIPPY_TRISTATE_AUTO,
+            "default split_mode must preserve the derived default");
+
     config.use_direct_io = true;
     config.use_mlock = true;
     config.has_mmap_override = true;
@@ -26,7 +38,6 @@ int main() {
     llama_model_params model_params = llama_model_default_params();
     skippy_apply_model_load_memory_config(&config, model_params);
 
-    bool passed = true;
     passed &= require(model_params.load_mode == LLAMA_LOAD_MODE_DIRECT_IO,
             "direct I/O must take precedence over mmap and mlock");
     passed &= require(model_params.main_gpu == 2, "main_gpu override was not applied");
diff --git a/src/skippy/verification.cpp b/src/skippy/verification.cpp
index be29b2ff8..cce5baa4f 100644
--- a/src/skippy/verification.cpp
+++ b/src/skippy/verification.cpp
@@ -143,8 +143,8 @@ enum skippy_status skippy_verify_tokens_frame_sampled(
         // of the window, so llama_decode would reject the batch outright.
         // Detach the backend sampler and fall back to CPU-chain sampling for
         // this session: the chain itself is untouched and the row sampling
-        // below consumes it through skippy_sample_token_ith. A later sampling
-        // reconfiguration may re-attach; the next window detaches again.
+        // below consumes it through skippy_sample_token_ith. This chain stays
+        // retired; only building a fresh chain permits backend offload again.
         llama_set_sampler(session->ctx, session->seq_id, nullptr);
         session->sampling_backend_enabled = false;
         // The detached chain has already been backend-initialized and
-- 

From 2b0b559cf1e57d8c723750e28c406a556692e454 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sat, 29 Aug 2026 11:27:34 +1000
Subject: [PATCH] skippy: avoid redundant resident prefix barriers

---
 src/skippy/state.cpp | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/src/skippy/state.cpp b/src/skippy/state.cpp
index 7270d2ea2..3a8763869 100644
--- a/src/skippy/state.cpp
+++ b/src/skippy/state.cpp
@@ -857,7 +857,6 @@ enum skippy_status skippy_session_save_prefix(
             session->preserve_prefix_tokens = static_cast<int32_t>(token_count);
         }
     }
-    session->ctx->synchronize();
     return skippy_success(out_error);
 }
 
@@ -910,7 +909,6 @@ enum skippy_status skippy_session_restore_prefix(
     session->signal_history.clear();
     skippy_mtp_clear_session_state(session);
     session->verify_checkpoints.clear();
-    session->ctx->synchronize();
     return skippy_success(out_error);
 }
 
@@ -999,7 +997,6 @@ enum skippy_status skippy_session_create_from_resident_prefix(
         session->token_history.assign(token_ids, token_ids + token_count);
     }
     skippy_mtp_clear_session_state(session);
-    model->ctx->synchronize();
     *out_session = session;
     return skippy_success(out_error);
 }
@@ -1020,7 +1017,6 @@ enum skippy_status skippy_session_drop_sequence(
     }
     session->ctx->synchronize();
     llama_memory_seq_rm(memory, seq_id, -1, -1);
-    session->ctx->synchronize();
     return skippy_success(out_error);
 }
 

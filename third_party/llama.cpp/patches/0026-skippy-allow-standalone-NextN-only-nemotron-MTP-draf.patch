From 5c5d0bc79411916494222149ab4cbd03a3dd5b1b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 26 Aug 2026 15:20:36 +1000
Subject: [PATCH 26/56] skippy: allow standalone NextN-only nemotron MTP draft
 models

A NextN-only draft GGUF (converted with convert_hf_to_gguf.py --mtp)
carries only blk.<n>.* tensors: it has no token_embd, output_norm, or
output. The nemotron-h loader created token_embd and output_norm as
required tensors and unconditionally duplicated token_embd for the
output fallback, so llama_model_load_from_file failed with
check_tensor_dims: tensor 'token_embd.weight' not found.

Mark the shared trunk tensors TENSOR_NOT_REQUIRED when mtp_only and
skip the duplication fallback, mirroring inkling. The MTP graph borrows
the trunk embedding and LM head through ctx_other when the draft does
not carry its own.
---
 src/models/nemotron-h-moe.cpp | 19 ++++++++++++++-----
 src/models/nemotron-h.cpp     |  8 +++++---
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/src/models/nemotron-h-moe.cpp b/src/models/nemotron-h-moe.cpp
index 3dc30c95c..ce1cec84f 100644
--- a/src/models/nemotron-h-moe.cpp
+++ b/src/models/nemotron-h-moe.cpp
@@ -22,8 +22,13 @@ llama_model_nemotron_h_moe::graph_mtp::graph_mtp(const llama_model & model, cons
     GGML_ASSERT(layer.ffn_gate_inp);
 
     // token embedding weights
-    ggml_tensor * tok_embd_w = layer.nextn.embed_tokens ? layer.nextn.embed_tokens : model.tok_embd;
-    GGML_ASSERT(tok_embd_w != nullptr && "NEMOTRON_H_MOE MTP requires token embeddings");
+    // A standalone NextN-only draft omits token_embd/output and shares the
+    // trunk tensors through ctx_other (same borrowing scheme as inkling).
+    const llama_model * trunk = cparams.ctx_other != nullptr ? llama_get_model(cparams.ctx_other) : nullptr;
+    ggml_tensor * tok_embd_w = layer.nextn.embed_tokens ? layer.nextn.embed_tokens
+                          : (model.tok_embd          ? model.tok_embd
+                          : (trunk                   ? trunk->tok_embd : nullptr));
+    GGML_ASSERT(tok_embd_w != nullptr && "NEMOTRON_H_MOE MTP requires token embeddings (own or shared trunk)");
 
     auto inp = std::make_unique<llm_graph_input_embd_h>(hparams.n_embd);
 
@@ -155,9 +160,13 @@ llama_model_nemotron_h_moe::graph_mtp::graph_mtp(const llama_model & model, cons
     }
 
     // LM head
-    ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
-    ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
-    GGML_ASSERT(head_w != nullptr && "NEMOTRON_H_MOE MTP requires an output projection");
+    ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head
+                        : (model.output                ? model.output
+                        : (trunk                       ? trunk->output : nullptr));
+    ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s
+                        : (model.output_s              ? model.output_s
+                        : (trunk                       ? trunk->output_s : nullptr));
+    GGML_ASSERT(head_w != nullptr && "NEMOTRON_H_MOE MTP requires an output projection (own or shared trunk)");
     cur = build_lora_mm(head_w, cur, head_s);
     cb(cur, "result_output", -1);
 
diff --git a/src/models/nemotron-h.cpp b/src/models/nemotron-h.cpp
index 3f101dd03..c0045311b 100644
--- a/src/models/nemotron-h.cpp
+++ b/src/models/nemotron-h.cpp
@@ -62,14 +62,16 @@ void llama_model_nemotron_h::load_arch_tensors(llama_model_loader & ml) {
     const int64_t moe_n_embd = hparams.moe_latent_size > 0 ? hparams.moe_latent_size : n_embd;
 
     // embeddings
-    tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, 0);
+    // A NextN-only MTP draft shares the trunk embedding and output projection
+    // (borrowed via ctx_other at graph build time), so both stay optional.
+    tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, trunk_flags);
 
     // output
     {
-        output_norm = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM, "weight"), {n_embd}, 0);
+        output_norm = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM, "weight"), {n_embd}, trunk_flags);
         output = create_tensor(tn(LLM_TENSOR_OUTPUT, "weight"), {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
         // if output is NULL, init from the input tok embed, duplicated to allow offloading
-        if (output == NULL) {
+        if (output == NULL && !mtp_only) {
             output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, TENSOR_DUPLICATED);
         }
     }

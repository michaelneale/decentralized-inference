From 90cae5d566f4e9f50100458e603af77c80968576 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 9 Sep 2026 12:35:48 +1000
Subject: [PATCH 22/23] skippy: bind carrier descriptors to payload parts

Metadata-only carriers describe every tensor but contain no payload bytes. Exclude those descriptors from ordered runtime weight maps so admitted tensors bind to physical payload artifacts, while preserving carrier-only no-allocation planning.

Exercise skippy_model_open_from_parts for dense and recurrent fixtures so descriptor-only entries cannot shadow payloads again.

Assisted-by: scama
---
 src/llama-model-loader.cpp                    | 18 ++++++-
 .../tests/renamed_multishard_planning.cpp     | 54 +++++++++++++++++++
 2 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 203b869f8..24a444a3b 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -600,6 +600,17 @@ llama_model_loader::llama_model_loader(
         files.emplace_back(new llama_file(fname.c_str(), "rb", use_direct_io));
         contexts.emplace_back(ctx);
 
+        const int metadata_only_key = gguf_find_key(metadata, "skippy.package.metadata_only");
+        const bool metadata_only_carrier =
+                metadata_only_key >= 0 &&
+                gguf_get_kv_type(metadata, metadata_only_key) == GGUF_TYPE_BOOL &&
+                gguf_get_val_bool(metadata, metadata_only_key);
+        if (metadata_only_carrier && !ordered_parts && !no_alloc) {
+            throw std::runtime_error(
+                    "metadata-only GGUF carriers require ordered payload parts for runtime loading");
+        }
+        const bool metadata_only_primary = metadata_only_carrier && ordered_parts;
+
         // Save tensors data offset of the main file.
         // For subsidiary files, `meta` tensor data offset must not be used,
         // so we build a unified tensors index for weights.
@@ -609,6 +620,9 @@ llama_model_loader::llama_model_loader(
             if (weights_map.find(tensor_name) != weights_map.end()) {
                 throw std::runtime_error(format("invalid model: tensor '%s' is duplicated", ggml_get_name(cur)));
             }
+            if (metadata_only_primary) {
+                continue;
+            }
             n_elements += ggml_nelements(cur);
             n_bytes    += ggml_nbytes(cur);
             weights_map.emplace(tensor_name, llama_tensor_weight(files.back().get(), 0, metadata, cur, no_alloc));
@@ -772,9 +786,9 @@ llama_model_loader::llama_model_loader(
 
     if (g_skippy_filter.enabled) {
         for (const std::string & name : g_skippy_filter.resident_tensor_names) {
-            if (weights_map.find(name) == weights_map.end() && gguf_find_tensor(metadata, name.c_str()) < 0) {
+            if (weights_map.find(name) == weights_map.end()) {
                 throw std::runtime_error(format(
-                        "admitted resident tensor '%s' is absent from model metadata",
+                        "admitted resident tensor '%s' is absent from model payloads",
                         name.c_str()));
             }
         }
diff --git a/src/skippy/tests/renamed_multishard_planning.cpp b/src/skippy/tests/renamed_multishard_planning.cpp
index 3391f6342..783e7b869 100644
--- a/src/skippy/tests/renamed_multishard_planning.cpp
+++ b/src/skippy/tests/renamed_multishard_planning.cpp
@@ -10,6 +10,7 @@
 #include "llama.h"
 #include "skippy/model_package.h"
 #include "skippy/package_tensor_binding.h"
+#include "skippy/runtime.h"
 #include "skippy/stage_plan.h"
 #include "skippy/stage_slice_plan.h"
 
@@ -948,6 +949,59 @@ int run_proof(const char * source_path, const char * output_directory, bool expe
         std::fprintf(stderr, "metadata carrier stage-plan ABI proof failed: %s\n", error.c_str());
         return 10;
     }
+
+    std::vector<std::string> resident_names;
+    for (const auto & binding : bindings) {
+        if (std::find(prefill.begin(), prefill.end(), binding.identity) != prefill.end()) {
+            resident_names.emplace_back(ggml_get_name(binding.tensor));
+        }
+    }
+    std::sort(resident_names.begin(), resident_names.end());
+    resident_names.erase(std::unique(resident_names.begin(), resident_names.end()), resident_names.end());
+    std::vector<const char *> resident_name_ptrs;
+    for (const auto & name : resident_names) {
+        resident_name_ptrs.push_back(name.c_str());
+    }
+    std::vector<std::string> carrier_parts = {carrier_path};
+    carrier_parts.insert(carrier_parts.end(), inventory.ordered_paths.begin(), inventory.ordered_paths.end());
+    std::vector<const char *> carrier_part_ptrs;
+    for (const auto & path : carrier_parts) {
+        carrier_part_ptrs.push_back(path.c_str());
+    }
+    skippy_runtime_config runtime_config = skippy_runtime_config_default();
+    runtime_config.layer_start = 0;
+    runtime_config.layer_end = llama_model_n_layer(model.get());
+    runtime_config.ctx_size = 32;
+    runtime_config.lane_count = 1;
+    runtime_config.n_batch = 8;
+    runtime_config.n_ubatch = 8;
+    runtime_config.n_threads = 1;
+    runtime_config.n_threads_batch = 1;
+    runtime_config.n_gpu_layers = 0;
+    runtime_config.load_mode = SKIPPY_LOAD_MODE_RUNTIME_SLICE;
+    runtime_config.filter_tensors_on_load = true;
+    runtime_config.resident_tensor_names = resident_name_ptrs.data();
+    runtime_config.resident_tensor_name_count = resident_name_ptrs.size();
+    runtime_config.include_embeddings = true;
+    runtime_config.include_output = true;
+    skippy_model * carrier_model = nullptr;
+    skippy_error * runtime_error = nullptr;
+    const skippy_status runtime_status = skippy_model_open_from_parts(
+            carrier_part_ptrs.data(), carrier_part_ptrs.size(), &runtime_config, &carrier_model, &runtime_error);
+    if (runtime_status != SKIPPY_STATUS_OK || carrier_model == nullptr) {
+        std::fprintf(
+                stderr,
+                "metadata carrier runtime load failed: %s\n",
+                runtime_error == nullptr ? "" : runtime_error->message);
+        skippy_error_free(runtime_error);
+        return 11;
+    }
+    skippy_model_free(carrier_model, &runtime_error);
+    if (runtime_error != nullptr) {
+        std::fprintf(stderr, "metadata carrier runtime free failed: %s\n", runtime_error->message);
+        skippy_error_free(runtime_error);
+        return 12;
+    }
     std::printf(
             "renamed multishard metadata planning: tensors=%zu dependencies=%zu payload_reads=%zu payload_bytes=%zu recurrent=%d\n",
             bindings.size(),
-- 

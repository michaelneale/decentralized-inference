diff --git a/tests/test-skippy-activation-layout.cpp b/tests/test-skippy-activation-layout.cpp
new file mode 100644
index 000000000..42a518677
--- /dev/null
+++ b/tests/test-skippy-activation-layout.cpp
@@ -0,0 +1,64 @@
+#include "../src/llama-model.h"
+#include "../src/skippy/activation_internal.h"
+#include "../src/skippy/runtime_types.h"
+
+#include <cstdio>
+#include <memory>
+
+static bool expect_hidden_bytes(
+        llm_arch arch,
+        uint32_t n_embd,
+        uint32_t n_embd_out,
+        uint32_t hyperconnection_count,
+        size_t expected) {
+    std::unique_ptr<llama_model> model(llama_model_create(arch, llama_model_default_params()));
+    if (!model) {
+        return false;
+    }
+    model->hparams.n_embd = n_embd;
+    model->hparams.n_embd_out_impl = n_embd_out;
+    model->hparams.dsv4_hc_mult = hyperconnection_count;
+
+    skippy_model stage_model = {};
+    stage_model.model = model.get();
+    skippy_session session = {};
+    session.stage_model = &stage_model;
+    return skippy_activation_hidden_bytes(&session, 3) == expected;
+}
+
+int main() {
+    constexpr size_t tokens = 3;
+    constexpr size_t f32_bytes = sizeof(float);
+
+    if (!expect_hidden_bytes(
+                LLM_ARCH_QWEN4EXP,
+                2560,
+                10240,
+                4,
+                tokens * 10240 * f32_bytes)) {
+        std::fprintf(stderr, "Qwen4Exp activation frame did not use the wide hyper-connected residual\n");
+        return 1;
+    }
+
+    if (!expect_hidden_bytes(
+                LLM_ARCH_DEEPSEEK4,
+                2560,
+                10240,
+                4,
+                tokens * 10240 * f32_bytes)) {
+        std::fprintf(stderr, "DeepSeek4 activation frame did not use the wide hyper-connected residual\n");
+        return 2;
+    }
+
+    if (!expect_hidden_bytes(
+                LLM_ARCH_LLAMA,
+                2560,
+                10240,
+                0,
+                tokens * 2560 * f32_bytes)) {
+        std::fprintf(stderr, "ordinary activation frame unexpectedly used model output width\n");
+        return 3;
+    }
+
+    return 0;
+}

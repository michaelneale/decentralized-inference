+  {%- else -%}
+    {{- serialized -}}
+  {%- endif -%}
+{%- endmacro -%}
+
+{%- macro canonical_json(value) -%}
+  {%- if value is mapping -%}
+    {{- '{' -}}
+    {%- for key, item in value | dictsort(case_sensitive=true) -%}

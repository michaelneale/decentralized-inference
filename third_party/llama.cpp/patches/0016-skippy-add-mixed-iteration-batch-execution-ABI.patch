From 37c295ca170ff8464effb70c9fb8ca90a28083c6 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Mon, 24 Aug 2026 15:35:31 +1000
Subject: [PATCH 16/56] skippy: add mixed iteration batch execution ABI

---
 include/skippy/common.h        |  11 +-
 include/skippy/execution.h     |  60 +++++-
 src/skippy/abi.cpp             |   3 +-
 src/skippy/execution-batch.cpp | 341 +++++++++++++++++++++++++++++++++
 4 files changed, 409 insertions(+), 6 deletions(-)

diff --git a/include/skippy/common.h b/include/skippy/common.h
index 012aceb9a..e7f322abf 100644
--- a/include/skippy/common.h
+++ b/include/skippy/common.h
@@ -34,7 +34,15 @@ extern "C" {
 
 #define SKIPPY_ABI_VERSION_MAJOR 0
 #define SKIPPY_ABI_VERSION_MINOR 1
-#define SKIPPY_ABI_VERSION_PATCH 39
+#define SKIPPY_ABI_VERSION_PATCH 41
+
+#if defined(_MSC_VER)
+#define SKIPPY_DEPRECATED(message) __declspec(deprecated(message))
+#elif defined(__GNUC__) || defined(__clang__)
+#define SKIPPY_DEPRECATED(message) __attribute__((deprecated(message)))
+#else
+#define SKIPPY_DEPRECATED(message)
+#endif
 
 enum skippy_feature {
     SKIPPY_FEATURE_RUNTIME_SLICE          = 1 << 0,
@@ -64,6 +72,7 @@ enum skippy_feature {
     SKIPPY_FEATURE_NATIVE_MTP_N1          = 1 << 25,
     SKIPPY_FEATURE_NGRAM_CACHE_DRAFT      = 1 << 26,
     SKIPPY_FEATURE_INKLING_MTP_MM         = 1 << 27,
+    SKIPPY_FEATURE_ITERATION_BATCH        = 1 << 28,
 };
 
 enum skippy_status {
diff --git a/include/skippy/execution.h b/include/skippy/execution.h
index 83ea8ec1d..7098677d8 100644
--- a/include/skippy/execution.h
+++ b/include/skippy/execution.h
@@ -60,8 +60,55 @@ LLAMA_API enum skippy_status skippy_decode_step_sampled_mtp(
         struct skippy_native_mtp_draft * out_mtp_draft,
         struct skippy_error ** out_error);
 
-/** @brief Samples one predicted token for each session in a request batch. */
-LLAMA_API enum skippy_status skippy_decode_batch_sampled(
+/**
+ * @brief Describes one variable-length request in a mixed scheduler iteration.
+ *
+ * `positions` contains `token_count * n_pos_per_embd` entries when supplied.
+ * A null positions pointer derives contiguous positions from the session. The
+ * activation frame, when required by a downstream stage, must describe exactly
+ * `token_count` tokens. `sample_last` requests logits and sampling only for the
+ * final token in this request.
+ */
+struct skippy_iteration_request {
+        struct skippy_session * session;
+        const llama_token * token_ids;
+        size_t token_count;
+        const llama_pos * positions;
+        size_t position_count;
+        const struct skippy_sampling_config * sampling;
+        const struct skippy_activation_desc * input_desc;
+        const void * input_payload;
+        bool sample_last;
+};
+
+/**
+ * @brief Executes mixed prefill chunks and decode tokens in one model iteration.
+ *
+ * Requests may have different token counts. Activation outputs are request-major.
+ * Sampled outputs are compact and explicitly map back to the request indexes
+ * whose final rows requested logits. GLM-DSA inputs in one iteration must use
+ * the same sideband width and stream count.
+ */
+LLAMA_API enum skippy_status skippy_iteration_batch_sampled(
+        const struct skippy_iteration_request * requests,
+        size_t request_count,
+        struct skippy_activation_desc * output_descs,
+        void * const * output_payloads,
+        const size_t * output_payload_capacities,
+        size_t * out_output_payload_bytes,
+        size_t * out_sampled_request_indexes,
+        llama_token * out_predicted_tokens,
+        size_t sampled_output_capacity,
+        size_t * out_sampled_output_count,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Samples one predicted token for each session in a request batch.
+ * @deprecated Use `skippy_iteration_batch_sampled`; this legacy serving entrypoint
+ * cannot express mixed prefill and decode work.
+ */
+LLAMA_API SKIPPY_DEPRECATED("use skippy_iteration_batch_sampled")
+enum skippy_status skippy_decode_batch_sampled(
         struct skippy_session * const * sessions,
         const llama_token * token_ids,
         const struct skippy_sampling_config * const * sampling,
@@ -160,8 +207,13 @@ LLAMA_API enum skippy_status skippy_decode_step_frame_sampled_mtp(
         struct skippy_native_mtp_draft * out_mtp_draft,
         struct skippy_error ** out_error);
 
-/** @brief Runs framed sampled decode for multiple sessions in one batch. */
-LLAMA_API enum skippy_status skippy_decode_step_frame_batch_sampled(
+/**
+ * @brief Runs framed sampled decode for multiple sessions in one batch.
+ * @deprecated Use `skippy_iteration_batch_sampled`; this legacy serving entrypoint
+ * is restricted to one token per request.
+ */
+LLAMA_API SKIPPY_DEPRECATED("use skippy_iteration_batch_sampled")
+enum skippy_status skippy_decode_step_frame_batch_sampled(
         struct skippy_session * const * sessions,
         const llama_token * token_ids,
         const struct skippy_sampling_config * const * sampling,
diff --git a/src/skippy/abi.cpp b/src/skippy/abi.cpp
index 0ec72958e..f48e56cb5 100644
--- a/src/skippy/abi.cpp
+++ b/src/skippy/abi.cpp
@@ -35,7 +35,8 @@ uint64_t skippy_abi_features(void) {
            SKIPPY_FEATURE_BACKEND_DEVICES |
            SKIPPY_FEATURE_NATIVE_MTP_N1 |
            SKIPPY_FEATURE_NGRAM_CACHE_DRAFT |
-           SKIPPY_FEATURE_INKLING_MTP_MM;
+           SKIPPY_FEATURE_INKLING_MTP_MM |
+           SKIPPY_FEATURE_ITERATION_BATCH;
 }
 
 void skippy_error_free(struct skippy_error * error) {
diff --git a/src/skippy/execution-batch.cpp b/src/skippy/execution-batch.cpp
index a8694dbed..8f6facc96 100644
--- a/src/skippy/execution-batch.cpp
+++ b/src/skippy/execution-batch.cpp
@@ -23,6 +23,347 @@
 
 
 extern "C" {
+enum skippy_status skippy_iteration_batch_sampled(
+        const struct skippy_iteration_request * requests,
+        size_t request_count,
+        struct skippy_activation_desc * output_descs,
+        void * const * output_payloads,
+        const size_t * output_payload_capacities,
+        size_t * out_output_payload_bytes,
+        size_t * out_sampled_request_indexes,
+        llama_token * out_predicted_tokens,
+        size_t sampled_output_capacity,
+        size_t * out_sampled_output_count,
+        struct skippy_error ** out_error) {
+    if (requests == nullptr || request_count == 0 || out_sampled_output_count == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "requests, request_count, and out_sampled_output_count are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    *out_sampled_output_count = 0;
+
+    skippy_session * first = requests[0].session;
+    if (first == nullptr || first->ctx == nullptr || first->stage_model == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "requests must use active sessions");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+
+    const int32_t n_embd = llama_model_n_embd(first->stage_model->model);
+    const int32_t n_embd_inp = llama_model_n_embd_inp(first->stage_model->model);
+    const int32_t n_pos_per_embd = first->stage_model->model->hparams.n_pos_per_embd();
+    if (n_pos_per_embd <= 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model position sideband width must be positive");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (n_embd <= 0 || n_embd_inp < n_embd) {
+        // wider upstream activations than the input embedding width have no
+        // defined gather semantics and would overflow the batch row write
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "activation input width exceeds the stage model input embedding width");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+
+    const bool activation_input = skippy_is_filtered(first) && first->stage_model->config.layer_start > 0;
+    const bool request_logits = first->stage_model->config.include_output;
+    const bool request_embeddings = skippy_emits_activation_frame(first);
+    size_t total_token_count = 0;
+    uint64_t batch_input_flags = 0;
+    uint32_t batch_input_top_k = 0;
+    uint32_t batch_input_streams = 0;
+    uint64_t batch_output_flags = 0;
+    size_t sampled_output_count = 0;
+
+    std::vector<size_t> request_offsets(request_count + 1, 0);
+    for (size_t request_index = 0; request_index < request_count; ++request_index) {
+        const skippy_iteration_request & request = requests[request_index];
+        skippy_session * session = request.session;
+        if (session == nullptr || session->ctx != first->ctx || session->stage_model != first->stage_model) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "all requests must belong to the same stage model");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        for (size_t prior = 0; prior < request_index; ++prior) {
+            if (requests[prior].session == session) {
+                skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "an iteration may contain each session only once");
+                return SKIPPY_STATUS_INVALID_ARGUMENT;
+            }
+        }
+        if (request.token_ids == nullptr || request.token_count == 0) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "each iteration request requires at least one token");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        if (request.token_count > std::numeric_limits<size_t>::max() / static_cast<size_t>(n_pos_per_embd)) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "request position count exceeds size_t range");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        const size_t expected_positions = request.token_count * static_cast<size_t>(n_pos_per_embd);
+        if (request.positions != nullptr && request.position_count != expected_positions) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "position_count must equal token_count * n_pos_per_embd");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        if (request.positions == nullptr && request.position_count != 0) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "position_count must be zero when positions is null");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        if (total_token_count > static_cast<size_t>(std::numeric_limits<int32_t>::max()) - request.token_count) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "iteration token count exceeds int32_t range");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        if (request.sample_last && request_logits) {
+            sampled_output_count += 1;
+        }
+
+        enum skippy_status status = skippy_validate_frame_input(
+                session,
+                request.input_desc,
+                request.input_payload,
+                request.token_count,
+                out_error);
+        if (status != SKIPPY_STATUS_OK) {
+            return status;
+        }
+        const uint64_t input_flags = request.input_desc != nullptr ? request.input_desc->flags : 0;
+        if ((input_flags & ~SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0) {
+            skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "iteration batching currently supports only GLM-DSA activation sidebands");
+            return SKIPPY_STATUS_UNSUPPORTED;
+        }
+        const uint32_t input_top_k = skippy_glm_dsa_top_k_count_from_desc(session, request.input_desc);
+        const uint32_t input_streams = skippy_glm_dsa_n_stream(session);
+        const uint64_t output_flags = skippy_output_activation_flags(session, request.input_desc);
+        if ((output_flags & ~SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0) {
+            skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "iteration batching currently supports only GLM-DSA output sidebands");
+            return SKIPPY_STATUS_UNSUPPORTED;
+        }
+        if (request_index == 0) {
+            batch_input_flags = input_flags;
+            batch_input_top_k = input_top_k;
+            batch_input_streams = input_streams;
+            batch_output_flags = output_flags;
+        } else if (input_flags != batch_input_flags || input_top_k != batch_input_top_k ||
+                   input_streams != batch_input_streams || output_flags != batch_output_flags) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "iteration activation sideband shapes must be uniform");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+
+        status = skippy_prepare_output_activation_frame(
+                session,
+                request.token_count,
+                output_payloads != nullptr ? output_payloads[request_index] : nullptr,
+                output_payload_capacities != nullptr ? output_payload_capacities[request_index] : 0,
+                out_output_payload_bytes != nullptr ? &out_output_payload_bytes[request_index] : nullptr,
+                output_descs != nullptr ? &output_descs[request_index] : nullptr,
+                request.input_desc,
+                out_error);
+        if (status != SKIPPY_STATUS_OK) {
+            return status;
+        }
+
+        total_token_count += request.token_count;
+        request_offsets[request_index + 1] = total_token_count;
+    }
+    *out_sampled_output_count = sampled_output_count;
+    if (sampled_output_count > sampled_output_capacity ||
+        (sampled_output_count > 0 &&
+         (out_sampled_request_indexes == nullptr || out_predicted_tokens == nullptr))) {
+        skippy_set_error(out_error, SKIPPY_STATUS_BUFFER_TOO_SMALL, "sampled iteration output buffer is too small");
+        return SKIPPY_STATUS_BUFFER_TOO_SMALL;
+    }
+
+    const int32_t n_tokens = static_cast<int32_t>(total_token_count);
+    std::vector<llama_token> token_storage(total_token_count);
+    std::vector<float> embd_storage;
+    std::vector<int32_t> glm_dsa_input_top_k_storage;
+    if (activation_input) {
+        embd_storage.resize(total_token_count * static_cast<size_t>(n_embd_inp));
+        if ((batch_input_flags & SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0) {
+            glm_dsa_input_top_k_storage.resize(
+                    total_token_count * static_cast<size_t>(batch_input_top_k) * batch_input_streams);
+        }
+    }
+
+    std::vector<llama_pos> pos_storage(total_token_count * static_cast<size_t>(n_pos_per_embd));
+    std::vector<int32_t> n_seq_id_storage(total_token_count, 1);
+    std::vector<llama_seq_id> seq_id_values(total_token_count);
+    std::vector<llama_seq_id *> seq_id_storage(total_token_count, nullptr);
+    std::vector<int8_t> logits_storage(total_token_count, 0);
+
+    for (size_t request_index = 0; request_index < request_count; ++request_index) {
+        const skippy_iteration_request & request = requests[request_index];
+        const size_t offset = request_offsets[request_index];
+        const size_t hidden_bytes = skippy_activation_hidden_bytes(request.session, request.token_count);
+        std::copy(request.token_ids, request.token_ids + request.token_count, token_storage.begin() + offset);
+
+        if (activation_input) {
+            const float * input = static_cast<const float *>(request.input_payload);
+            for (size_t token_index = 0; token_index < request.token_count; ++token_index) {
+                float * destination = embd_storage.data() + (offset + token_index) * static_cast<size_t>(n_embd_inp);
+                std::memcpy(
+                        destination,
+                        input + token_index * static_cast<size_t>(n_embd),
+                        static_cast<size_t>(n_embd) * sizeof(float));
+                if (n_embd_inp > n_embd) {
+                    std::memset(
+                            destination + n_embd,
+                            0,
+                            static_cast<size_t>(n_embd_inp - n_embd) * sizeof(float));
+                }
+            }
+            if (!glm_dsa_input_top_k_storage.empty()) {
+                const size_t sideband_values = request.token_count * static_cast<size_t>(batch_input_top_k) * batch_input_streams;
+                const int32_t * source = reinterpret_cast<const int32_t *>(
+                        static_cast<const uint8_t *>(request.input_payload) + hidden_bytes);
+                std::memcpy(
+                        glm_dsa_input_top_k_storage.data() + offset * static_cast<size_t>(batch_input_top_k) * batch_input_streams,
+                        source,
+                        sideband_values * sizeof(int32_t));
+            }
+        }
+
+        for (size_t token_index = 0; token_index < request.token_count; ++token_index) {
+            const size_t flat_index = offset + token_index;
+            seq_id_values[flat_index] = request.session->seq_id;
+            seq_id_storage[flat_index] = &seq_id_values[flat_index];
+            logits_storage[flat_index] = request_embeddings ||
+                    (request_logits && request.sample_last && token_index + 1 == request.token_count) ? 1 : 0;
+            for (int32_t position_dimension = 0; position_dimension < n_pos_per_embd; ++position_dimension) {
+                const size_t destination = static_cast<size_t>(position_dimension) * total_token_count + flat_index;
+                if (request.positions != nullptr) {
+                    const size_t source = static_cast<size_t>(position_dimension) * request.token_count + token_index;
+                    pos_storage[destination] = request.positions[source];
+                } else {
+                    const llama_pos position = request.session->n_past + static_cast<llama_pos>(token_index);
+                    pos_storage[destination] = position_dimension == 3 ? 0 : position;
+                }
+            }
+        }
+    }
+
+    llama_batch batch = {
+        /*n_tokens =*/ n_tokens,
+        /*token    =*/ activation_input ? nullptr : token_storage.data(),
+        /*embd     =*/ activation_input ? embd_storage.data() : nullptr,
+        /*pos      =*/ pos_storage.data(),
+        /*n_seq_id =*/ n_seq_id_storage.data(),
+        /*seq_id   =*/ seq_id_storage.data(),
+        /*logits   =*/ logits_storage.data(),
+    };
+
+    skippy_activation_tokens_scope activation_tokens_scope(token_storage.data(), total_token_count);
+    const llama_pos batch_pos_start = pos_storage.empty() ? first->n_past : pos_storage[0];
+    skippy_glm_dsa_top_k_scope glm_dsa_top_k_scope(
+            glm_dsa_input_top_k_storage.empty() ? nullptr : glm_dsa_input_top_k_storage.data(),
+            static_cast<uint32_t>(total_token_count),
+            batch_input_top_k,
+            batch_input_streams,
+            batch_pos_start);
+    skippy_graph_filter_scope graph_filter_scope(
+            &first->stage_model->config,
+            SKIPPY_GLM_DSA_PHASE_HINT_AUTO);
+    const int32_t rc = llama_decode(first->ctx, batch);
+    if (rc != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "llama_decode failed for scheduler iteration");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+
+    float * embeddings = request_embeddings ? llama_get_embeddings(first->ctx) : nullptr;
+    if (request_embeddings && embeddings == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "llama embeddings output was not available");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+
+    llm_graph_result * graph_result = first->ctx->get_gf_res_prev();
+    ggml_tensor * top_k = (batch_output_flags & SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0 && graph_result != nullptr ?
+            graph_result->get_skippy_glm_dsa_top_k() : nullptr;
+    if ((batch_output_flags & SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0 && top_k != nullptr &&
+        (top_k->type != GGML_TYPE_I32 || top_k->ne[0] <= 0 ||
+         top_k->ne[1] * top_k->ne[2] * top_k->ne[3] != static_cast<int64_t>(total_token_count))) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "iteration GLM-DSA output is not token-major i32");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+
+    std::vector<uint32_t> request_output_top_k(request_count, 0);
+    if ((batch_output_flags & SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0 &&
+        embeddings != nullptr && output_payloads != nullptr) {
+        if (top_k == nullptr) {
+            skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "iteration GLM-DSA output was not available");
+            return SKIPPY_STATUS_RUNTIME_ERROR;
+        }
+        for (size_t request_index = 0; request_index < request_count; ++request_index) {
+            if (output_payloads[request_index] == nullptr) {
+                continue;
+            }
+            const skippy_iteration_request & request = requests[request_index];
+            const uint64_t future_n_past = static_cast<uint64_t>(std::max<int32_t>(request.session->n_past, 0)) +
+                    static_cast<uint64_t>(request.token_count);
+            const uint32_t visible_top_k = skippy_glm_dsa_sideband_top_k_count_for_n_kv(
+                    request.session,
+                    future_n_past);
+            request_output_top_k[request_index] = static_cast<uint32_t>(
+                    std::min<int64_t>(top_k->ne[0], visible_top_k));
+            if (request_output_top_k[request_index] == 0) {
+                skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "iteration GLM-DSA output has no visible entries");
+                return SKIPPY_STATUS_RUNTIME_ERROR;
+            }
+        }
+    }
+
+    size_t sampled_output_index = 0;
+    for (size_t request_index = 0; request_index < request_count; ++request_index) {
+        const skippy_iteration_request & request = requests[request_index];
+        const size_t offset = request_offsets[request_index];
+        const size_t hidden_bytes = skippy_activation_hidden_bytes(request.session, request.token_count);
+        request.session->n_past += static_cast<int32_t>(request.token_count);
+        skippy_record_tokens(request.session, request.token_ids, request.token_count);
+
+        if (request.sample_last && request_logits) {
+            // llama_get_logits_ith indexes the original batch token row even
+            // when only selected rows requested logits; output_ids performs
+            // the sparse-row translation internally.
+            const int32_t logits_index =
+                    static_cast<int32_t>(request_offsets[request_index + 1] - 1);
+            out_sampled_request_indexes[sampled_output_index] = request_index;
+            out_predicted_tokens[sampled_output_index] = skippy_sample_token_ith(
+                    request.session,
+                    request.sampling,
+                    logits_index);
+            sampled_output_index += 1;
+        }
+
+        if (embeddings != nullptr && output_payloads != nullptr && output_payloads[request_index] != nullptr) {
+            uint8_t * output = static_cast<uint8_t *>(output_payloads[request_index]);
+            std::memcpy(
+                    output,
+                    embeddings + offset * static_cast<size_t>(n_embd),
+                    hidden_bytes);
+            size_t actual_output_bytes = hidden_bytes;
+            if ((batch_output_flags & SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K) != 0) {
+                const uint32_t output_top_k = request_output_top_k[request_index];
+                const size_t row_bytes = static_cast<size_t>(output_top_k) * sizeof(int32_t);
+                for (size_t token_index = 0; token_index < request.token_count; ++token_index) {
+                    const size_t row = offset + token_index;
+                    size_t remainder = row;
+                    const size_t i1 = remainder % static_cast<size_t>(top_k->ne[1]);
+                    remainder /= static_cast<size_t>(top_k->ne[1]);

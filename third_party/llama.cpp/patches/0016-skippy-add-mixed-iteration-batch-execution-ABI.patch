+                actual_output_bytes += request.token_count * row_bytes;
+            }
+            if (out_output_payload_bytes != nullptr) {
+                out_output_payload_bytes[request_index] = actual_output_bytes;
+            }
+            if (output_descs != nullptr) {
+                output_descs[request_index].payload_bytes = actual_output_bytes;
+            }

From 1980d970f0d700b54ec774afa8c5b0025afc8c0c Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sat, 29 Aug 2026 10:37:31 +1000
Subject: [PATCH] skippy: offload greedy sampling to model backend

---
 src/skippy/runtime_types.h     |  1 +
 src/skippy/sampling.cpp        | 28 +++++++++++++++++++++++++++-
 src/skippy/sampling_internal.h |  1 +
 src/skippy/session.cpp         |  2 ++
 src/skippy/tokenization.cpp    |  5 +++++
 5 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/src/skippy/runtime_types.h b/src/skippy/runtime_types.h
index f83801c97..51f4f71cb 100644
--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -118,6 +118,7 @@ struct skippy_session {
     std::vector<skippy_token_signal> signal_history;
     llama_sampler * sampling_chain = nullptr;
     llama_sampler * grammar_sampler = nullptr;
+    bool sampling_backend_enabled = false;
     skippy_sampling_config sampling_config = {};
     bool sampling_config_valid = false;
     std::string chat_sampling_metadata;
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 5c3cae65c..6fb1e1f64 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -302,10 +302,14 @@ void skippy_clear_chat_sampling(skippy_session * session) {
     if (session == nullptr) {
         return;
     }
+    if (session->ctx != nullptr) {
+        llama_set_sampler(session->ctx, session->seq_id, nullptr);
+    }
     llama_sampler_free(session->sampling_chain);
     llama_sampler_free(session->grammar_sampler);
     session->sampling_chain = nullptr;
     session->grammar_sampler = nullptr;
+    session->sampling_backend_enabled = false;
     session->sampling_config = {};
     session->sampling_config_valid = false;
     session->chat_sampling_metadata.clear();
@@ -353,6 +357,7 @@ static bool skippy_sampling_is_greedy_equivalent(const skippy_sampling_config *
     }
     const float repeat_penalty = sampling->repeat_penalty == 0.0f ? 1.0f : sampling->repeat_penalty;
     return sampling->temperature <= 0.0f &&
+           (sampling->flags & SKIPPY_SAMPLING_FLAG_IGNORE_EOS) == 0 &&
            sampling->presence_penalty == 0.0f &&
            sampling->frequency_penalty == 0.0f &&
            repeat_penalty == 1.0f &&
@@ -396,7 +401,7 @@ llama_sampler * skippy_build_sampling_chain(
         return nullptr;
     }
 
-    if (!skippy_sampling_enabled(sampling)) {
+    if (skippy_sampling_is_greedy_equivalent(sampling)) {
         llama_sampler_chain_add(sampler, llama_sampler_init_greedy());
         return sampler;
     }
@@ -487,9 +492,26 @@ static bool skippy_ensure_plain_sampling_chain(
     session->sampling_config = *sampling;
     session->sampling_config_valid = true;
     session->sampling_accepted_token_count = 0;
+    skippy_refresh_backend_sampling(session, sampling);
     return true;
 }
 
+void skippy_refresh_backend_sampling(
+        skippy_session * session,
+        const skippy_sampling_config * sampling) {
+    if (session == nullptr) {
+        return;
+    }
+    session->sampling_backend_enabled = false;
+    if (session->ctx != nullptr &&
+            session->sampling_chain != nullptr &&
+            session->grammar_sampler == nullptr &&
+            skippy_sampling_is_greedy_equivalent(sampling)) {
+        session->sampling_backend_enabled =
+                llama_set_sampler(session->ctx, session->seq_id, session->sampling_chain);
+    }
+}
+
 bool skippy_init_chat_grammar_sampler(
         skippy_session * session,
         const json & metadata,
@@ -600,6 +622,9 @@ static void skippy_sync_chat_sampling_history(skippy_session * session) {
 
 static llama_token skippy_chat_sample_token(skippy_session * session, int32_t logits_index) {
     skippy_sync_chat_sampling_history(session);
+    if (session->sampling_backend_enabled) {
+        return llama_sampler_sample(session->sampling_chain, session->ctx, logits_index);
+    }
     llama_synchronize(session->ctx);
 
     const llama_vocab * vocab = llama_model_get_vocab(session->stage_model->model);
@@ -645,6 +670,7 @@ llama_token skippy_sample_token_ith(
         return 0;
     }
     if (skippy_mtp_greedy_sampling_fastpath_enabled() &&
+            !session->sampling_backend_enabled &&
             session->grammar_sampler == nullptr &&
             skippy_sampling_is_greedy_equivalent(sampling)) {
         if (session->sampling_chain != nullptr) {
diff --git a/src/skippy/sampling_internal.h b/src/skippy/sampling_internal.h
index 724a25ab9..768ccb350 100644
--- a/src/skippy/sampling_internal.h
+++ b/src/skippy/sampling_internal.h
@@ -31,6 +31,7 @@ enum skippy_status skippy_verify_token_batch(
 llama_token skippy_greedy_sample_context(const llama_model * model, llama_context * ctx, int32_t index);
 llama_token skippy_greedy_sample_ith(skippy_session * session, int32_t index);
 llama_sampler * skippy_build_sampling_chain(skippy_session * session, const skippy_sampling_config * sampling);
+void skippy_refresh_backend_sampling(skippy_session * session, const skippy_sampling_config * sampling);
 bool skippy_init_chat_grammar_sampler(
         skippy_session * session,
         const nlohmann::ordered_json & metadata,
diff --git a/src/skippy/session.cpp b/src/skippy/session.cpp
index 184ccdba0..ef1ff64ac 100644
--- a/src/skippy/session.cpp
+++ b/src/skippy/session.cpp
@@ -285,6 +285,7 @@ enum skippy_status skippy_session_configure_chat_sampling(
             skippy_clear_chat_sampling(session);
             return out_error != nullptr && *out_error != nullptr ? (*out_error)->status : SKIPPY_STATUS_RUNTIME_ERROR;
         }
+        skippy_refresh_backend_sampling(session, sampling);
     } catch (const std::exception & e) {
         skippy_clear_chat_sampling(session);
         return skippy_success(out_error);
@@ -362,6 +363,7 @@ enum skippy_status skippy_session_free(
                 }
             }
         }
+        skippy_clear_chat_sampling(session);
         if (!session->borrowed_sequence) {
             skippy_release_execution_lane(session->stage_model, session->seq_id);
         }
diff --git a/src/skippy/tokenization.cpp b/src/skippy/tokenization.cpp
index 778fbf0c8..fb0aa0c54 100644
--- a/src/skippy/tokenization.cpp
+++ b/src/skippy/tokenization.cpp
@@ -13,6 +13,11 @@
 using skippy_chat_templates_create_fn = void * (*)(const llama_model * model);
 using skippy_chat_templates_free_fn = void (*)(void * templates);
 
+extern "C" LLAMA_API void * skippy_model_chat_templates_get_or_init(
+        struct skippy_model * model,
+        skippy_chat_templates_create_fn create,
+        skippy_chat_templates_free_fn free_templates);
+
 extern "C" LLAMA_API void * skippy_model_chat_templates_get_or_init(
         struct skippy_model * model,
         skippy_chat_templates_create_fn create,
-- 
2.54.0 (Apple Git-157)
